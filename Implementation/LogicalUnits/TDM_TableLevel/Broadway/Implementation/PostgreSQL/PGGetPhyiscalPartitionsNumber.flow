tags: Implementation
stages:
  Inputs:
    actors:
      'Interface ':
        parent: Const
        in:
          value:
            const: null
            external: interfaceName
        out:
          value:
            schema: string
      Schema Name:
        parent: Const
        in:
          value:
            const: null
            external: schemaName
        out:
          value:
            schema: string
      Table Name:
        parent: Const
        in:
          value:
            const: null
            external: tableName
        out:
          value:
            schema: string
      Flow Inputs:
        parent: Const
        in:
          value:
            const: null
            external: flowInputs
        out:
          value:
            schema: '#ref'
  Count Partition Tables in postgres:
    actors:
      Get Number of Partitions:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: Interface /value
          sql:
            const: |-
              SELECT COUNT(*) AS partition_count
              FROM pg_inherits i
              JOIN pg_class parent ON parent.oid = i.inhparent
              JOIN pg_class child  ON child.oid = i.inhrelid
              JOIN pg_namespace nsp ON nsp.oid = parent.relnamespace
              WHERE nsp.nspname = ${schemaName}
              AND parent.relname = ${tableName}
          schemaName:
            link: Schema Name/value
            schema: string
            mandatory: false
            createdBy: sql
          tableName:
            link: Table Name/value
            schema: string
            mandatory: false
            createdBy: sql
  Return Number:
    dependsOn: Count Partition Tables in postgres
    actors:
      Table Has Partitions?:
        parent: GreaterThan
        condition: result
        in:
          b:
            const: 0
          a:
            link: Get Number of Partitions/result
      result:
        parent: Const
        in:
          value:
            const: null
            link: Get Number of Partitions/result
            schema: integer
        out:
          value:
            external: value
            schema: integer
    split: '--------------------'
  Return 1:
    else: true
    dependsOn: Count Partition Tables in postgres
    actors:
      1 partition:
        parent: Const
        in:
          value:
            const: 1
            schema: integer
        out:
          value:
            external: value
            schema: integer
  'Logger ':
    actors:
      Logger:
        parent: Logger
        in:
          message:
            const: '${input}${num} for table ''${tableName}'' schema ''${schemaName}''
              (interface: ${interfaceName})'
          level:
            const: info
          input:
            link: Flow Inputs/value/message
            schema: string
            mandatory: false
            createdBy: message
          num:
            link:
            - result/value
            - 1 partition/value
            schema: integer
            mandatory: false
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: message
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: message
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: message
schemas:
  Flow Inputs.out.value:
    type: object
    properties:
      message:
        type: string
