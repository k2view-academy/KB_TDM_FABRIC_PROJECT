tags: Implementation
stages:
  'Inputs  ':
    actors:
      Flow Inputs:
        parent: Const
        remark: Flow inputs declared in the TableLevelPartitionFlow mtable.
        in:
          value:
            const: null
            external: flowInputs
        out:
          value:
            schema: '#ref'
      partitionsNum:
        parent: Const
        remark: Total number of partitions.
        in:
          value:
            const: null
            external: partitionsNumber
        out:
          value:
            schema: string
      currentPartition:
        parent: Const
        remark: Current running partition out of the total count.
        in:
          value:
            const: null
            external: currentPartition
        out:
          value:
            schema: string
      Where Claוse:
        parent: Const
        remark: The Where Cluase created based on the parameters when the task was
          created/edited.
        in:
          value:
            const: null
            external: whereClause
            schema: string
        out:
          value:
            schema: string
      Source Interface:
        parent: Const
        remark: The Source Interface
        in:
          value:
            const: null
            external: sourceInterface
            schema: string
        out:
          value:
            schema: string
      Source Schema:
        parent: Const
        remark: The Source Schema
        in:
          value:
            const: null
            external: sourceSchema
            schema: string
        out:
          value:
            schema: string
      Source Table Name:
        parent: Const
        remark: The ame of the source table.
        in:
          value:
            const: null
            external: sourceTableName
            schema: string
        out:
          value:
            schema: string
      Query's Parameters Values as a String:
        parent: Const
        remark: A String including the list of  parameters sent for the query. The
          values are separated by global - TDM_PARAMETERS_SEPARATOR
        in:
          value:
            const: null
            external: paramtersStr
            schema: string
        out:
          value:
            schema: string
      Array of TheQuery's Parameters Values:
        parent: Const
        remark: An array with the values sent to the query.
        in:
          value:
            const: null
            external: queryParameters
            schema: string
        out:
          value:
            schema: string
      Select Query Statement:
        parent: Const
        remark: The Sql statement including the where clause if exists to select the
          data from source.
        in:
          value:
            const: null
            external: selectStatement
            schema: string
        out:
          value:
            schema: string
      Count Query Statement:
        parent: Const
        remark: The Sql statement including the where clause if exists to count the
          total number of records to be loaded.
        in:
          value:
            const: null
            external: countStatement
            schema: string
        out:
          value:
            schema: string
      'Array of The Query''s Parameters ':
        parent: Const
        remark: An array with the map of name, type and value of each parameter sent
          in the filter.
        in:
          value:
            const: null
            external: filterParametersInfo
            schema: Any
        out:
          value:
            schema: string
      'Table Count  ':
        parent: Const
        remark: If the table count has already been supplied.
        in:
          value:
            const: null
            external: tableCount
            schema: Any
        out:
          value:
            schema: string
  Get Mod Method:
    actors:
      MOD:
        parent: Const
        in:
          value:
            const: mod((hashtext(${columnName}::text)::bigint & 2147483647), ${partitionValue})
            schema: string
        out:
          value:
            schema: string
      Reminder:
        parent: MathAdd
        in:
          b:
            const: -1
          a:
            link: currentPartition/value
  Prepare new query:
    actors:
      Mod with partition:
        parent: StringFormat
        in:
          format:
            const: null
            link: MOD/value
          partitionValue:
            link: partitionsNum/value
            schema: integer
            mandatory: false
            createdBy: format
          columnName:
            link: Flow Inputs/value/columnName
            schema: string
            mandatory: false
  Query has no condition:
    dependsOn: Prepare new query
    actors:
      Filter ?:
        parent: IsNull
        condition: result
        in:
          value:
            link: Where Claוse/value
      Add partition clause for select:
        parent: StringFormat
        in:
          format:
            const: ${selectStatement} where ${modCondition} = ${reminder}
          selectStatement:
            link: Select Query Statement/value
            schema: string
            mandatory: false
          modCondition:
            link: Mod with partition/string
            schema: string
            mandatory: false
            createdBy: format
          reminder:
            link: Reminder/result
            schema: integer
            mandatory: false
            createdBy: format
      Add partition clause for count:
        parent: StringFormat
        in:
          format:
            const: ${selectStatement} where ${modCondition} = ${reminder}
          selectStatement:
            link: Count Query Statement/value
            schema: string
            mandatory: false
          modCondition:
            link: Mod with partition/string
            schema: string
            mandatory: false
            createdBy: format
          reminder:
            link: Reminder/result
            schema: integer
            mandatory: false
            createdBy: format
    split: '--------------------'
  Apply Filter:
    else: true
    dependsOn: Prepare new query
    actors:
      Add partition clause for select1:
        parent: StringFormat
        in:
          format:
            const: ${selectStatement} And ${modCondition} = ${reminder}
          selectStatement:
            link: Select Query Statement/value
            schema: string
            mandatory: false
          modCondition:
            link: Mod with partition/string
            schema: string
            mandatory: false
            createdBy: format
          reminder:
            link: Reminder/result
            schema: integer
            mandatory: false
            createdBy: format
      Add partition clause for count1:
        parent: StringFormat
        in:
          format:
            const: ${selectStatement} And ${modCondition} = ${reminder}
          selectStatement:
            link: Count Query Statement/value
            schema: string
            mandatory: false
          modCondition:
            link: Mod with partition/string
            schema: string
            mandatory: false
            createdBy: format
          reminder:
            link: Reminder/result
            schema: integer
            mandatory: false
            createdBy: format
  Run Select:
    actors:
      Select Output:
        parent: DbCommand
        in:
          interface:
            const: null
            link: Source Interface/value
          sql:
            const: null
            link:
            - Add partition clause for select/string
            - Add partition clause for select1/string
          params:
            link: Array of TheQuery's Parameters Values/value
        out:
          result:
            external: result
            schema: '#ref'
  'Count Total Records ':
    dependsOn: Run Select
    actors:
      GreaterThan:
        parent: GreaterThan
        condition: result
        in:
          b:
            const: 0
          a:
            external: tableCount
      Return -1:
        parent: Const
        in:
          value:
            const: -1
            schema: integer
        out:
          value:
            schema: integer
    split: '--------------------'
  'Get Count Per Partition ':
    else: true
    dependsOn: Run Select
    actors:
      Count Statement is Given?:
        parent: NotEquals
        condition: result
        in:
          a:
            external: countStatement
            schema: string
          b:
            const: ''
            schema: string
      Get Partition Count:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: Source Interface/value
          sql:
            const: null
            link:
            - Add partition clause for count/string
            - Add partition clause for count1/string
          params:
            link: Array of TheQuery's Parameters Values/value
        out:
          result:
            schema: integer
    split: '--------------------'
  No Count:
    else: true
    dependsOn: Run Select
    actors:
      Return Count:
        parent: Const
        in:
          value:
            const: null
            external: tableCount
            schema: integer
        out:
          value:
            schema: integer
  Table Count:
    actors:
      tableCount:
        parent: Const
        in:
          value:
            const: null
            link:
            - Return -1/value
            - Get Partition Count/result
            - Return Count/value
            schema: integer
        out:
          value:
            external: tableCount
            schema: integer
schemas:
  Flow Inputs.out.value:
    type: object
    properties:
      columnName:
        type: string
  Select Output.out.result:
    type: array
    items:
      type: object
      properties:
        count:
          type: integer
