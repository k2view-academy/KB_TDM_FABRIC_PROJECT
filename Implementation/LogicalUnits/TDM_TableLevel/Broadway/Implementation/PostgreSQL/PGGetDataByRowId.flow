tags: Implementation
stages:
  'Inputs  ':
    actors:
      Flow Inputs:
        parent: Const
        remark: Flow inputs declared in the TableLevelPartitionFlow mtable.
        in:
          value:
            const: null
            external: flowInputs
        out:
          value:
            schema: '#ref'
      partitionsNum:
        parent: Const
        remark: Total number of partitions.
        in:
          value:
            const: null
            external: partitionsNumber
        out:
          value:
            schema: string
      currentPartition:
        parent: Const
        remark: Current running partition out of the total count.
        in:
          value:
            const: null
            external: currentPartition
        out:
          value:
            schema: string
      Where Claוse:
        parent: Const
        remark: The Where Cluase created based on the parameters when the task was
          created/edited.
        in:
          value:
            const: null
            external: whereClause
            schema: string
        out:
          value:
            schema: string
      Source Interface:
        parent: Const
        remark: The Source Interface
        in:
          value:
            const: null
            external: sourceInterface
            schema: string
        out:
          value:
            schema: string
      Source Schema:
        parent: Const
        remark: The Source Schema
        in:
          value:
            const: null
            external: sourceSchema
            schema: string
        out:
          value:
            schema: string
      Source Table Name:
        parent: Const
        remark: The ame of the source table.
        in:
          value:
            const: null
            external: sourceTableName
            schema: string
        out:
          value:
            schema: string
      Query's Parameters Values as a String:
        parent: Const
        remark: A String including the list of  parameters sent for the query. The
          values are separated by global - TDM_PARAMETERS_SEPARATOR
        in:
          value:
            const: null
            external: paramtersStr
            schema: string
        out:
          value:
            schema: string
      Array of TheQuery's Parameters Values:
        parent: Const
        remark: An array with the values sent to the query.
        in:
          value:
            const: null
            external: queryParameters
            schema: string
        out:
          value:
            schema: string
      Select Query Statement:
        parent: Const
        remark: The Sql statement including the where clause if exists to select the
          data from source.
        in:
          value:
            const: null
            external: selectStatement
            schema: string
        out:
          value:
            schema: string
      Count Query Statement:
        parent: Const
        remark: The Sql statement including the where clause if exists to count the
          total number of records to be loaded.
        in:
          value:
            const: null
            external: countStatement
            schema: string
        out:
          value:
            schema: string
      'Array of The Query''s Parameters ':
        parent: Const
        remark: An array with the map of name, type and value of each parameter sent
          in the filter.
        in:
          value:
            const: null
            external: filterParametersInfo
            schema: Any
        out:
          value:
            schema: string
      'Table Count  ':
        parent: Const
        remark: If the table count has already been supplied.
        in:
          value:
            const: null
            external: tableCount
            schema: Any
        out:
          value:
            schema: string
  Get Mod Method:
    actors:
      Reminder:
        parent: MathAdd
        in:
          b:
            const: -1
          a:
            link: currentPartition/value
  Get Partition Conditions:
    actors:
      Hash Condition:
        parent: StringFormat
        remark: |-
          Original hash split. Used when the task has a filter: filtered rows are often
          physically clustered (e.g. recent dates sit in the last blocks), so a block split
          would push almost all the work to one partition. The hash spreads them evenly.
        in:
          format:
            const: mod((hashtext(ctid::text)::bigint & 2147483647), ${partitions})
              = ${reminder}
          partitions:
            link: partitionsNum/value
            schema: integer
            mandatory: false
            createdBy: format
          reminder:
            link: Reminder/result
            schema: integer
            mandatory: false
            createdBy: format
      Block Range Condition:
        parent: DbFetchField
        remark: |-
          Used when the task has no filter. Splits the table's physical blocks into
          partitionsNumber contiguous ranges; the last partition is open-ended.
          The block count comes from pg_relation_size (actual size), not pg_class.relpages,
          which is only refreshed by VACUUM/ANALYZE and caused the last partition to get
          every block added since then.
          Falls back to the hash condition when the server is older than PostgreSQL 14
          (no Tid Range Scan) or the table is a partitioned parent (size 0, ranges would
          apply per child and skew).
        in:
          interface:
            const: null
            link: Source Interface/value
          sql:
            const: |-
              select case
                       when b.legacy
                         then format('mod((hashtext(ctid::text)::bigint & 2147483647), %s) = %s',
                                     ${partitions}::int, ${partition}::int - 1)
                       when ${partition}::int >= ${partitions}::int
                         then format('ctid >= ''(%s,0)''::tid', (${partition}::int - 1) * b.per)
                       else format('ctid >= ''(%s,0)''::tid and ctid < ''(%s,0)''::tid',
                                   (${partition}::int - 1) * b.per, ${partition}::int * b.per)
                     end as partition_condition
              from (select c.relkind = 'p'
                             or current_setting('server_version_num')::int < 140000 as legacy,
                           greatest(ceil(pg_relation_size(c.oid)::numeric
                                         / current_setting('block_size')::int
                                         / ${partitions}::int), 1)::bigint as per
                    from pg_class c
                    where c.oid = format('%I.%I', ${schemaName}::text, ${tableName}::text)::regclass) b
          partition:
            link: currentPartition/value
            schema: integer
            mandatory: false
          partitions:
            link: partitionsNum/value
            schema: integer
            mandatory: false
          schemaName:
            link: Source Schema/value
            schema: string
            mandatory: false
          tableName:
            link: Source Table Name/value
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Query has no condition:
    dependsOn: Get Partition Conditions
    actors:
      Filter ?:
        parent: IsNull
        condition: result
        in:
          value:
            link: Where Claוse/value
      Add partition clause for select:
        parent: StringFormat
        in:
          format:
            const: ${selectStatement} where ${rangeCondition}
          selectStatement:
            link: Select Query Statement/value
            schema: string
            mandatory: false
          rangeCondition:
            link: Block Range Condition/result
            schema: string
            mandatory: false
            createdBy: format
      Add partition clause for count:
        parent: StringFormat
        in:
          format:
            const: ${selectStatement} where ${rangeCondition}
          selectStatement:
            link: Count Query Statement/value
            schema: string
            mandatory: false
          rangeCondition:
            link: Block Range Condition/result
            schema: string
            mandatory: false
            createdBy: format
    split: '--------------------'
  Apply Filter:
    else: true
    dependsOn: Get Partition Conditions
    actors:
      Add partition clause for select1:
        parent: StringFormat
        in:
          format:
            const: ${selectStatement} And (${hashCondition})
          selectStatement:
            link: Select Query Statement/value
            schema: string
            mandatory: false
          hashCondition:
            link: Hash Condition/string
            schema: string
            mandatory: false
            createdBy: format
      Add partition clause for count1:
        parent: StringFormat
        in:
          format:
            const: ${selectStatement} And (${hashCondition})
          selectStatement:
            link: Count Query Statement/value
            schema: string
            mandatory: false
          hashCondition:
            link: Hash Condition/string
            schema: string
            mandatory: false
            createdBy: format
  Run Select:
    actors:
      Select Output:
        parent: DbCommand
        in:
          interface:
            const: null
            link: Source Interface/value
          sql:
            const: null
            link:
            - Add partition clause for select/string
            - Add partition clause for select1/string
          params:
            link: Array of TheQuery's Parameters Values/value
        out:
          result:
            external: result
            schema: '#ref'
  Count Total Records:
    dependsOn: Run Select
    actors:
      GreaterThan:
        parent: GreaterThan
        condition: result
        in:
          b:
            const: 0
          a:
            external: tableCount
      Return -1:
        parent: Const
        in:
          value:
            const: -1
            schema: integer
        out:
          value:
            schema: integer
    split: '--------------------'
  Get Count Per Partition:
    else: true
    dependsOn: Run Select
    actors:
      Count Statement is Given?:
        parent: NotEquals
        condition: result
        in:
          a:
            external: countStatement
            schema: string
          b:
            const: ''
            schema: string
      Get Partition Count:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: Source Interface/value
          sql:
            const: null
            link:
            - Add partition clause for count/string
            - Add partition clause for count1/string
          params:
            link: Array of TheQuery's Parameters Values/value
        out:
          result:
            schema: integer
    split: '--------------------'
  No Count:
    else: true
    dependsOn: Run Select
    actors:
      Return Count:
        parent: Const
        in:
          value:
            const: null
            external: tableCount
            schema: integer
        out:
          value:
            schema: integer
  Table Count:
    actors:
      tableCount:
        parent: Const
        in:
          value:
            const: null
            link:
            - Return -1/value
            - Get Partition Count/result
            - Return Count/value
            schema: integer
        out:
          value:
            external: tableCount
            schema: integer
schemas:
  Flow Inputs.out.value:
    type: object
    properties:
      columnName:
        type: string
  Select Output.out.result:
    type: array
    items:
      type: object
      properties:
        count:
          type: integer
