tags: Concurrency
stages:
  Inputs:
    actors:
      Table Name:
        parent: Const
        in:
          value:
            const: null
            external: tableName
        out:
          value:
            schema: string
      Schema Name:
        parent: Const
        in:
          value:
            const: null
            external: schemaName
        out:
          value:
            schema: string
      Table ID:
        parent: Const
        in:
          value:
            const: null
            external: tableID
        out:
          value:
            schema: string
      'Interface ':
        parent: Const
        in:
          value:
            const: null
            external: interfaceName
        out:
          value:
            schema: string
      Patitions Number:
        parent: Const
        in:
          value:
            const: null
            external: partitionsNum
        out:
          value:
            schema: integer
  SQL For Partition Table:
    actors:
      Create Partition Table:
        parent: StringFormat
        in:
          format:
            const: "CREATE TABLE IF NOT EXISTS ${tableName}_partitioned (\r\n    LIKE\
              \ ${schemaName}.${tableName} INCLUDING DEFAULTS INCLUDING GENERATED\r\
              \n)\r\nPARTITION BY HASH (${tableID});\r\n"
          tableName:
            link: Table Name/value
            schema: string
            mandatory: false
            createdBy: format
          schemaName:
            link: Schema Name/value
            schema: string
            mandatory: false
            createdBy: format
          tableID:
            link: Table ID/value
            schema: string
            mandatory: false
            createdBy: format
  Create Partiotined Table:
    actors:
      DbCommand:
        parent: DbCommand
        in:
          interface:
            const: null
            link: Interface /value
          sql:
            const: null
            link: Create Partition Table/string
  Loop Over Number Of Partitions:
    actors:
      ForLoop:
        parent: ForLoop
        in:
          from:
            const: 0
          to:
            link: Patitions Number/value
  'Add ':
    actors:
      MathAdd:
        parent: MathAdd
        in:
          b:
            const: 1
          a:
            link:
              path: ForLoop/i
              iterate: Iterate
  SQL For Physical Partitions:
    actors:
      Create Partitions Script:
        parent: StringFormat
        in:
          format:
            const: "CREATE TABLE IF NOT EXISTS ${tableName}_partitioned_p${num}\r\n\
              \    PARTITION OF ${tableName}_partitioned\r\n    FOR VALUES WITH (MODULUS\
              \ ${partitionsNum}, REMAINDER ${index});"
          tableName:
            link: Table Name/value
            schema: string
            mandatory: false
            createdBy: format
          index:
            link:
              path: ForLoop/i
              iterate: Iterate
            schema: integer
            mandatory: false
            createdBy: format
          partitionsNum:
            link: Patitions Number/value
            schema: integer
            mandatory: false
            createdBy: format
          num:
            link: MathAdd/result
            schema: integer
            mandatory: false
            createdBy: format
  Create Physical Partitions:
    last: 1
    actors:
      'DbCommand     ':
        parent: DbCommand
        in:
          interface:
            const: null
            link: Interface /value
          sql:
            const: null
            link: Create Partitions Script/string
  SQL Copy Data:
    actors:
      Copy Data:
        parent: StringFormat
        in:
          format:
            const: "INSERT INTO ${tableName}_partitioned\r\nSELECT *\r\nFROM public.${tableName};\r\
              \n"
          tableName:
            link: Table Name/value
            schema: any
            mandatory: false
            createdBy: format
  Insert Data To Tables:
    actors:
      'DbCommand           ':
        parent: DbCommand
        in:
          interface:
            const: null
            link: Interface /value
          sql:
            const: null
            link: Copy Data/string
