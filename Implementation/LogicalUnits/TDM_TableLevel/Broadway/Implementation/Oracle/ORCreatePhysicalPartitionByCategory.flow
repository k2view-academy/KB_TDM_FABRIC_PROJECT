tags: Implementation
stages:
  Inputs:
    actors:
      Table Name:
        parent: Const
        in:
          value:
            const: null
            external: tableName
        out:
          value:
            schema: string
      Schema Name:
        parent: Const
        in:
          value:
            const: null
            external: schemaName
        out:
          value:
            schema: string
      columnName:
        parent: Const
        in:
          value:
            const: null
            external: columnName
        out:
          value:
            schema: string
      'Interface ':
        parent: Const
        in:
          value:
            const: null
            external: interfaceName
        out:
          value:
            schema: string
  SQL For Partition Table:
    actors:
      'LuFunction  ':
        parent: LuFunction
        in:
          functionName:
            const: getDbTableColumnsAndTypes
          dbInterfaceName:
            link: Interface /value
            schema: string
            mandatory: false
            createdBy: functionName
          catalogSchema:
            link: Schema Name/value
            schema: string
            mandatory: false
            createdBy: functionName
          table:
            link: Table Name/value
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
      'DbCommand          ':
        parent: DbCommand
        in:
          interface:
            const: null
            link: Interface /value
          sql:
            const: |-
              SELECT DISTINCT ${@category}
              FROM ${@schema}.${@table}
          schema:
            link: Schema Name/value
            schema: string
            mandatory: false
            createdBy: sql
          table:
            link: Table Name/value
            schema: string
            mandatory: false
            createdBy: sql
          category:
            link: columnName/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  SQL Script:
    actors:
      JavaScript:
        parent: JavaScript
        in:
          script:
            const:
              userCode: |-
                function buildCreateTable(schema, tableName, columns, partitionColumn, values) {

                  var colDefs = "";
                  var first = true;

                  // columns
                  for (var col in columns) {
                    var type = columns[col];

                    // tiny fix: Oracle needs VARCHAR2 length
                    if (type === "VARCHAR2") {
                      type = "VARCHAR2(100)";
                    }

                    if (!first) {
                      colDefs += ",\n";
                    }
                    colDefs += "  " + col + " " + type;
                    first = false;
                  }

                  // partitions
                  var partitions = "";
                  for (var i = 0; i < values.length; i++) {
                    var v = values[i];
                    // create a simple safe partition name: p_open, p_closed, etc.
                    var ind = i+1 ;
                    partitions += "  PARTITION p" + ind + " VALUES ('" + v + "'),\n";
                  }

                  partitions += "  PARTITION p0 VALUES (DEFAULT)";

                  var sql =
                    "CREATE TABLE " + schema + "." + tableName + "_PARTITIONED (\n" +
                    colDefs + "\n" +
                    ")\n" +
                    "PARTITION BY LIST (" + partitionColumn + ") (\n" +
                    partitions + "\n" +
                    ")";

                  return sql;
                }
                var values = [...arr];
                const sql = buildCreateTable(schema,tableName,columns,partitionColumn,values);
                sql ;
              script: |-
                function buildCreateTable(schema, tableName, columns, partitionColumn, values) {
                  var colDefs = "";
                  var first = true; // columns

                  for (var col in columns) {
                    var type = columns[col]; // tiny fix: Oracle needs VARCHAR2 length

                    if (type === "VARCHAR2") {
                      type = "VARCHAR2(100)";
                    }

                    if (!first) {
                      colDefs += ",\n";
                    }

                    colDefs += "  " + col + " " + type;
                    first = false;
                  } // partitions


                  var partitions = "";

                  for (var i = 0; i < values.length; i++) {
                    var v = values[i]; // create a simple safe partition name: p_open, p_closed, etc.

                    var ind = i + 1;
                    partitions += "  PARTITION p" + ind + " VALUES ('" + v + "'),\n";
                  }

                  partitions += "  PARTITION p0 VALUES (DEFAULT)";
                  var sql = "CREATE TABLE " + schema + "." + tableName + "_PARTITIONED (\n" + colDefs + "\n" + ")\n" + "PARTITION BY LIST (" + partitionColumn + ") (\n" + partitions + "\n" + ")";
                  return sql;
                }

                var values = [].concat(arr);
                var sql = buildCreateTable(schema, tableName, columns, partitionColumn, values);
                sql;
          schema:
            link: Schema Name/value
            schema: string
            mandatory: false
          tableName:
            link: Table Name/value
            schema: string
            mandatory: false
          columns:
            link: LuFunction  /result
            schema: '#ref'
            mandatory: false
          partitionColumn:
            link: columnName/value
            schema: string
            mandatory: false
          arr:
            link: DbCommand          /result/STATUS
            schema: string
            mandatory: false
        out:
          result:
            schema: string
      'JavaScript   ':
        parent: JavaScript
        in:
          script:
            const: |
              function columnsToCsv(columns) {
                var result = "";
                var first = true;

                for (var col in columns) {
                  if (!first) {
                    result += ", ";
                  }
                  result += col;
                  first = false;
                }

                return result;
              }
              columnsToCsv(columns);
          columns:
            link: LuFunction  /result
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: string
  Create Partition:
    actors:
      'DbCommand ':
        parent: DbCommand
        in:
          interface:
            const: null
            link: Interface /value
          sql:
            const: null
            link: JavaScript/result
      'StringFormat ':
        parent: StringFormat
        in:
          format:
            const: "INSERT /*+ APPEND */ INTO ${schema}.${table}_PARTITIONED\r\n(${columns})\r\
              \nSELECT\r\n  ${columns}\r\nFROM ${schema}.${table}\r\n"
          schema:
            link: Schema Name/value
            schema: string
            mandatory: false
            createdBy: format
          table:
            link: Table Name/value
            schema: string
            mandatory: false
            createdBy: format
          columns:
            link: JavaScript   /result
            schema: string
            mandatory: false
            createdBy: format
  Copy Data:
    actors:
      'DbCommand   ':
        parent: DbCommand
        in:
          interface:
            const: null
            link: Interface /value
          sql:
            const: null
            link: StringFormat /string
schemas:
  LuFunction  .out.result:
    type: object
    properties:
      PATIENT_ID:
        type: string
      VISIT_ID:
        type: string
      VISIT_DATE:
        type: string
      STATUS:
        type: string
      PHYSICIAN:
        type: string
      DIAGNOSIS:
        type: string
  DbCommand          .out.result:
    type: array
    items:
      type: object
      properties:
        STATUS:
          type: string
  JavaScript.in.columns:
    type: object
    properties:
      PATIENT_ID:
        type: string
      VISIT_ID:
        type: string
      VISIT_DATE:
        type: string
      STATUS:
        type: string
      PHYSICIAN:
        type: string
      DIAGNOSIS:
        type: string
  JavaScript   .in.columns:
    type: object
    properties:
      PATIENT_ID:
        type: string
      VISIT_ID:
        type: string
      VISIT_DATE:
        type: string
      STATUS:
        type: string
      PHYSICIAN:
        type: string
      DIAGNOSIS:
        type: string
