tags: Implementation
stages:
  Get Inputs:
    actors:
      partitionsNumber:
        parent: Const
        in:
          value:
            const: null
            external: partitionsNumber
        out:
          value:
            schema: string
      Flow Inputs:
        parent: Const
        in:
          value:
            const: null
            external: flowInputs
        out:
          value:
            schema: '#ref'
      currentPartition:
        parent: Const
        in:
          value:
            const: null
            external: currentPartition
        out:
          value:
            schema: string
      sourceTableName:
        parent: Const
        in:
          value:
            const: null
            external: sourceTableName
        out:
          value:
            schema: string
      sourceSchema:
        parent: Const
        in:
          value:
            const: null
            external: sourceSchema
        out:
          value:
            schema: string
      sourceInterface:
        parent: Const
        in:
          value:
            const: null
            external: sourceInterface
        out:
          value:
            schema: string
      whereClause:
        parent: Const
        in:
          value:
            const: null
            external: whereClause
        out:
          value:
            schema: string
      queryParameters:
        parent: Const
        in:
          value:
            const: null
            external: queryParameters
        out:
          value:
            schema: '#ref'
      countStatement:
        parent: Const
        in:
          value:
            const: null
            external: countStatement
        out:
          value:
            schema: string
      selectStatement:
        parent: Const
        in:
          value:
            const: null
            external: selectStatement
        out:
          value:
            schema: string
      Get List Of Fields:
        parent: InnerFlow
        in:
          flowName:
            const: BuildSelectClauseForQuery
          interfaceName:
            external: sourceInterface
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            external: sourceSchema
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            external: sourceTableName
            schema: string
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          result:
            schema: string
  Build Select Query:
    dependsOn: Get Inputs
    actors:
      No Partitions?:
        parent: Equals
        condition: result
        in:
          b:
            const: 1
            schema: integer
          a:
            link: partitionsNumber/value
      Count Statement1:
        parent: StringFormat
        in:
          format:
            const: select count(*) from ${schemaName}.${tableName}
          schemaName:
            link: sourceSchema/value
            schema: string
            mandatory: false
            createdBy: format
          tableName:
            link: sourceTableName/value
            schema: string
            mandatory: false
            createdBy: format
      Select Statement:
        parent: StringFormat
        in:
          format:
            const: select ${fieldsList} from ${schemaName}.${tableName}
          schemaName:
            link: sourceSchema/value
            schema: string
            mandatory: false
            createdBy: format
          tableName:
            link: sourceTableName/value
            schema: string
            mandatory: false
            createdBy: format
          fieldsList:
            link: Get List Of Fields/result
            schema: string
            mandatory: false
            createdBy: format
    split: '--------------------'
  More Than 1 Partition:
    else: true
    dependsOn: Get Inputs
    actors:
      Get Partition Name:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: sourceInterface/value
          sql:
            const: |-
              SELECT partition_name
              FROM all_tab_partitions
              WHERE table_name = ${tableName}
              and table_owner = ${schemaName}
              AND partition_position = ${partitionNo}
          tableName:
            link: sourceTableName/value
            schema: string
            mandatory: false
            createdBy: sql
          schemaName:
            link: sourceSchema/value
            schema: string
            mandatory: false
            createdBy: sql
          partitionNo:
            link: currentPartition/value
            schema: integer
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: string
  Do Nothing:
    dependsOn: Build Select Query
    split: '--------------------'
  Build Queries:
    dependsOn: More Than 1 Partition
    actors:
      Count Statement:
        parent: StringFormat
        in:
          format:
            const: select count(*) as cnt from ${schemaName}.${tableName} PARTITION
              (${partitionName})
          schemaName:
            link: sourceSchema/value
            schema: string
            mandatory: false
            createdBy: format
          tableName:
            link: sourceTableName/value
            schema: string
            mandatory: false
            createdBy: format
          partitionName:
            link: Get Partition Name/result
            schema: string
            mandatory: false
            createdBy: format
      Select Statemnt:
        parent: StringFormat
        in:
          format:
            const: select ${fieldsList} from ${schemaName}.${tableName} PARTITION
              (${partitionName})
          schemaName:
            link: sourceSchema/value
            schema: string
            mandatory: false
            createdBy: format
          tableName:
            link: sourceTableName/value
            schema: string
            mandatory: false
            createdBy: format
          fieldsList:
            link: Get List Of Fields/result
            schema: string
            mandatory: false
            createdBy: format
          partitionName:
            link: Get Partition Name/result
            schema: string
            mandatory: false
            createdBy: format
  Merge: {
    }
  'No Filter ':
    dependsOn: Merge
    actors:
      IsNull:
        parent: IsNull
        condition: result
        in:
          value:
            link: whereClause/value
      Select - No Where clause:
        parent: Const
        in:
          value:
            const: null
            link:
            - Select Statement/string
            - Select Statemnt/string
            schema: string
        out:
          value:
            schema: string
      Count - No Where clause:
        parent: Const
        in:
          value:
            const: null
            link:
            - Count Statement1/string
            - Count Statement/string
            schema: string
        out:
          value:
            schema: string
    split: '--------------------'
  'Filter    ':
    else: true
    dependsOn: Merge
    actors:
      'Count  - Add  Where Clause: InnerFlow':
        parent: InnerFlow
        in:
          flowName:
            const: BuildTableFilter
          selectClause:
            link:
            - Count Statement1/string
            - Count Statement/string
            schema: string
            mandatory: false
          tableFilter:
            link: whereClause/value
            schema: string
            mandatory: false
          filterParameters:
            link: queryParameters/value
            schema: string
            mandatory: false
        out:
          selectStatement:
            schema: string
          paramters:
            schema: '#ref'
      Select - Add  Where Clause:
        parent: InnerFlow
        in:
          flowName:
            const: BuildTableFilter
          selectClause:
            link:
            - Select Statement/string
            - Select Statemnt/string
            schema: string
            mandatory: false
          tableFilter:
            link: whereClause/value
            schema: string
            mandatory: false
          filterParameters:
            link: queryParameters/value
            schema: string
            mandatory: false
        out:
          selectStatement:
            schema: string
          paramters:
            schema: '#ref'
  Select Partition Records:
    actors:
      Logger:
        parent: Logger
        in:
          message:
            const: '${input}${num} of table ''${tableName}'' schema ''${schemaName}''
              (interface: ${interfaceName})'
          level:
            const: info
          input:
            link: Flow Inputs/value/message
            schema: string
            mandatory: false
            createdBy: message
          num:
            link: currentPartition/value
            schema: integer
            mandatory: false
          tableName:
            link: sourceTableName/value
            schema: string
            mandatory: false
            createdBy: message
          schemaName:
            link: sourceSchema/value
            schema: string
            mandatory: false
            createdBy: message
          interfaceName:
            link: sourceInterface/value
            schema: string
            mandatory: false
            createdBy: message
      Run Select Statement:
        parent: DbCommand
        in:
          interface:
            const: null
            link: sourceInterface/value
          sql:
            const: null
            link:
            - Select - No Where clause/value
            - Select - Add  Where Clause/selectStatement
          params:
            link: queryParameters/value
        out:
          result:
            external: result
            schema: '#ref'
  Given Count:
    dependsOn: Select Partition Records
    actors:
      GreaterThan:
        parent: GreaterThan
        condition: result
        in:
          b:
            const: 0
          a:
            external: tableCount
      Return -1:
        parent: Const
        in:
          value:
            const: -1
            schema: integer
        out:
          value:
            schema: integer
    split: '--------------------'
  Execute Count Statement:
    else: true
    dependsOn: Select Partition Records
    actors:
      Count Statement is Given?:
        parent: NotEquals
        condition: result
        in:
          a:
            external: countStatement
            schema: string
          b:
            const: ''
            schema: string
      Run Count Statement:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: sourceInterface/value
          sql:
            const: null
            link:
            - Count - No Where clause/value
            - 'Count  - Add  Where Clause: InnerFlow/selectStatement'
          params:
            link: queryParameters/value
        out:
          result:
            schema: integer
    split: '--------------------'
  No Count:
    else: true
    dependsOn: Select Partition Records
    actors:
      Return Count:
        parent: Const
        in:
          value:
            const: null
            external: tableCount
            schema: integer
        out:
          value:
            schema: integer
  Return Final Count:
    actors:
      'tableCount ':
        parent: Const
        in:
          value:
            const: null
            link:
            - Return -1/value
            - Run Count Statement/result
            - Return Count/value
            schema: integer
        out:
          value:
            external: tableCount
            schema: integer
schemas:
  Flow Inputs.out.value:
    type: object
    properties:
      message:
        type: string
  queryParameters.out.value:
    type: array
    items:
      type: string
  'Count  - Add  Where Clause: InnerFlow.out.paramters':
    type: array
    items:
      type: string
  Select - Add  Where Clause.out.paramters:
    type: array
    items:
      type: string
  Run Select Statement.out.result:
    type: array
    items:
      type: object
      properties:
        contract_id:
          type: integer
        order_id:
          type: integer
        order_type:
          type: string
        order_date:
          type: date
        order_status:
          type: string
