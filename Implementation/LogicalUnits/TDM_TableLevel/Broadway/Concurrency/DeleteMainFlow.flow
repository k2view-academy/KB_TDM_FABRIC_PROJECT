tags: Partition,Concurrency
stages:
  Loop From Last to First:
    actors:
      Loop On Tables:
        parent: ForLoop
        in:
          from:
            const: 0
          to:
            external: maxOrder
      Broadway Command:
        parent: StringFormat
        in:
          format:
            const: broadway TDM_TableLevel.DeleteTable iid=?
      Set Target Environment:
        parent: InnerFlow
        in:
          flowName:
            const: setTargetEnv
      Get TDMDB Schema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
  Get Tables of Current Order:
    actors:
      Get Tables Of Order:
        parent: LuFunction
        in:
          functionName:
            const: getTablesByOrder
          order:
            link:
              path: Loop On Tables/i
              iterate: Iterate
            schema: integer
            mandatory: false
            createdBy: functionName
          executionAction:
            const: Delete
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
  Continue only if there are tables  For Delete:
    actors:
      Get Tables?:
        parent: NotNull
        condition: result
        in:
          value:
            link:
              path: Get Tables Of Order/result
              iterate: First
      List Of Tables:
        parent: Const
        in:
          value:
            const: null
            link: Get Tables Of Order/result
        out:
          value:
            schema: '#ref'
  The Task is Stopped?:
    actors:
      Check if the Task is Stopped:
        parent: DbFetchField
        in:
          interface:
            const: TDM
          sql:
            const: |-
              SELECT execution_status FROM ${@schema}.task_execution_list
              WHERE task_execution_id = ${taskExecutionId}
              AND execution_status = 'stopped'
              LIMIT 1
          schema:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: string
  Interface's Tables Per Order:
    actors:
      Task is not stopped?:
        parent: IsNull
        condition: result
        in:
          value:
            link: Check if the Task is Stopped/result
      List Of Tables Per Interface:
        parent: Const
        in:
          value:
            const: null
            link:
              path: List Of Tables/value
              iterate: Iterate
        out:
          value:
            schema: '#ref'
  Build IIDs:
    dependsOn: Interface's Tables Per Order
    actors:
      First Run?:
        parent: IsNull
        condition: result
        in:
          value:
            link: List Of Tables Per Interface/value/batch_id
      Build IID:
        parent: InnerFlow
        in:
          flowName:
            const: BuildIID
          sourceEnv:
            external: sourceEnv
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceName:
            link: List Of Tables Per Interface/value/interface_name
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            link:
              path: List Of Tables Per Interface/value/tables_list/schema_name
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            link:
              path: List Of Tables Per Interface/value/tables_list/table_name
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
          partitionNum:
            schema: any
            mandatory: false
            createdBy: flowName
        out:
          iid:
            schema: string
      Get Ref Table ID:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            link: List Of Tables Per Interface/value/interface_name
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            link:
              path: List Of Tables Per Interface/value/tables_list/schema_name
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            link:
              path: List Of Tables Per Interface/value/tables_list/table_name
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: functionName
          section:
            const: TaskRefTables
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: task_ref_table_id
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: integer
    split: '--------------------'
  Batch Exists:
    else: true
    dependsOn: Interface's Tables Per Order
    actors:
      Retry Batch:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: batch_retry ${batchId} allow_cancelled=true
          batchId:
            link: List Of Tables Per Interface/value/batch_id
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
      Rerun BatchId:
        parent: Const
        in:
          value:
            const: null
            link: List Of Tables Per Interface/value/batch_id
            schema: string
        out:
          value:
            schema: string
  IIDs List:
    last: 1
    dependsOn: Build IIDs
    actors:
      Aggregate IIDs:
        parent: ArrayBuilder
        in:
          input:
            link:
              path: Build IID/iid
              pos: 0
        out:
          array:
            schema: '#ref'
    split: '--------------------'
  Do Nothing:
    last: 1
    dependsOn: Batch Exists
  Create List of IIDs:
    dependsOn: IIDs List
    actors:
      Concat IIDs to Instance Group:
        parent: Concat
        in:
          elements:
            link: Aggregate IIDs/array
    split: '--------------------'
  'Do Nothing  ':
    dependsOn: Do Nothing
  Get details before batch:
    dependsOn: Create List of IIDs
    actors:
      There Are Instances?:
        parent: NotEquals
        condition: result
        in:
          a:
            link: Concat IIDs to Instance Group/string
            schema: string
          b:
            const: ''
            schema: string
      get task affinity:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            link: List Of Tables Per Interface/value/interface_name
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            link:
              path: List Of Tables Per Interface/value/tables_list/schema_name
              iterate: First
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            link:
              path: List Of Tables Per Interface/value/tables_list/table_name
              iterate: First
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: functionName
          section:
            const: TaskRefTables
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: target_affinity
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: any
      get task maxWorkers:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            link: List Of Tables Per Interface/value/interface_name
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            link:
              path: List Of Tables Per Interface/value/tables_list/schema_name
              iterate: First
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            link:
              path: List Of Tables Per Interface/value/tables_list/table_name
              iterate: First
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: functionName
          section:
            const: TaskRefTables
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: target_max_no_of_workers
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: any
      get envID:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            link: List Of Tables Per Interface/value/interface_name
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            link:
              path: List Of Tables Per Interface/value/tables_list/schema_name
              iterate: First
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            link:
              path: List Of Tables Per Interface/value/tables_list/table_name
              iterate: First
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: functionName
          section:
            const: TaskInfo
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: targetEnvId
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: integer
      get task title:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            link: List Of Tables Per Interface/value/interface_name
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            link:
              path: List Of Tables Per Interface/value/tables_list/schema_name
              iterate: First
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            link:
              path: List Of Tables Per Interface/value/tables_list/table_name
              iterate: First
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: functionName
          section:
            const: TaskInfo
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: taskTitle
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: string
    split: '--------------------'
  'Do Nothing   ':
    dependsOn: 'Do Nothing  '
  Get affinity and max workers:
    dependsOn: Get details before batch
    actors:
      GetAffinityAndMaxWorker1:
        parent: InnerFlow
        in:
          flowName:
            const: GetAffinityAndMaxWorker
          taskAffinity:
            link: get task affinity/result
            schema: any
            mandatory: false
            createdBy: flowName
          taskMaxWorkers:
            link: get task maxWorkers/result
            schema: any
            mandatory: false
            createdBy: flowName
          interfaceName:
            link: List Of Tables Per Interface/value/interface_name
            schema: string
            mandatory: false
            createdBy: flowName
          envId:
            link: get envID/result
            schema: integer
            mandatory: false
            createdBy: flowName
        out:
          affinity:
            schema: string
          maxWorkers:
            schema: string
    split: '--------------------'
  'Do Nothing    ':
    dependsOn: 'Do Nothing   '
  Run Batch Per Interface Per Order:
    dependsOn: Get affinity and max workers
    actors:
      'Batch ':
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: batch TDM_TableLevel.(${instanceList})  FABRIC_COMMAND='${@command}'
              WITH ASYNC='true' ${@affinityStr} ${@maxWorkersStr} BATCH_ID_PREFIX='${@taskTitle}';
          command:
            link: Broadway Command/string
            schema: string
            mandatory: false
          instanceList:
            link: Concat IIDs to Instance Group/string
            schema: string
            mandatory: false
          taskTitle:
            link: get task title/result
            schema: string
            mandatory: false
          maxWorkersStr:
            link: GetAffinityAndMaxWorker1/maxWorkers
            schema: string
            mandatory: false
          affinityStr:
            link: GetAffinityAndMaxWorker1/affinity
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  'Do Nothing     ':
    dependsOn: 'Do Nothing    '
  Get Running IID:
    dependsOn: Run Batch Per Interface Per Order
    actors:
      Get IIDS:
        parent: Const
        in:
          value:
            const: null
            link: Aggregate IIDs/array
        out:
          value:
            schema: '#ref'
      Reset List Of IIDs:
        parent: ResetActors
        in:
          actorId:
            const:
            - Aggregate IIDs
    split: '--------------------'
  'Do Nothing      ':
    dependsOn: 'Do Nothing     '
  Split IIDS:
    dependsOn: Get Running IID
    actors:
      SplitIID:
        parent: InnerFlow
        in:
          flowName:
            const: SplitIID
          IID:
            link:
              path: Get IIDS/value
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  'Do Nothing        ':
    dependsOn: 'Do Nothing      '
  'Insert to ref exe stats  ':
    last: 1
    dependsOn: Split IIDS
    actors:
      InsertIntoTaskRefExe1:
        parent: InnerFlow
        in:
          flowName:
            const: InsertIntoTaskRefExe
          interfaceName:
            link:
              path: SplitIID/result/interface
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            link:
              path: SplitIID/result/schema
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            link:
              path: SplitIID/result/table
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          taskExecutionID:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
          batchID:
            link:
              path: Batch /result/Batch id
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
    split: '--------------------'
  'Do Nothing         ':
    last: 1
    dependsOn: 'Do Nothing        '
  'Aggregate Batch IDs  ':
    last: 1
    actors:
      List Of Batch IIDs To Wait For:
        parent: ArrayConcat
        in:
          input:
            link:
            - path: Batch /result/Batch id
              iterate: First
              pos: 0
            - path: Rerun BatchId/value
              pos: 1
        out:
          array:
            schema: '#ref'
  Batch IIDs of Current Order:
    actors:
      Batch IDs to Wait For:
        parent: Const
        in:
          value:
            const: null
            link: List Of Batch IIDs To Wait For/array
            schema: '#ref'
        out:
          value:
            schema: '#ref'
  Wait For Order's Batches to Finish:
    last: 1
    actors:
      Batch Cancelled - Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: Batch was cancelled
              actions:
                suppress: false
                log: true
                flowName: UpdateStoppedTask
                number_of_retries: ''
                retry_interval: ''
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
      Wait For Each Bach to Finish:
        parent: BatchWait
        in:
          batchId:
            const: null
            link:
              path: Batch IDs to Wait For/value
              iterate: Iterate
            default: false
  Clear Order's Batch IDs:
    actors:
      Reset List Of Batch IDs:
        parent: ResetActors
        in:
          actorId:
            const:
            - List Of Batch IIDs
schemas:
  Get Tables Of Order.out.result:
    type: array
    items:
      type: object
      properties:
        batch_id: {
          }
        interface_name:
          type: string
        tables_list:
          type: array
          items:
            type: object
            properties:
              interface_name:
                type: string
              schema_name:
                type: string
              table_name:
                type: string
  List Of Tables.out.value:
    type: array
    items:
      type: object
      properties:
        batch_id: {
          }
        interface_name:
          type: string
        tables_list:
          type: array
          items:
            type: object
            properties:
              interface_name:
                type: string
              schema_name:
                type: string
              table_name:
                type: string
  List Of Tables Per Interface.out.value:
    type: object
    properties:
      batch_id: {
        }
      interface_name:
        type: string
      tables_list:
        type: array
        items:
          type: object
          properties:
            interface_name:
              type: string
            schema_name:
              type: string
            table_name:
              type: string
  Retry Batch.out.result:
    type: array
    items:
      type: object
      properties:
        Result:
          type: string
  Aggregate IIDs.out.array:
    type: array
    items:
      type: string
  Batch .out.result:
    type: array
    items:
      type: object
      properties:
        Batch id:
          type: string
        Execution id:
          type: string
        Notes:
          type: string
  Get IIDS.out.value:
    type: array
    items:
      type: string
  SplitIID.out.result:
    type: object
    properties:
      environment:
        type: string
      interface:
        type: string
      schema:
        type: string
      table:
        type: string
      execution_id:
        type: string
      partition_no:
        type: string
  List Of Batch IIDs To Wait For.out.array:
    type: array
    items:
      type: string
  Batch IDs to Wait For.in.value:
    type: array
    items: {
      }
  Batch IDs to Wait For.out.value:
    type: array
    items:
      type: array
      items:
        type: string
