tags: Concurrency
stages:
  Set Records Count:
    actors:
      Get TDMDB Schema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
      Init record count:
        parent: JavaScript
        in:
          script:
            const: flowArgs.count = 0;
        out:
          result:
            schema: integer
  Get Source Data:
    actors:
      inputRecords:
        parent: Const
        in:
          value:
            const: null
            external: inputRecords
            schema: '#ref'
        out:
          value:
            schema: '#ref'
      Extract Task?:
        parent: EqualsIgnoreCase
        in:
          a:
            external: taskType
            schema: string
          b:
            const: EXTRACT
            schema: string
  'Insert To Sqlite  ':
    transactional: false
    actors:
      Insert Record to Sqlite Table:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: null
            external: sql
          params:
            link:
              path: inputRecords/value
              iterate: Iterate
      Update Counter:
        parent: JavaScript
        in:
          script:
            const: |
              flowArgs.count = flowArgs.count + 1;
        out:
          result:
            schema: integer
  Get Modulus:
    transactional: false
    actors:
      Get Mod of Current Count:
        parent: MathDivMod
        in:
          a:
            link: Update Counter/result
            schema: integer
          b:
            external: commitSize
            schema: integer
  Check Condition:
    transactional: false
    actors:
      Report Count?:
        parent: Equals
        in:
          a:
            link: Get Mod of Current Count/mod
            schema: integer
          b:
            const: 0
            schema: integer
  Update Status And Records Count:
    last: 1
    actors:
      And:
        parent: And
        condition: result
        in:
          b:
            link: Extract Task?/result
          a:
            link: Report Count?/result
      Update task_ref_partition1:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              update ${@TDMDB_SCHEMA}.task_ref_partition
               set execution_status=${execution_status} , number_of_processed_records=${number_of_processed_records}
              where task_execution_id=${task_execution_id} AND task_ref_table_id=${task_ref_table_id}
               AND partition_no=${partition_no}
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: task_execution_id
            schema: string
            mandatory: false
            createdBy: sql
          task_ref_table_id:
            external: task_ref_table_id
            schema: integer
            mandatory: false
            createdBy: sql
          partition_no:
            external: partitionNumber
            schema: string
            mandatory: false
            createdBy: sql
          execution_status:
            const: loading to fabric
            schema: string
            mandatory: false
            createdBy: sql
          number_of_processed_records:
            link: Update Counter/result
            schema: integer
            mandatory: false
            createdBy: sql
  Get Final Counter:
    actors:
      Get Counter:
        parent: JavaScript
        in:
          script:
            const: |
              flowArgs.count;
        out:
          result:
            schema: integer
  Update Number of Processed Records:
    actors:
      'If Extract Only  ':
        parent: EqualsIgnoreCase
        condition: result
        in:
          a:
            external: taskType
            schema: string
          b:
            const: EXTRACT
            schema: string
      Update task_ref_partition:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              update ${@TDMDB_SCHEMA}.task_ref_partition
               set number_of_processed_records=${number_of_processed_records}, end_time=NOW(), execution_status=${execution_status}
              where task_execution_id=${task_execution_id} AND task_ref_table_id=${task_ref_table_id}
               AND partition_no=${partition_no}
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: task_execution_id
            schema: string
            mandatory: false
            createdBy: sql
          task_ref_table_id:
            external: task_ref_table_id
            schema: integer
            mandatory: false
            createdBy: sql
          partition_no:
            external: partitionNumber
            schema: string
            mandatory: false
            createdBy: sql
          number_of_processed_records:
            link: Get Counter/result
            schema: integer
            mandatory: false
            createdBy: sql
          execution_status:
            const: completed
            schema: string
            mandatory: false
            createdBy: sql
schemas:
  inputRecords.in.value:
    type: array
    items: {
      }
  inputRecords.out.value:
    type: array
    items: {
      }
