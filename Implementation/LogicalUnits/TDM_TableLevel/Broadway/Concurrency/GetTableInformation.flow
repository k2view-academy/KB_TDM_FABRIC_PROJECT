tags: Concurrency
stages:
  inputs:
    actors:
      interfaceName:
        parent: Const
        in:
          value:
            const: null
            external: interfaceName
            schema: string
        out:
          value:
            schema: string
      schemaName:
        parent: Const
        in:
          value:
            const: null
            external: schemaName
            schema: string
        out:
          value:
            schema: string
      tableName:
        parent: Const
        in:
          value:
            const: null
            external: tableName
            schema: string
        out:
          value:
            schema: string
      taskExecutionId:
        parent: Const
        in:
          value:
            const: null
            external: taskExecutionId
        out:
          value:
            schema: integer
      order:
        parent: Const
        in:
          value:
            const: null
            external: order
        out:
          value:
            schema: integer
      isInPlaceMaskingTask:
        parent: Const
        in:
          value:
            const: null
            external: isInPlaceMaskingTask
        out:
          value:
            schema: boolean
  Table Ref ID:
    actors:
      'Get Table Ref ID    ':
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            link: interfaceName/value
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            link: schemaName/value
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            link: tableName/value
            schema: string
            mandatory: false
            createdBy: functionName
          section:
            const: TaskRefTables
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: task_ref_table_id
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: integer
  get info:
    actors:
      Table Error Handler No Fields Or No Key Fields:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: PopulateTableErrorsForTableLevel
                number_of_retries: ''
                retry_interval: ''
          tableName:
            external: tableName
            schema: string
            mandatory: false
          refTableID:
            link: Get Table Ref ID    /result
            schema: integer
            mandatory: false
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
      get table info:
        parent: LuFunction
        in:
          functionName:
            const: getTableInfo
          interfaceName:
            link: interfaceName/value
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            link: schemaName/value
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            link: tableName/value
            schema: string
            mandatory: false
            createdBy: functionName
          order:
            link: order/value
            schema: integer
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            link: taskExecutionId/value
            schema: integer
            mandatory: false
            createdBy: functionName
          isInPlaceMaskingTask:
            link: isInPlaceMaskingTask/value
            schema: boolean
            mandatory: false
            createdBy: functionName
        out:
          result:
            external: result
            schema: '#ref'
schemas:
  get table info.out.result:
    type: object
    properties:
      TaskInfo:
        type: object
        properties:
          loadEntity:
            type: boolean
          retentionPeriodValue:
            type: integer
          targetEnvId:
            type: integer
          taskTitle:
            type: string
          sourceEnvName:
            type: string
          taskId:
            type: integer
          deleteBeforeLoad:
            type: boolean
          sourceEnvId:
            type: integer
      CalculatedOrder:
        type: integer
      TargetInfo:
        type: object
        properties:
          target_schema_name:
            type: string
          target_interface_name:
            type: string
          target_ref_table_name:
            type: string
      TaskRefTables:
        type: array
        items:
          type: object
          properties:
            version_task_name:
              type: string
            ref_table_name:
              type: string
            filter_parameters: {
              }
            interface_name:
              type: string
            task_id:
              type: integer
            schema_name:
              type: string
            source_max_no_of_workers: {
              }
            target_table_prefix: {
              }
            target_max_no_of_workers: {
              }
            update_date:
              type: date
            filter_fields: {
              }
            target_affinity: {
              }
            task_ref_table_id:
              type: integer
            source_affinity: {
              }
            filter_type: {
              }
            version_task_execution_id:
              type: integer
            lu_name:
              type: string
            target_table_suffix: {
              }
            count_ind: {
              }
            table_filter: {
              }
            gui_filter: {
              }
      Definitions:
        type: object
        properties:
          interface_name:
            type: string
          load_flow:
            type: string
          partition_count_source:
            type: string
          schema_name:
            type: string
          table_name:
            type: string
          extract_flow:
            type: string
          count_indicator:
            type: string
          record_count_flow:
            type: string
          table_order:
            type: string
          partition_records_flow:
            type: string
          commit_size:
            type: string
          inplace_masking_update_flow:
            type: string
          delete_flow:
            type: string
      PartitionFlowInputs:
        type: object
        properties: {
          }
