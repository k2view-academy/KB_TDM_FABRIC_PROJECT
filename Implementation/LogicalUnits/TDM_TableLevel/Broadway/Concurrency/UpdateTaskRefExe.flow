tags: Concurrency
stages:
  Get input:
    actors:
      getTDMDBSchema1:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
  Update:
    actors:
      Update status:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              update ${@TDMDB_SCHEMA}.task_ref_exe_stats
               set execution_status='completed',
               number_of_processed_records = number_of_records_to_process ,
               number_of_failed_records = 0
               where task_execution_id=${task_execution_id} AND batch_id=${batch_id} AND execution_action='Delete' and execution_status = 'running';
          TDMDB_SCHEMA:
            link: getTDMDBSchema1/schema
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: taskExeID
            schema: string
            mandatory: false
            createdBy: sql
          batch_id:
            external: batchID
            schema: string
            mandatory: false
            createdBy: sql
