tags: Concurrency
stages:
  Prepare the Data:
    actors:
      Get Current Time:
        parent: Now
      Get source env:
        parent: FabricSetRead
        in:
          key:
            const: TDM_SOURCE_ENVIRONMENT_NAME
            default: false
      Get Task Exec ID:
        parent: FabricSetRead
        in:
          key:
            const: TDM_TASK_EXE_ID
            default: false
      Get the Error Fields:
        parent: ErrorFields
        in:
          error:
            external: error
        out:
          inputs:
            schema: '#ref'
      'Get executionAction ':
        parent: NotNull
        disabled: true
        in:
          value:
            external: executionAction
      Check executionAction:
        parent: NotEquals
        in:
          a:
            const: executionAction
            external: Delete
            schema: string
          b:
            const: Delete
            schema: string
  Create IID:
    dependsOn: Prepare the Data
    actors:
      Table Name Given?:
        parent: NotEquals
        condition: result
        in:
          a:
            external: tableName
            schema: string
          b:
            const: ALL_TABLES
            schema: string
      Build IID:
        parent: InnerFlow
        in:
          flowName:
            const: BuildIID
          partitionNum:
            schema: any
            mandatory: false
            createdBy: flowName
          sourceEnv:
            link: Get source env/result
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            link: Get Task Exec ID/result
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          iid:
            schema: string
      TABLE_NAME:
        parent: Const
        in:
          value:
            const: null
            external: tableName
            schema: string
        out:
          value:
            schema: string
    split: '--------------------'
  No Table Name:
    else: true
    dependsOn: Prepare the Data
    actors:
      ALL_TABLES:
        parent: Const
        in:
          value:
            const: ALL_TABLES
            schema: string
        out:
          value:
            schema: string
  Format the actor's parameters:
    actors:
      Format the current date:
        parent: DateFormat
        in:
          date:
            link: Get Current Time/date
      Get Executor Name:
        parent: FabricSetRead
        in:
          key:
            const: USER_NAME
            default: false
      Set Entity Status to Failure:
        parent: FabricSet
        in:
          key:
            const: ENTITY_STATUS
            default: false
          value:
            const: failed
            default: false
      Get TDMDB Schema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
      Set SOURCE_ENTITY_ID:
        parent: FabricSet
        in:
          key:
            const: SOURCE_ENTITY_ID
            default: false
          value:
            link: Build IID/iid
      Limit Error Message:
        parent: Substring
        in:
          begin:
            const: 0
          end:
            const: 1000
          string:
            link: Get the Error Fields/message
      IfElse:
        parent: IfElse
        in:
          a:
            const: execution_action = 'Delete'
            schema: string
          b:
            const: execution_action <> 'Delete'
            schema: string
          test:
            link:
            - Get executionAction /result
            - Check executionAction/result
        out:
          result:
            schema: string
      JavaScript1:
        parent: JavaScript
        in:
          script:
            const: |-
              var result = "";
              if (executionAction == null) {
                  result = " and execution_action <> 'Delete'";
              } else if (executionAction == "Delete") {
                  result = "and execution_action = 'Delete'";
              }

              result;
          executionAction:
            external: executionAction
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Load Data to Detailed Error table:
    actors:
      Error Handler for reporting to TDM Error Table:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: true
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Load Data To Error Table:
        parent: DbLoad
        in:
          interface:
            const: TDM
          schema:
            const: null
            link: Get TDMDB Schema/schema
          table:
            const: task_exe_error_detailed
          fields:
            const:
            - task_execution_id
            - lu_name
            - entity_id
            - iid
            - target_entity_id
            - error_category
            - error_code
            - error_message
            - creation_date
            - flow_name
            - stage_name
            - actor_name
            - actor_parameters
          dialect:
            const: postgres
          task_execution_id:
            link: Get Task Exec ID/result
            schema: string
          lu_name:
            const: TDM_TableLevel
            schema: string
          entity_id:
            link: Build IID/iid
            schema: string
          iid:
            link:
            - TABLE_NAME/value
            - ALL_TABLES/value
            schema: string
          target_entity_id:
            const: ''
            link:
            - TABLE_NAME/value
            - ALL_TABLES/value
            schema: string
            default: true
          error_category:
            const: Rejected Table
            schema: string
          error_code:
            link: Get the Error Fields/errorCode
            schema: string
          error_message:
            link: Limit Error Message/string
            schema: string
          creation_date:
            link: Format the current date/string
            schema: string
          flow_name:
            link: Get the Error Fields/flow
            schema: string
          stage_name:
            link: Get the Error Fields/stage
            schema: string
          actor_name:
            link: Get the Error Fields/actor
            schema: string
          actor_parameters:
            const: ''
            schema: string
            default: true
      Set Entity Status to Failed:
        parent: FabricSet
        in:
          key:
            const: ENTITY_STATUS
            default: false
          value:
            const: failed
            default: false
      Set Record Status to Failed:
        parent: FabricSet
        in:
          key:
            const: RECORD_STATUS
            default: false
          value:
            const: failed
            default: false
      Get LU Name:
        parent: FabricSetRead
        in:
          key:
            const: TABLES_LU_NAME
            default: false
  Update TASK_REF_EXE_STATS:
    dependsOn: Load Data to Detailed Error table
    actors:
      '!All_TABLES?':
        parent: NotEquals
        condition: result
        in:
          a:
            external: tableName
            schema: string
          b:
            const: ALL_TABLES
            schema: string
      Update TDMDB table for Reference Table:
        parent: StringFormat
        in:
          format:
            const: "UPDATE ${TDMDB_SCHEMA}.TASK_REF_EXE_STATS\r\nSET execution_status\
              \ = 'failed', number_of_failed_records = number_of_records_to_process,\r\
              \nnumber_of_processed_records = 0,\r\nerror_msg = '${errorMsg}',\r\n\
              end_time = CURRENT_TIMESTAMP AT TIME ZONE 'UTC',\r\nupdated_by = '${userName}'\r\
              \nWHERE task_execution_id = ${taskExecutionID} \r\nand ('${tableName}'\
              \ = 'ALL_TABLES' OR task_ref_table_id = ${refTableID})\r\n${executionAction}"
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: format
          errorMsg:
            link: Limit Error Message/string
            schema: string
            mandatory: false
            createdBy: format
          userName:
            link: Get Executor Name/result
            schema: string
            mandatory: false
            createdBy: format
          taskExecutionID:
            link: Get Task Exec ID/result
            schema: string
            mandatory: false
            createdBy: format
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: format
          refTableID:
            external: refTableID
            schema: integer
            mandatory: false
            createdBy: format
          executionAction:
            link: JavaScript1/result
            schema: string
            mandatory: false
            createdBy: format
    split: '--------------------'
  Update TASK_REF_EXE_STATS for All tables:
    else: true
    dependsOn: Load Data to Detailed Error table
    actors:
      Update TDMDB table for Reference Table1:
        parent: StringFormat
        in:
          format:
            const: "UPDATE ${TDMDB_SCHEMA}.TASK_REF_EXE_STATS\r\nSET execution_status\
              \ = 'failed', number_of_failed_records = number_of_records_to_process,\r\
              \nnumber_of_processed_records = 0,\r\nerror_msg = '${errorMsg}',\r\n\
              end_time = CURRENT_TIMESTAMP AT TIME ZONE 'UTC',\r\nupdated_by = '${userName}'\r\
              \nWHERE task_execution_id = ${taskExecutionID} ${executionAction}"
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: format
          errorMsg:
            link: Limit Error Message/string
            schema: string
            mandatory: false
            createdBy: format
          userName:
            link: Get Executor Name/result
            schema: string
            mandatory: false
            createdBy: format
          taskExecutionID:
            link: Get Task Exec ID/result
            schema: string
            mandatory: false
            createdBy: format
          executionAction:
            link: JavaScript1/result
            schema: string
            mandatory: false
            createdBy: format
  Update Table Entity:
    actors:
      'Update TDMDB table for Reference Table   ':
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: null
            link:
            - Update TDMDB table for Reference Table/string
            - Update TDMDB table for Reference Table1/string
  Add to TASK_EXECUTION_ENTITIES:
    actors:
      '!All_TABLES?1':
        parent: NotEquals
        condition: result
        in:
          a:
            external: tableName
            schema: string
          b:
            const: ALL_TABLES
            schema: string
      Populate Task Execution Entities For Tables:
        parent: InnerFlow
        in:
          flowName:
            const: PopulateTaskExecutionEntitiesForTables
          luName:
            const: ''
            link: Get LU Name/result
            schema: string
            default: true
            mandatory: false
          taskExecutionId:
            link: Get Task Exec ID/result
            schema: string
            mandatory: false
          tableName:
            link:
            - TABLE_NAME/value
            - ALL_TABLES/value
            schema: string
            mandatory: false
schemas:
  Get the Error Fields.out.inputs:
    type: object
    properties:
      interface:
        type: string
      luType:
        type: string
      parallel:
        type: boolean
      stop_on_error:
        type: boolean
      syncMode:
        type: string
      iid:
        type: string
