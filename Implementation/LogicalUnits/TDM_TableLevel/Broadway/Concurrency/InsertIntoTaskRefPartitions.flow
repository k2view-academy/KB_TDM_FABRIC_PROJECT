tags: Concurrency
stages:
  Get Inputs:
    actors:
      Now:
        parent: Now
      getTDMDBSchema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
  Split IID:
    actors:
      Format the Current Time:
        parent: DateFormat
        in:
          format:
            const: yyyy-MMM-dd HH:mm:ss.SSS
          date:
            link: Now/date
      Get Table Ref ID:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: functionName
          section:
            const: TaskRefTables
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: task_ref_table_id
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionID
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: integer
      Get Task ID:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: functionName
          section:
            const: TaskInfo
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: taskId
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionID
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: integer
  Insert Into Partition Table:
    actors:
      'Error Handler   ':
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: PopulatePartitionTableErrorsForTableLevel
                number_of_retries: ''
                retry_interval: ''
          tableName:
            external: tableName
            schema: string
            mandatory: false
          partitionNumber:
            external: partitionNumber
            schema: string
            mandatory: false
          refTableID:
            link: Get Table Ref ID/result
            schema: integer
            mandatory: false
      DbLoad:
        parent: DbLoad
        in:
          interface:
            const: TDM
          schema:
            const: null
            link: getTDMDBSchema/schema
          table:
            const: task_ref_partition
          fields:
            const:
            - task_id
            - task_execution_id
            - task_ref_table_id
            - table_name
            - partition_no
            - batch_id
            - start_time
            - end_time
            - execution_status
            - number_of_records_to_process
            - number_of_processed_records
            - number_of_failed_records
            - error_msg
            - instance_id
          keys:
            const:
            - task_execution_id
            - task_ref_table_id
            - partition_no
          dialect:
            const: postgres
          task_id:
            link: Get Task ID/result
            schema: string
            mandatory: false
            createdBy: table
          task_execution_id:
            external: taskExecutionID
            schema: string
            mandatory: false
            createdBy: table
          task_ref_table_id:
            link: Get Table Ref ID/result
            schema: integer
            mandatory: false
            createdBy: table
          table_name:
            external: tableName
            schema: string
            mandatory: false
            createdBy: table
          partition_no:
            external: partitionNumber
            schema: string
            mandatory: false
            createdBy: table
          batch_id:
            external: batchId
            schema: string
            mandatory: false
            createdBy: table
          start_time:
            link: Format the Current Time/string
            schema: integer
            mandatory: false
            createdBy: table
          end_time:
            schema: any
            mandatory: false
            createdBy: table
          execution_status:
            const: pending
            schema: string
            mandatory: false
            createdBy: table
          number_of_records_to_process:
            schema: any
            mandatory: false
            createdBy: table
          number_of_processed_records:
            schema: any
            mandatory: false
            createdBy: table
          error_msg:
            schema: any
            mandatory: false
            createdBy: table
          instance_id:
            external: instance_id
            schema: string
            mandatory: false
            createdBy: fields
          number_of_failed_records:
            schema: any
            mandatory: false
            createdBy: fields
