tags: Concurrency
stages:
  Get Tables With Count Enabled:
    actors:
      Get Tables for Count:
        parent: LuFunction
        in:
          functionName:
            const: fnGetTablesByAttributeValue
          section:
            const: TaskRefTables
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: count_ind
            schema: string
            mandatory: false
            createdBy: functionName
          attrVal:
            const: 'true'
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: any
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
  To Json String:
    actors:
      Json Stringify:
        parent: JsonStringify
        in:
          object:
            link: Get Tables for Count/result
  Parse:
    actors:
      Json Parser:
        parent: JsonParser
        in:
          stream:
            link: Json Stringify/string
        out:
          object:
            schema: '#ref'
      Get TDMDB Schema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
  Get Count:
    actors:
      Get Table Count:
        parent: InnerFlow
        in:
          flowName:
            const: GetTableCount
          sourceSchema:
            link:
              path: Json Parser/object/schemaName
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            link:
              path: Json Parser/object/tableName
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            link:
              path: Json Parser/object/taskExecutionId
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          sourceInterface:
            link:
              path: Json Parser/object/interfaceName
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          tableCount:
            schema: integer
      Get Ref Table ID:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            link: Json Parser/object/interfaceName
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            link: Json Parser/object/schemaName
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            link: Json Parser/object/tableName
            schema: string
            mandatory: false
            createdBy: functionName
          section:
            const: TaskRefTables
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: task_ref_table_id
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            link: Json Parser/object/taskExecutionId
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: integer
  Store Table Count:
    actors:
      Set Table Count:
        parent: LuFunction
        in:
          functionName:
            const: fnSetTableCount
          interfaceName:
            link:
              path: Json Parser/object/interfaceName
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            link:
              path: Json Parser/object/schemaName
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            link:
              path: Json Parser/object/tableName
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            link:
              path: Json Parser/object/taskExecutionId
              iterate: Iterate
            schema: integer
            mandatory: false
            createdBy: functionName
          tableCount:
            link: Get Table Count/tableCount
            schema: integer
            mandatory: false
            createdBy: functionName
      Update Count in TASK_REF_EXE_STATS:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              UPDATE ${@TDMDB_SCHEMA}.task_ref_exe_stats s
              SET
                number_of_records_to_process = ${tableCount}
              WHERE s.task_execution_id = ${taskExecId}
                AND s.task_ref_table_id = ${taskRefTableId}
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          tableCount:
            link: Get Table Count/tableCount
            schema: integer
            mandatory: false
            createdBy: sql
          taskExecId:
            link: Json Parser/object/taskExecutionId
            schema: integer
            mandatory: false
            createdBy: sql
          taskRefTableId:
            link: Get Ref Table ID/result
            schema: integer
            mandatory: false
            createdBy: sql
schemas:
  Get Tables for Count.out.result:
    type: array
    items: {
      }
  Json Parser.out.object:
    type: array
    items:
      type: object
      properties:
        taskExecutionId:
          type: integer
        interfaceName:
          type: string
        schemaName:
          type: string
        tableName:
          type: string
