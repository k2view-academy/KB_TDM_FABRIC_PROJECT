tags: Concurrency
stages:
  Get Input:
    actors:
      Get TDMDB Schema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
      Loop On Tables:
        parent: ForLoop
        in:
          from:
            const: 0
          to:
            external: maxOrder
  Call Orders Function:
    actors:
      Get Tables Of Order:
        parent: LuFunction
        in:
          functionName:
            const: getTablesByOrder
          order:
            link:
              path: Loop On Tables/i
              iterate: Iterate
            schema: integer
            mandatory: false
            createdBy: functionName
          executionAction:
            const: ExtractAndLoad
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
      Broadway Command:
        parent: StringFormat
        in:
          format:
            const: broadway TDM_TableLevel.TDMTableLevelOrchestrator iid=?, syncMode="${syncMode}",
              taskType=${taskType}, luName=${luName}, currentOrder=${order}, taskExeID=${taskExeID}
          syncMode:
            external: syncMode
            schema: string
            mandatory: false
          luName:
            const: TDM_TableLevel
            schema: string
            mandatory: false
          taskType:
            external: taskType
            schema: string
            mandatory: false
          order:
            link:
              path: Loop On Tables/i
              iterate: Iterate
            schema: integer
            mandatory: false
            createdBy: format
          taskExeID:
            external: taskExeID
            schema: string
            mandatory: false
            createdBy: format
  Get Tables List:
    actors:
      List Of Tables Per Interface:
        parent: Const
        in:
          value:
            const: null
            link:
              path: Get Tables Of Order/result
              iterate: Iterate
        out:
          value:
            schema: '#ref'
      Initiate List of Rerun Batches:
        parent: JavaScript
        in:
          script:
            const: flowArgs.listBatchRerun = [];
        out:
          result:
            schema: '#ref'
  'Get Table Instances    ':
    dependsOn: Get Tables List
    actors:
      Tables To Handle?:
        parent: NotNull
        condition: result
        in:
          value:
            link:
              path: List Of Tables Per Interface/value/tables_list/interface_name
              iterate: First
            schema: string
      Error Handler - Get Table Instances:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: true
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Set Source Env:
        parent: InnerFlow
        in:
          flowName:
            const: setSourceEnv
      PrepareBatchForTable1:
        parent: InnerFlow
        in:
          flowName:
            const: PrepareBatchForTable
          taskExecutionID:
            external: taskExeID
            schema: string
            mandatory: false
            createdBy: flowName
          syncMode:
            external: syncMode
            schema: string
            mandatory: false
            createdBy: flowName
          listOfOrderTables:
            link: List Of Tables Per Interface/value
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          taskType:
            external: taskType
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          TablesInstanceList:
            schema: '#ref'
          interfaceAfinity:
            schema: string
          interfaceMaxWorkers:
            schema: string
          taskTitle:
            schema: string
          taskId:
            schema: integer
    split: '--------------------'
  No Tables to Handle:
    else: true
    dependsOn: Get Tables List
  Run Batch For Instances:
    dependsOn: 'Get Table Instances    '
    actors:
      Error Handler - Insert Into Ref Partition:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: true
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      RunBatchForInstances1:
        parent: InnerFlow
        in:
          flowName:
            const: RunBatchForInstances
          TablesInstanceList:
            link: PrepareBatchForTable1/TablesInstanceList
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          taskExeID:
            external: taskExeID
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceName:
            link: List Of Tables Per Interface/value/interface_name
            schema: string
            mandatory: false
            createdBy: flowName
          command:
            link: Broadway Command/string
            schema: string
            mandatory: false
            createdBy: flowName
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: flowName
          taskTitle:
            link: PrepareBatchForTable1/taskTitle
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceAffinity:
            link: PrepareBatchForTable1/interfaceAfinity
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceMaxWorkers:
            link: PrepareBatchForTable1/interfaceMaxWorkers
            schema: string
            mandatory: false
            createdBy: flowName
          taskId:
            link: PrepareBatchForTable1/taskId
            schema: integer
            mandatory: false
            createdBy: flowName
        out:
          batchId:
            schema: string
    split: '--------------------'
  Do Nothing:
    dependsOn: No Tables to Handle
  Merge Stage: {
    }
  Rerunning Batch:
    dependsOn: Merge Stage
    actors:
      Rerun?:
        parent: NotNull
        condition: result
        in:
          value:
            link: List Of Tables Per Interface/value/batch_id
      Retry Batch:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: batch_retry ${batchId} allow_cancelled=true
          batchId:
            link: List Of Tables Per Interface/value/batch_id
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
      Rerun BatchId:
        parent: Const
        in:
          value:
            const: null
            link: List Of Tables Per Interface/value/batch_id
            schema: string
        out:
          value:
            schema: string
    split: '--------------------'
  No Rerunning:
    else: true
    dependsOn: Merge Stage
  'Get Batch IDs  ':
    last: 1
    actors:
      List Of Batch IIDs To Wait For:
        parent: ArrayConcat
        in:
          input:
            link:
            - path: RunBatchForInstances1/batchId
              pos: 0
            - path: Rerun BatchId/value
              pos: 1
        out:
          array:
            schema: '#ref'
  'Batch IIDs of Current Order  ':
    actors:
      Batch IDs to Wait For:
        parent: Const
        in:
          value:
            const: null
            link: List Of Batch IIDs To Wait For/array
            schema: '#ref'
        out:
          value:
            schema: '#ref'
  'Wait For Order''s Batches to Finish  ':
    last: 1
    actors:
      Wait For Each Bach to Finish:
        parent: BatchWait
        in:
          batchId:
            link:
              path: Batch IDs to Wait For/value
              iterate: Iterate
  'Clear Order''s Batch IDs  ':
    last: 1
    actors:
      Reset List Of Batch IDs:
        parent: ResetActors
        in:
          actorId:
            const:
            - List Of Batch IIDs To Wait For
schemas:
  Get Tables Of Order.out.result:
    type: array
    items:
      type: object
      properties:
        batch_id: {
          }
        interface_name:
          type: string
        tables_list:
          type: array
          items:
            type: object
            properties:
              interface_name:
                type: string
              schema_name:
                type: string
              table_name:
                type: string
  List Of Tables Per Interface.out.value:
    type: object
    properties:
      batch_id: {
        }
      interface_name:
        type: string
      tables_list:
        type: array
        items:
          type: object
          properties:
            interface_name:
              type: string
            schema_name:
              type: string
            table_name:
              type: string
  Initiate List of Rerun Batches.out.result:
    type: array
    items: {
      }
  PrepareBatchForTable1.in.listOfOrderTables:
    type: array
    items:
      type: object
      properties:
        interface_name:
          type: string
        tables_list:
          type: array
          items:
            type: object
            properties:
              interface_name:
                type: string
              schema_name:
                type: string
              table_name:
                type: string
  PrepareBatchForTable1.out.TablesInstanceList:
    type: array
    items:
      type: string
  RunBatchForInstances1.in.TablesInstanceList:
    type: array
    items:
      type: string
  Retry Batch.out.result:
    type: array
    items:
      type: object
      properties:
        Result:
          type: string
  List Of Batch IIDs To Wait For.out.array:
    type: array
    items:
      type: string
  Batch IDs to Wait For.in.value:
    type: array
    items:
      type: string
  Batch IDs to Wait For.out.value:
    type: array
    items:
      type: array
      items:
        type: string
