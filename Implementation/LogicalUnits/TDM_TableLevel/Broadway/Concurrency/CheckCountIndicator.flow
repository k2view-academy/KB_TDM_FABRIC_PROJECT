tags: Partition,Concurrency
stages:
  Get Inputs:
    actors:
      'countIndicator  ':
        parent: ToString
        in:
          value:
            external: countIndicator
  Count Allowed:
    dependsOn: Get Inputs
    actors:
      'True':
        parent: Equals
        condition: result
        in:
          b:
            const: 'true'
            schema: string
          a:
            link: countIndicator  /string
      Build Filter Queries:
        parent: InnerFlow
        in:
          flowName:
            const: BuildFilterQueries
          sourceSchema:
            external: sourceSchema
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: flowName
          tableFilter:
            external: tableFilter
            schema: string
            mandatory: false
            createdBy: flowName
          filterParameters:
            external: filterParameters
            schema: string
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
          sourceInterface:
            external: sourceInterface
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          countClause:
            schema: string
          filterClause:
            schema: string
          clauseParameters:
            schema: '#ref'
    split: '--------------------'
  No Count Allow:
    else: true
    dependsOn: Get Inputs
    actors:
      Empty Table Count Flow1:
        parent: Const
        in:
          value:
            schema: string
        out:
          value:
            external: countFlow
            schema: string
      Empty Count Statement1:
        parent: Const
        in:
          value:
            schema: string
        out:
          value:
            external: countClause
            schema: string
      Empty Count Statement Parameters1:
        parent: Const
        in:
          value:
            schema: string
        out:
          value:
            external: clauseParameters
            schema: string
  Check Flow is given:
    dependsOn: Count Allowed
    actors:
      Not Empty:
        parent: NotEquals
        condition: result
        in:
          a:
            external: countFlow
            schema: string
          b:
            const: ''
            schema: string
      Table Count Flow:
        parent: Const
        in:
          value:
            const: null
            external: countFlow
            schema: string
        out:
          value:
            external: countFlow
            schema: string
      Empty Count Statement:
        parent: Const
        in:
          value:
            schema: string
        out:
          value:
            external: countClause
            schema: string
      Empty Count Statement Parameters:
        parent: Const
        in:
          value:
            schema: string
        out:
          value:
            external: clauseParameters
            schema: string
    split: '--------------------'
  No Flow is Given:
    else: true
    dependsOn: Count Allowed
    actors:
      Empty Table Count Flow:
        parent: Const
        in:
          value:
            schema: string
        out:
          value:
            external: countFlow
            schema: string
      Count Statement:
        parent: Const
        in:
          value:
            const: null
            link: Build Filter Queries/countClause
        out:
          value:
            external: countClause
      Count Statement Parameters:
        parent: Const
        in:
          value:
            const: null
            link: Build Filter Queries/clauseParameters
        out:
          value:
            external: clauseParameters
    split: '--------------------'
  Do Nothing:
    dependsOn: No Count Allow
schemas:
  Build Filter Queries.out.clauseParameters:
    type: array
    items:
      type: string
