tags: Concurrency
stages:
  Get Partition:
    actors:
      'FabricSet  ':
        parent: FabricSet
        in:
          key:
            const: OLD_FORMAT
            default: false
          value:
            const: 'false'
            default: false
      Partition Number:
        parent: Const
        in:
          value:
            const: null
            external: partition
        out:
          value:
            schema: string
  'Old Format ?  ':
    actors:
      SampleMathAbs:
        parent: SampleMathAbs
        in:
          input:
            link: Partition Number/value
  Add:
    actors:
      MathAdd:
        parent: MathAdd
        in:
          b:
            const: 1
          a:
            link: SampleMathAbs/result
  Build IID in the old format:
    actors:
      ForLoop:
        parent: ForLoop
        in:
          from:
            const: 1
          to:
            link: MathAdd/result
  Do Nothing:
    actors:
      BuildIID:
        parent: InnerFlow
        in:
          flowName:
            const: BuildIID
          sourceEnv:
            external: sourceEnv
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
          partitionNum:
            link:
              path: ForLoop/i
              iterate: Iterate
            schema: integer
            mandatory: false
            createdBy: flowName
        out:
          iid:
            schema: string
  Already Ran?:
    actors:
      Check if Executed:
        parent: DbFetchField
        disabled: true
        in:
          interface:
            const: TDM
          sql:
            const: |-
              SELECT COUNT(1) as CNT
              FROM ${@schema}.task_ref_partition
              WHERE task_execution_id = ${task_execution_id}
              AND task_ref_table_id = ${task_ref_table_id}
              AND partition_no = ${partition_no}
              AND execution_status in ('completed', 'failed')
          schema:
            external: TDMDB_SCHEMA
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: sql
          task_ref_table_id:
            external: taskTableId
            schema: integer
            mandatory: false
            createdBy: sql
          partition_no:
            link:
              path: ForLoop/i
              iterate: Iterate
            schema: integer
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: integer
  Build List Of IIDs:
    last: 1
    actors:
      Not Executed?:
        parent: Equals
        condition: result
        disabled: true
        in:
          a:
            link: Check if Executed/result
            schema: integer
          b:
            const: 0
            schema: integer
      ArrayBuilder:
        parent: ArrayBuilder
        in:
          input:
            link:
              path: BuildIID/iid
              pos: 0
        out:
          array:
            external: instances
            schema: '#ref'
  Old Format?:
    actors:
      Number of Partitions is -1 ?:
        parent: Equals
        condition: result
        in:
          b:
            const: -1
            schema: integer
          a:
            link: Partition Number/value
      FabricSet:
        parent: FabricSet
        in:
          key:
            const: OLD_FORMAT
            default: false
          value:
            const: 'true'
            default: false
schemas:
  ArrayBuilder.out.array:
    type: array
    items:
      type: string
