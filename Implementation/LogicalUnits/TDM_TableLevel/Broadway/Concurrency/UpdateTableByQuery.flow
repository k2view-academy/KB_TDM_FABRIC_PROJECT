tags: Concurrency
stages:
  Inputs:
    transactional: false
    actors:
      Target Interface:
        parent: Const
        remark: The target interface
        in:
          value:
            const: null
            external: targetInterface
            schema: string
        out:
          value:
            schema: string
      Target Schema:
        parent: Const
        remark: The target Schema
        in:
          value:
            const: null
            external: targetSchema
            schema: string
        out:
          value:
            schema: string
      Target Table Name:
        parent: Const
        remark: The name of the target table.
        in:
          value:
            const: null
            external: targetTable
            schema: string
        out:
          value:
            schema: string
      'Table''s fields Names ':
        parent: Const
        height: 69
        in:
          value:
            const: null
            external: fieldsArray
            schema: '#ref'
        out:
          value:
            schema: '#ref'
      Where fields Names:
        parent: Const
        in:
          value:
            const: null
            external: whereArray
            schema: '#ref'
        out:
          value:
            schema: '#ref'
  Build Statement:
    transactional: true
    actors:
      Exclude TDM from Transaction:
        parent: NoTx
        in:
          interface:
            const: TDM
      DB Error Handler Batch:
        parent: TDMDbErrorHandlerBatch
        in:
          interface:
            const: null
            link: Target Interface/value
          config:
            const:
            - exceptionKey: com.k2view.fabric.common.io.basic.exception.StandardSqlException
              conditions:
                standardType: UNIQUE_CONSTRAINT
              actions:
                suppress: true
                log: true
                flowName: PopulatePartitionTableErrorsOnly
                number_of_retries: ''
                retry_interval: ''
      Build Update Statement:
        parent: JavaScript
        in:
          script:
            const: |-
              var updateStatement = "update " + schema + "." + tableName + " set ";
              var firstInd = true;
              for (var idx in fields) {
                  if (firstInd == false) {
                      updateStatement += ",";
                  } else {
                      firstInd = false;
                  }

                  updateStatement += fields[idx] + " = ${" + fields[idx] + "}";
              }
              firstInd = true;
              if (whereFields != null) {
                  for (var idx in whereFields) {
                      if (firstInd == true) {
                          updateStatement += " where ";
                          firstInd = false;
                      } else {
                          updateStatement += " and ";
                      }

                      updateStatement += whereFields[idx] + " = ${k2key__" + whereFields[idx] + "}";
                  }

              }
              updateStatement;
          fields:
            link: Table's fields Names /value
            schema: '#ref'
            mandatory: false
          whereFields:
            link: Where fields Names/value
            schema: '#ref'
            mandatory: false
          schema:
            external: targetSchema
            schema: string
            mandatory: false
          tableName:
            external: targetTable
            schema: string
            mandatory: false
        out:
          result:
            schema: string
      Input Records:
        parent: Const
        in:
          value:
            const: null
            external: inputRecords
            schema: '#ref'
        out:
          value:
            schema: '#ref'
  Load Data To Target:
    transactional: true
    actors:
      Update Table:
        parent: DbCommand
        in:
          interface:
            const: null
            link: Target Interface/value
          sql:
            const: null
            link: Build Update Statement/result
          batch:
            const: true
          __active_environment:
            const: target
            schema: string
            mandatory: false
          params:
            link:
              path: Input Records/value
              iterate: Iterate
      Count Records:
        parent: JavaScript
        in:
          script:
            const: |-
              var i = flowGlobals.recCount;
              var result = false;
              if (i == null) {
                  i = 0;
              }
              flowGlobals.recCount = ++i;
              if (i%commitSize === 0) {
                  result = true;
              }
              result;
          commitSize:
            external: commitSize
            schema: integer
            mandatory: false
        out:
          result:
            schema: boolean
      Count1:
        parent: Count
        out:
          value:
            schema: integer
  Stage To Commit every Commit Size:
    transactional: true
    dependsOn: Load Data To Target
    actors:
      Flush?:
        parent: Equals
        condition: result
        in:
          a:
            link: Count Records/result
            schema: boolean
          b:
            const: true
            schema: boolean
      DB Flush Batch:
        parent: TDMDbFlushBatch
        in:
          interface:
            const: null
            link: Target Interface/value
        out:
          tables:
            schema: '#ref'
    split: '--------------------'
  Do Nothing:
    else: true
    transactional: true
    dependsOn: Load Data To Target
  Update Progress:
    last: 1
    transactional: true
    dependsOn: Stage To Commit every Commit Size
    actors:
      Update task_ref_partition:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              update ${@TDMDB_SCHEMA}.task_ref_partition
               set number_of_processed_records=${number_of_processed_records}, number_of_failed_records = ${number_of_failed_records}
              where task_execution_id=${task_execution_id} AND task_ref_table_id=${task_ref_table_id}
               AND partition_no=${partition_no}
          TDMDB_SCHEMA:
            external: TDMDB_SCHEMA
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: task_execution_id
            schema: string
            mandatory: false
            createdBy: sql
          task_ref_table_id:
            external: task_ref_table_id
            schema: integer
            mandatory: false
            createdBy: sql
          partition_no:
            external: partition_no
            schema: string
            mandatory: false
            createdBy: sql
          number_of_processed_records:
            link: DB Flush Batch/total
            schema: integer
            mandatory: false
            createdBy: sql
          number_of_failed_records:
            link: DB Flush Batch/errors
            schema: integer
            mandatory: false
            createdBy: sql
    split: '--------------------'
  'Do Nothing ':
    last: 1
    transactional: true
    dependsOn: Do Nothing
  Return Current Count:
    transactional: true
    actors:
      DB Flush Batch At End:
        parent: TDMDbFlushBatch
        in:
          interface:
            const: null
            link: Target Interface/value
        out:
          tables:
            schema: '#ref'
          okay:
            external: okay
          total:
            external: total
          errors:
            external: errors
schemas:
  Table's fields Names .in.value:
    type: array
    items:
      type: string
  Table's fields Names .out.value:
    type: array
    items:
      type: string
  Where fields Names.in.value:
    type: array
    items:
      type: string
  Where fields Names.out.value:
    type: array
    items:
      type: string
  Build Update Statement.in.fields:
    type: array
    items:
      type: string
  Build Update Statement.in.whereFields:
    type: array
    items:
      type: string
  Input Records.in.value:
    type: array
    items: {
      }
  Input Records.out.value:
    type: array
    items:
      type: object
      properties:
        case_id:
          type: integer
        note_id:
          type: integer
        note_date:
          type: date
        note_text: {
          }
        k2key__note_text: {
          }
        k2key__note_id:
          type: integer
  DB Flush Batch.out.tables:
    type: object
    properties: {
      }
  DB Flush Batch At End.out.tables:
    type: object
    properties: {
      }
