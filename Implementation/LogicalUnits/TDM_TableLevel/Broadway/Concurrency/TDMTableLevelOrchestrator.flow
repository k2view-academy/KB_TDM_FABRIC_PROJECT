tags: Concurrency
stages:
  Initiate:
    actors:
      Get Start Time:
        parent: Now
      Logger:
        parent: Logger
        in:
          message:
            const: 'Starting TDMTableLevelOrchestrator for Table Instance: ${table}'
          level:
            const: info
          table:
            external: iid
            schema: string
            mandatory: false
      SplitIID:
        parent: InnerFlow
        in:
          flowName:
            const: SplitIID
          IID:
            external: iid
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          result:
            schema: '#ref'
      Initiate Entity Status:
        parent: FabricSet
        in:
          key:
            const: ENTITY_STATUS
            default: false
          value:
            const: completed
            default: false
      Set Lu Name:
        parent: FabricSet
        in:
          key:
            const: LU_TYPE
            default: false
          value:
            const: TDM_TableLevel
            default: false
      Set Root Lu Name:
        parent: FabricSet
        in:
          key:
            const: root_lu_name
            default: false
          value:
            const: TDM_TableLevel
            default: false
      set tables Lu Name:
        parent: FabricSet
        in:
          key:
            const: TABLES_LU_NAME
            default: false
          value:
            const: TDM_TableLevel
            external: luName
      'Get inplace masking ind ':
        parent: FabricSetRead
        in:
          key:
            const: IN_PLACE_MASKING_IND
            default: false
      Set Source Entity ID:
        parent: FabricSet
        in:
          key:
            const: SOURCE_ENTITY_ID
            default: false
          value:
            const: null
            external: iid
            default: false
  Get and Set Parameters:
    actors:
      Format Start Time:
        parent: DateFormat
        in:
          date:
            link: Get Start Time/date
      Get Executor Name:
        parent: FabricSetRead
        in:
          key:
            const: USER_NAME
            default: false
      Initiate Target Entity ID after IID Split:
        parent: FabricSet
        remark: The Target Entity ID should be initiated in case the flows fails during
          the next stage and before setting this ID as it is used in the Error handler
        in:
          key:
            const: TARGET_ENTITY_ID
            default: false
          value:
            const: null
            external: iid
            default: false
      Set root_iid:
        parent: FabricSet
        in:
          key:
            const: root_iid
            default: false
          value:
            const: null
            external: iid
            default: false
      GetTableInformation:
        parent: InnerFlow
        in:
          flowName:
            const: GetTableInformation
          interfaceName:
            link: SplitIID/result/interface
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            link: SplitIID/result/schema
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            link: SplitIID/result/table
            schema: string
            mandatory: false
            createdBy: flowName
          order:
            external: currentOrder
            schema: integer
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExeID
            schema: string
            mandatory: false
            createdBy: flowName
          isInPlaceMaskingTask:
            link: Get inplace masking ind /result
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          result:
            schema: '#ref'
      Get TDMDB Schema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
      Set Source Table Name:
        parent: FabricSet
        in:
          key:
            const: SOURCE_TABLE_NAME
            default: false
          value:
            const: null
            link: SplitIID/result/table
            default: false
  Set Source Environment:
    transactional: false
    actors:
      set Source Env:
        parent: InnerFlow
        in:
          flowName:
            const: setSourceEnv
      Update Table Status to Running:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              update ${@TDMDB_SCHEMA}.task_ref_exe_stats
              set execution_status = 'running',
              start_time = CURRENT_TIMESTAMP AT TIME ZONE 'UTC',
              updated_by = ${userName}
              where task_execution_id = ${taskExeId}
              and task_ref_table_id = ${tableRefId}
          userName:
            link: Get Executor Name/result
            schema: string
            mandatory: false
          taskExeId:
            link: SplitIID/result/execution_id
            schema: string
            mandatory: false
          TDMDB_SCHEMA:
            link:
            - path: GetTableInformation/result/TaskRefTables/task_ref_table_id
              iterate: First
            - Get TDMDB Schema/schema
            schema: string
            mandatory: false
          tableRefId:
            schema: integer
            mandatory: false
            createdBy: sql
      Set Start Processing Time:
        parent: FabricSet
        in:
          key:
            const: IID_START_DATETIME
            default: false
          value:
            const: null
            link: Format Start Time/string
            default: false
      Get Schema For Catalog:
        parent: InnerFlow
        in:
          flowName:
            const: GetSchemaForCatalog
          interface:
            link: SplitIID/result/interface
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          schema:
            link: SplitIID/result/schema
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          table:
            link: SplitIID/result/table
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          taskSchema:
            link: GetTableInformation/result/TaskRefTables/schema_name
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          result:
            schema: string
      Do Not Retain ?:
        parent: NotEquals
        in:
          b:
            const: 0
            schema: integer
          a:
            link: GetTableInformation/result/TaskInfo/retentionPeriodValue
      Sync Is OFF ?:
        parent: NotEquals
        in:
          b:
            const: 'OFF'
            schema: string
          a:
            external: syncMode
      Not:
        parent: Not
        in:
          value:
            link: Get inplace masking ind /result
      Parser the Filter Fields:
        parent: JsonParser
        in:
          stream:
            link:
              path: GetTableInformation/result/TaskRefTables/filter_fields
              iterate: First
        out:
          object:
            schema: '#ref'
  'Extract  ':
    transactional: false
    dependsOn: Set Source Environment
    actors:
      Extract Only Task?:
        parent: EqualsIgnoreCase
        condition: result
        in:
          a:
            external: taskType
            schema: string
          b:
            const: extract
            schema: string
      Update task_ref_partition:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              update ${@TDMDB_SCHEMA}.task_ref_partition
               set execution_status=${execution_status}
               where task_execution_id=${task_execution_id} AND task_ref_table_id=${task_ref_table_id}
               AND partition_no=${partition_no}
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: taskExeID
            schema: string
            mandatory: false
            createdBy: sql
          task_ref_table_id:
            link:
              path: GetTableInformation/result/TaskRefTables/task_ref_table_id
              iterate: First
            schema: string
            mandatory: false
            createdBy: sql
          partition_no:
            link: SplitIID/result/partition_no
            schema: string
            mandatory: false
            createdBy: sql
          execution_status:
            const: extracting
            schema: string
            mandatory: false
            createdBy: sql
    split: '--------------------'
  'Load  ':
    else: true
    transactional: false
    dependsOn: Set Source Environment
    actors:
      Update task_ref_partition11:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              update ${@TDMDB_SCHEMA}.task_ref_partition
               set execution_status=${execution_status},start_time=${start_time}
               where task_execution_id=${task_execution_id} AND task_ref_table_id=${task_ref_table_id}
               AND partition_no=${partition_no}
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: taskExeID
            schema: string
            mandatory: false
            createdBy: sql
          task_ref_table_id:
            link:
              path: GetTableInformation/result/TaskRefTables/task_ref_table_id
              iterate: First
            schema: string
            mandatory: false
            createdBy: sql
          partition_no:
            link: SplitIID/result/partition_no
            schema: string
            mandatory: false
            createdBy: sql
          execution_status:
            const: starting
            schema: string
            mandatory: false
            createdBy: sql
          start_time:
            link: Format Start Time/string
            schema: string
            mandatory: false
            createdBy: sql
  Get Source Data:
    actors:
      'Table Error Handler  ':
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: PopulatePartitionTableErrorsForTableLevel
                number_of_retries: ''
                retry_interval: ''
          tableName:
            link: SplitIID/result/table
            schema: string
            mandatory: false
          partitionNumber:
            link: SplitIID/result/partition_no
            schema: string
            mandatory: false
          refTableID:
            link:
              path: GetTableInformation/result/TaskRefTables/task_ref_table_id
              iterate: First
            schema: integer
            mandatory: false
      GetSourceDataPartition1:
        parent: InnerFlow
        in:
          flowName:
            const: GetSourceDataPartition
          innerFlowClose:
            const: false
          syncMode:
            external: syncMode
            schema: string
            mandatory: false
            createdBy: flowName
          taskExeId:
            link: SplitIID/result/execution_id
            schema: integer
            mandatory: false
            createdBy: flowName
          partitionNumber:
            link: SplitIID/result/partition_no
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceName:
            link: GetTableInformation/result/Definitions/interface_name
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          tableName:
            link: GetTableInformation/result/Definitions/table_name
            schema: string
            mandatory: false
            createdBy: flowName
          catalogSchema:
            link:
              path: Get Schema For Catalog/result
              iterate: First
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          tableFilter:
            link:
              path: GetTableInformation/result/TaskRefTables/table_filter
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          filterParameters:
            link:
              path: GetTableInformation/result/TaskRefTables/filter_parameters
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          filterParametersInfo:
            link: Parser the Filter Fields/object
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          filterGUI:
            link:
              path: GetTableInformation/result/TaskRefTables/gui_filter
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            link: SplitIID/result/schema
            schema: string
            mandatory: false
            createdBy: flowName
          sourceEnv:
            link: GetTableInformation/result/TaskInfo/sourceEnvName
            schema: string
            mandatory: false
            createdBy: flowName
          versionTaskExecutionId:
            link:
              path: GetTableInformation/result/TaskRefTables/version_task_execution_id
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          partitionNum:
            link: SplitIID/result/partition_no
            schema: string
            mandatory: false
            createdBy: flowName
          countIndicator:
            link:
              path: GetTableInformation/result/TaskRefTables/count_ind
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          countFlow:
            link: GetTableInformation/result/Definitions/record_count_flow
            schema: string
            mandatory: false
            createdBy: flowName
          tableRefID:
            link:
              path: GetTableInformation/result/TaskRefTables/task_ref_table_id
              iterate: First
            schema: integer
            mandatory: false
            createdBy: flowName
          inPlaceMasking:
            link: Get inplace masking ind /result
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          result:
            schema: '#ref'
  Load Flow:
    transactional: false
    actors:
      'Table Error Handler   ':
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: PopulatePartitionTableErrorsForTableLevel
                number_of_retries: ''
                retry_interval: ''
          tableName:
            link: SplitIID/result/table
            schema: string
            mandatory: false
          partitionNumber:
            link: SplitIID/result/partition_no
            schema: string
            mandatory: false
          refTableID:
            link:
              path: GetTableInformation/result/TaskRefTables/task_ref_table_id
              iterate: First
            schema: integer
            mandatory: false
      LoadMainFlow:
        parent: InnerFlow
        in:
          flowName:
            const: LoadMainFlow
          taskExeId:
            external: taskExeID
            schema: integer
            mandatory: false
            createdBy: flowName
          partitionNumber:
            link: SplitIID/result/partition_no
            schema: string
            mandatory: false
            createdBy: flowName
          sourceTableName:
            link: SplitIID/result/table
            schema: string
            mandatory: false
            createdBy: flowName
          sourceInterfaceName:
            link: SplitIID/result/interface
            schema: string
            mandatory: false
            createdBy: flowName
          sourceSchemaName:
            link: SplitIID/result/schema
            schema: string
            mandatory: false
            createdBy: flowName
          catalogSchema:
            link:
              path: Get Schema For Catalog/result
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          taskType:
            external: taskType
            schema: string
            mandatory: false
            createdBy: flowName
          commitSize:
            link: GetTableInformation/result/Definitions/commit_size
            schema: integer
            mandatory: false
            createdBy: flowName
          targetInterface:
            link: GetTableInformation/result/TargetInfo/target_interface_name
            schema: string
            mandatory: false
            createdBy: flowName
          targetSchema:
            link: GetTableInformation/result/TargetInfo/target_schema_name
            schema: string
            mandatory: false
            createdBy: flowName
          targetTable:
            link: GetTableInformation/result/TargetInfo/target_ref_table_name
            schema: string
            mandatory: false
            createdBy: flowName
          customLoadFlow:
            link: GetTableInformation/result/Definitions/load_flow
            schema: string
            mandatory: false
            createdBy: flowName
          tableRefId:
            link:
              path: GetTableInformation/result/TaskRefTables/task_ref_table_id
              iterate: First
            schema: integer
            mandatory: false
            createdBy: flowName
          retentionPeriodValue:
            link: GetTableInformation/result/TaskInfo/retentionPeriodValue
            schema: string
            mandatory: false
            createdBy: flowName
          syncMode:
            external: syncMode
            schema: string
            mandatory: false
            createdBy: flowName
          tableFilter:
            link:
              path: GetTableInformation/result/TaskRefTables/table_filter
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          filterParameters:
            link:
              path: GetTableInformation/result/TaskRefTables/filter_parameters
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          inputRecords:
            link: GetSourceDataPartition1/result
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          customUpdateFlow:
            link: GetTableInformation/result/Definitions/inplace_masking_update_flow
            schema: string
            mandatory: false
            createdBy: flowName
          inPlaceMasking:
            link: Get inplace masking ind /result
            schema: boolean
            mandatory: false
            createdBy: flowName
          IID:
            external: iid
            schema: string
            editor:
              id: com.k2view.strings
            mandatory: false
            createdBy: flowName
          luName:
            const: ''
            external: luName
            schema: string
            default: true
            mandatory: false
            createdBy: flowName
schemas:
  SplitIID.out.result:
    type: object
    properties:
      environment:
        type: string
      interface:
        type: string
      schema:
        type: string
      table:
        type: string
      execution_id:
        type: string
      partition_no:
        type: string
  GetTableInformation.out.result:
    type: object
    properties:
      TaskInfo:
        type: object
        properties:
          loadEntity:
            type: boolean
          retentionPeriodValue:
            type: integer
          targetEnvId:
            type: integer
          taskTitle:
            type: string
          sourceEnvName:
            type: string
          taskId:
            type: integer
          deleteBeforeLoad:
            type: boolean
          sourceEnvId:
            type: integer
      CalculatedOrder:
        type: integer
      TargetInfo:
        type: object
        properties:
          target_schema_name:
            type: string
          target_interface_name:
            type: string
          target_ref_table_name:
            type: string
      TaskRefTables:
        type: array
        items:
          type: object
          properties:
            version_task_name:
              type: string
            ref_table_name:
              type: string
            filter_parameters: {
              }
            interface_name:
              type: string
            task_id:
              type: integer
            schema_name:
              type: string
            source_max_no_of_workers: {
              }
            target_table_prefix: {
              }
            target_max_no_of_workers: {
              }
            update_date:
              type: date
            filter_fields: {
              }
            target_affinity: {
              }
            task_ref_table_id:
              type: integer
            source_affinity: {
              }
            filter_type: {
              }
            version_task_execution_id:
              type: integer
            lu_name:
              type: string
            target_table_suffix: {
              }
            count_ind: {
              }
            table_filter: {
              }
            gui_filter: {
              }
      Definitions:
        type: object
        properties:
          interface_name:
            type: string
          load_flow:
            type: string
          partition_count_source:
            type: string
          schema_name:
            type: string
          table_name:
            type: string
          extract_flow:
            type: string
          count_indicator:
            type: string
          record_count_flow:
            type: string
          table_order:
            type: string
          partition_records_flow:
            type: string
          commit_size:
            type: string
          inplace_masking_update_flow:
            type: string
          delete_flow:
            type: string
      PartitionFlowInputs:
        type: object
        properties: {
          }
  Parser the Filter Fields.out.object:
    type: array
    items:
      type: object
      properties:
        field_name:
          type: string
        field_type:
          type: string
        field_value:
          type: integer
  GetSourceDataPartition1.in.filterParametersInfo:
    type: array
    items: {
      }
  GetSourceDataPartition1.out.result:
    type: array
    items:
      type: object
      properties:
        contract_ref_id:
          type: integer
        offer_ref_id:
          type: integer
        offer_contract_description:
          type: string
  LoadMainFlow.in.inputRecords:
    type: array
    items:
      type: object
      properties:
        customer_id:
          type: integer
        ssn:
          type: string
        first_name:
          type: string
        last_name:
          type: string
        age:
          type: integer
        driver_type:
          type: string
        email:
          type: string
