tags: Partition
stages:
  'Check if to Update  ':
    actors:
      Get Mod of Current Count:
        parent: MathDivMod
        in:
          a:
            external: recordcount
            schema: integer
          b:
            external: commitSize
            schema: integer
  Update Table's Count:
    actors:
      Report Count?:
        parent: Equals
        condition: result
        in:
          a:
            link: Get Mod of Current Count/mod
            schema: integer
          b:
            const: 0
            schema: integer
      Update task_ref_partition:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              update ${@TDMDB_SCHEMA}.task_ref_partition
               set execution_status=${execution_status} , number_of_processed_records=${number_of_processed_records}
              where task_execution_id=${task_execution_id} AND task_ref_table_id=${task_ref_table_id}
               AND partition_no=${partition_no}
          TDMDB_SCHEMA:
            external: TDMDB_SCHEMA
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: task_execution_id
            schema: string
            mandatory: false
            createdBy: sql
          task_ref_table_id:
            external: task_ref_table_id
            schema: integer
            mandatory: false
            createdBy: sql
          partition_no:
            external: partition_no
            schema: string
            mandatory: false
            createdBy: sql
          execution_status:
            external: execution_status
            schema: string
            mandatory: false
            createdBy: sql
          number_of_processed_records:
            external: recordcount
            schema: any
            mandatory: false
            createdBy: sql
