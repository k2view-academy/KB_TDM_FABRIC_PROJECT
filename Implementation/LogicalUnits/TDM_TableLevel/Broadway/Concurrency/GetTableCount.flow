tags: Concurrency
stages:
  Get Order Calculation Info:
    actors:
      Get Table Information:
        parent: InnerFlow
        in:
          flowName:
            const: GetTableInformation
          interfaceName:
            external: sourceInterface
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            external: sourceSchema
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: flowName
          order:
            const: ''
            schema: integer
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
          isInPlaceMaskingTask:
            const: ''
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          result:
            schema: '#ref'
  Prepare Queries:
    actors:
      'Build Filter Queries ':
        parent: InnerFlow
        in:
          flowName:
            const: BuildFilterQueries
          sourceSchema:
            link: Get Table Information/result/SourceInfo/source_schema_name
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            link: Get Table Information/result/SourceInfo/source_ref_table_name
            schema: string
            mandatory: false
            createdBy: flowName
          tableFilter:
            link:
              path: Get Table Information/result/TaskRefTables/table_filter
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          filterParameters:
            link:
              path: Get Table Information/result/TaskRefTables/filter_parameters
              iterate: First
            schema: string
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
          sourceInterface:
            link: Get Table Information/result/SourceInfo/source_interface_name
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          countClause:
            schema: string
          filterClause:
            schema: string
          clauseParameters:
            schema: '#ref'
      Parser the Filter Fields:
        parent: JsonParser
        in:
          stream:
            link:
              path: Get Table Information/result/TaskRefTables/filter_fields
              iterate: First
        out:
          object:
            schema: '#ref'
  Custom Count Flow:
    dependsOn: Prepare Queries
    actors:
      Not Empty:
        parent: NotEquals
        condition: result
        in:
          a:
            link: Get Table Information/result/Definitions/record_count_flow
            schema: string
          b:
            const: ''
            schema: string
      Run Count Flow:
        parent: InnerFlow
        in:
          flowName:
            const: null
            link: Get Table Information/result/Definitions/record_count_flow
          innerFlowClose:
            const: false
          sourceInterface:
            link: Get Table Information/result/SourceInfo/source_interface_name
            schema: string
            mandatory: false
          sourceSchema:
            link: Get Table Information/result/SourceInfo/source_schema_name
            schema: string
            mandatory: false
          sourceTableName:
            link: Get Table Information/result/SourceInfo/source_ref_table_name
            schema: string
            mandatory: false
          whereClause:
            link:
              path: Get Table Information/result/TaskRefTables/table_filter
              iterate: First
            schema: string
            mandatory: false
          paramtersStr:
            link:
              path: Get Table Information/result/TaskRefTables/filter_parameters
              iterate: First
            schema: string
            mandatory: false
          countStatement:
            link: Build Filter Queries /countClause
            schema: string
            mandatory: false
          queryParameters:
            link: Build Filter Queries /clauseParameters
            schema: '#ref'
            mandatory: false
          filterParametersInfo:
            link: Parser the Filter Fields/object
            schema: string
            mandatory: false
          filterGUI:
            link:
              path: Get Table Information/result/TaskRefTables/gui_filter
              iterate: First
            schema: string
            mandatory: false
        out:
          tableCount:
            external: tableCount
            schema: integer
    split: '--------------------'
  'Sql Statements ':
    else: true
    dependsOn: Prepare Queries
    actors:
      Count Statement:
        parent: Const
        in:
          value:
            const: null
            link: Build Filter Queries /countClause
        out:
          value:
            schema: string
      Count Statement Parameters:
        parent: Const
        in:
          value:
            const: null
            link: Build Filter Queries /clauseParameters
  'Do Nothing ':
    dependsOn: Custom Count Flow
    split: '--------------------'
  Run Count Statement:
    dependsOn: 'Sql Statements '
    actors:
      Get Count:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: Get Table Information/result/SourceInfo/source_interface_name
          sql:
            const: null
            link: Count Statement/value
          params:
            link: Count Statement Parameters/value
        out:
          result:
            external: tableCount
            schema: integer
schemas:
  Get Table Information.out.result:
    type: object
    properties:
      TaskInfo:
        type: object
        properties:
          loadEntity:
            type: boolean
          retentionPeriodValue:
            type: integer
          targetEnvId:
            type: integer
          taskTitle:
            type: string
          sourceEnvName:
            type: string
          taskId:
            type: integer
          deleteBeforeLoad:
            type: boolean
          sourceEnvId:
            type: integer
      CalculatedOrder:
        type: integer
      TargetInfo:
        type: object
        properties:
          target_schema_name:
            type: string
          target_interface_name:
            type: string
          target_ref_table_name:
            type: string
      SourceInfo:
        type: object
        properties:
          source_schema_name:
            type: string
          source_ref_table_name:
            type: string
          source_interface_name:
            type: string
      TaskRefTables:
        type: array
        items:
          type: object
          properties:
            version_task_name:
              type: string
            ref_table_name:
              type: string
            filter_parameters: {
              }
            interface_name:
              type: string
            task_id:
              type: integer
            schema_name:
              type: string
            source_max_no_of_workers: {
              }
            target_table_prefix: {
              }
            target_max_no_of_workers: {
              }
            update_date:
              type: date
            filter_fields: {
              }
            target_affinity: {
              }
            task_ref_table_id:
              type: integer
            source_affinity: {
              }
            filter_type: {
              }
            version_task_execution_id:
              type: integer
            lu_name:
              type: string
            target_table_suffix: {
              }
            count_ind: {
              }
            table_filter: {
              }
            gui_filter: {
              }
      Definitions:
        type: object
        properties:
          interface_name:
            type: string
          load_flow:
            type: string
          partition_count_source:
            type: string
          schema_name:
            type: string
          table_name:
            type: string
          extract_flow:
            type: string
          count_indicator:
            type: string
          record_count_flow:
            type: string
          table_order:
            type: string
          partition_records_flow:
            type: string
          commit_size:
            type: string
          inplace_masking_update_flow:
            type: string
          delete_flow:
            type: string
      PartitionFlowInputs:
        type: object
        properties: {
          }
  Build Filter Queries .out.clauseParameters:
    type: array
    items:
      type: string
  Parser the Filter Fields.out.object:
    type: array
    items:
      type: object
      properties:
        field_name:
          type: string
        field_type:
          type: string
        field_value:
          type: integer
  Run Count Flow.in.queryParameters:
    type: array
    items:
      type: string
