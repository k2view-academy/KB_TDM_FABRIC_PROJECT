stages:
  inputs:
    actors:
      taskType:
        parent: Const
        in:
          value:
            const: null
            external: taskType
        out:
          value:
            schema: string
  if extract - get source:
    dependsOn: inputs
    actors:
      extract?:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: EXTRACT
            schema: string
          a:
            link: taskType/value
      get source envID:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: integer
            mandatory: false
            createdBy: functionName
          section:
            const: TaskInfo
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: sourceEnvId
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: any
      get task source affinity:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: integer
            mandatory: false
            createdBy: functionName
          section:
            const: TaskRefTables
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: source_affinity
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: any
      get task source maxWorkers:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: integer
            mandatory: false
            createdBy: functionName
          section:
            const: TaskRefTables
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: source_max_no_of_workers
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: any
    split: '--------------------'
  not extract - get target:
    else: true
    dependsOn: inputs
    actors:
      get target envID:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: integer
            mandatory: false
            createdBy: functionName
          section:
            const: TaskInfo
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: targetEnvId
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: integer
      get task target affinity:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: integer
            mandatory: false
            createdBy: functionName
          section:
            const: TaskRefTables
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: target_affinity
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: any
      get task target maxWorkers:
        parent: LuFunction
        in:
          functionName:
            const: fnGetCachedTableInfoBySection
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: functionName
          taskExecutionId:
            external: taskExecutionId
            schema: integer
            mandatory: false
            createdBy: functionName
          section:
            const: TaskRefTables
            schema: string
            mandatory: false
            createdBy: functionName
          attrName:
            const: target_max_no_of_workers
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: any
  call the main flow:
    actors:
      GetAffinityAndMaxWorker1:
        parent: InnerFlow
        in:
          flowName:
            const: GetAffinityAndMaxWorker
          taskAffinity:
            link:
            - get task source affinity/result
            - get task target affinity/result
            schema: any
            mandatory: false
            createdBy: flowName
          taskMaxWorkers:
            link:
            - get task source maxWorkers/result
            - get task target maxWorkers/result
            schema: any
            mandatory: false
            createdBy: flowName
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: flowName
          envId:
            link:
            - get source envID/result
            - get target envID/result
            schema: integer
            mandatory: false
            createdBy: flowName
        out:
          affinity:
            external: affinity
            schema: string
          maxWorkers:
            external: maxWorkers
            schema: string
