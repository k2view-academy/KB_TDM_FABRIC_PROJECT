tags: Concurrency
stages:
  Update Total:
    actors:
      getTDMDBSchema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
      Count:
        parent: Const
        in:
          value:
            const: null
            external: recCount
        out:
          value:
            schema: integer
  'Update Total ':
    actors:
      Update Table's Total Count:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              UPDATE ${@TDMDB_SCHEMA}.task_ref_partition
              SET number_of_records_to_process = ${recCount}
              WHERE task_execution_id = ${taskExeId}
              and task_ref_table_id = ${tableId} and partition_no = ${partitionNumber}
          taskExeId:
            external: taskExeId
            schema: integer
            mandatory: false
          tableId:
            external: tableId
            schema: integer
            mandatory: false
          recCount:
            link:
              path: Count/value
              iterate: First
            schema: integer
            mandatory: false
          TDMDB_SCHEMA:
            link: getTDMDBSchema/schema
            schema: string
            mandatory: false
          partitionNumber:
            external: partitionNumber
            schema: string
            mandatory: false
            createdBy: sql
