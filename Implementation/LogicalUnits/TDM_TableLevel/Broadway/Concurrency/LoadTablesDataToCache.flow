tags: Concurrency
stages:
  Get Order:
    actors:
      For Loop For Deleting Tables:
        parent: ForLoop
        in:
          from:
            const: 0
          to:
            external: maxOrder
  Sort By Interface:
    actors:
      Get Tables Of Order:
        parent: LuFunction
        in:
          functionName:
            const: getTablesByOrder
          order:
            link:
              path: For Loop For Deleting Tables/i
              iterate: Iterate
            schema: integer
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
  Get Array Of Info:
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: null
            link:
              path: Get Tables Of Order/result/tables_list
              iterate: Iterate
        out:
          value:
            schema: '#ref'
  Cache:
    last: 1
    actors:
      Table Error Handler No Fields Or No Key Fields:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: PopulateTableErrorsForTableLevel
                number_of_retries: ''
                retry_interval: ''
          tableName:
            external: tableName
            schema: string
            mandatory: false
      GetTableInformation:
        parent: InnerFlow
        in:
          flowName:
            const: GetTableInformation
          interfaceName:
            link:
              path: Const1/value/interface_name
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            link:
              path: Const1/value/schema_name
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            link:
              path: Const1/value/table_name
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
          order:
            link:
              path: For Loop For Deleting Tables/i
              iterate: Iterate
            schema: integer
            mandatory: false
            createdBy: flowName
          isInPlaceMaskingTask:
            external: isInPlaceMaskingTask
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          result:
            schema: '#ref'
  Close Inner Loop:
    last: 1
  Close Outer Loop: {
    }
schemas:
  Get Tables Of Order.out.result:
    type: array
    items:
      type: object
      properties:
        interface_name:
          type: string
        tables_list:
          type: array
          items:
            type: object
            properties:
              interface_name:
                type: string
              schema_name:
                type: string
              table_name:
                type: string
  Const1.out.value:
    type: object
    properties:
      interface_name:
        type: string
      schema_name:
        type: string
      table_name:
        type: string
  GetTableInformation.out.result:
    type: object
    properties:
      TaskInfo:
        type: object
        properties:
          loadEntity:
            type: boolean
          retentionPeriodValue:
            type: integer
          targetEnvId:
            type: integer
          taskTitle:
            type: string
          sourceEnvName:
            type: string
          taskId:
            type: integer
          deleteBeforeLoad:
            type: boolean
          sourceEnvId:
            type: integer
      CalculatedOrder:
        type: integer
      TargetInfo:
        type: object
        properties:
          target_schema_name:
            type: string
          target_interface_name:
            type: string
          target_ref_table_name:
            type: string
      TaskRefTables:
        type: array
        items:
          type: object
          properties:
            version_task_name:
              type: string
            ref_table_name:
              type: string
            filter_parameters: {
              }
            interface_name:
              type: string
            task_id:
              type: integer
            schema_name:
              type: string
            source_max_no_of_workers: {
              }
            target_table_prefix: {
              }
            target_max_no_of_workers: {
              }
            update_date:
              type: date
            filter_fields: {
              }
            target_affinity: {
              }
            task_ref_table_id:
              type: integer
            source_affinity: {
              }
            filter_type: {
              }
            version_task_execution_id:
              type: integer
            lu_name:
              type: string
            target_table_suffix: {
              }
            count_ind: {
              }
            table_filter: {
              }
            gui_filter: {
              }
      Definitions:
        type: object
        properties:
          interface_name:
            type: string
          load_flow:
            type: string
          partition_count_source:
            type: string
          schema_name:
            type: string
          table_name:
            type: string
          extract_flow:
            type: string
          count_indicator:
            type: string
          record_count_flow:
            type: string
          table_order:
            type: string
          partition_records_flow:
            type: string
          commit_size:
            type: string
          inplace_masking_update_flow:
            type: string
          delete_flow:
            type: string
      PartitionFlowInputs:
        type: object
        properties: {
          }
