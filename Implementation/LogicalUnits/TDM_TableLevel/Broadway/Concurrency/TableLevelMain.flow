tags: Concurrency
stages:
  Inputs:
    actors:
      deleteBeforeLoad:
        parent: Const
        in:
          value:
            const: null
            external: deleteBeforeLoad
            schema: string
        out:
          value:
            schema: string
      taskExecutionId:
        parent: Const
        in:
          value:
            const: null
            external: taskExecutionId
            schema: string
        out:
          value:
            schema: string
      syncMode:
        parent: Const
        in:
          value:
            const: null
            external: syncMode
            schema: string
        out:
          value:
            schema: string
      taskType:
        parent: Const
        in:
          value:
            const: null
            external: taskType
            schema: string
        out:
          value:
            schema: string
      tableLevelInd:
        parent: Const
        in:
          value:
            const: null
            external: tableLevelInd
            schema: string
        out:
          value:
            schema: string
      inPlaceMasking:
        parent: Const
        in:
          value:
            const: null
            external: inPlaceMaskingInd
            schema: boolean
        out:
          value:
            schema: boolean
      Set Source Entity ID:
        parent: FabricSet
        in:
          key:
            const: SOURCE_ENTITY_ID
            default: false
          value:
            const: ALL_TABLES
            default: false
      Initiate Target Entity ID after IID Split:
        parent: FabricSet
        remark: The Target Entity ID should be initiated in case the flows fails during
          the next stage and before setting this ID as it is used in the Error handler
        in:
          key:
            const: TARGET_ENTITY_ID
            default: false
          value:
            const: ALL_TABLES
            default: false
  Prepare Order of Tables:
    actors:
      Get Tables Order Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: false
                flowName: PopulateTableErrorsForTableLevel
                number_of_retries: ''
                retry_interval: ''
          tableName:
            const: ALL_TABLES
            schema: string
            mandatory: false
          refTableID:
            const: 0
            schema: integer
            mandatory: false
          interfaceName:
            const: ALL_INTERFACES
            schema: string
            mandatory: false
          schemaName:
            const: ALL_SCHEMAS
            schema: string
            mandatory: false
          executionAction:
            const: tableOrder
            schema: string
            mandatory: false
      Clear Tables' Orders Cache:
        parent: LuFunction
        height: 130
        in:
          functionName:
            const: tablesOrderCleanUp
      Get Source Environment:
        parent: FabricSetRead
        in:
          key:
            const: TDM_SOURCE_ENVIRONMENT_NAME
            default: false
      Prepare Tables' Order:
        parent: LuFunction
        in:
          functionName:
            const: prepareTablesOrder
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: functionName
          taskAction:
            external: taskType
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: integer
      Set IN_PLACE_MASKING_IND:
        parent: FabricSet
        in:
          key:
            const: IN_PLACE_MASKING_IND
            default: false
          value:
            const: 'false'
            link: inPlaceMasking/value
  In Case of InPlace Masking Set to the masking flag:
    dependsOn: Prepare Order of Tables
    actors:
      In Place Masking Task?:
        parent: Equals
        condition: result
        in:
          a:
            link: inPlaceMasking/value
            schema: string
          b:
            const: 'true'
            schema: string
      Set Masking Flag to true:
        parent: FabricSet
        in:
          key:
            const: enable_masking
            default: false
          value:
            const: 'true'
            default: false
    split: '--------------------'
  Not an InPlace Masking Task:
    else: true
    dependsOn: Prepare Order of Tables
  'Add ':
    actors:
      '+1':
        parent: MathAdd
        in:
          b:
            const: 1
          a:
            link: Prepare Tables' Order/result
  Load Tables Data To Cache:
    actors:
      Load Tables Data Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: false
                flowName: PopulateTableErrorsForTableLevel
                number_of_retries: ''
                retry_interval: ''
          tableName:
            const: ALL_TABLES
            schema: string
            mandatory: false
          refTableID:
            const: 0
            schema: integer
            mandatory: false
          interfaceName:
            const: ALL_INTERFACES
            schema: string
            mandatory: false
          schemaName:
            const: ALL_SCHEMAS
            schema: string
            mandatory: false
          executionAction:
            const: loadInfo
            schema: string
            mandatory: false
      LoadTables Data To Cache:
        parent: InnerFlow
        in:
          flowName:
            const: LoadTablesDataToCache
          maxOrder:
            link: +1/result
            schema: integer
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
          isInPlaceMaskingTask:
            link: inPlaceMasking/value
            schema: string
            mandatory: false
            createdBy: flowName
  Run Count For Supporting Tables:
    actors:
      Count Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Count Main Flow:
        parent: InnerFlow
        in:
          flowName:
            const: CountMainFlow
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
          maxOrder:
            link: +1/result
            schema: integer
            mandatory: false
            createdBy: flowName
          sourceEnv:
            link: Get Source Environment/result
            schema: string
            mandatory: false
            createdBy: flowName
  Merge: {
    }
  If Delete is Requested:
    dependsOn: Merge
    actors:
      Delete is Requested?:
        parent: EqualsIgnoreCase
        condition: result
        in:
          a:
            link: deleteBeforeLoad/value
            schema: string
          b:
            const: 'true'
            schema: string
      Delete Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Delete Main Flow:
        parent: InnerFlow
        in:
          flowName:
            const: DeleteMainFlow
          maxOrder:
            link: Prepare Tables' Order/result
            schema: integer
            mandatory: false
            createdBy: flowName
          sourceEnv:
            link: Get Source Environment/result
            schema: string
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
    split: '--------------------'
  No Deletion:
    else: true
    dependsOn: Merge
  Extract & Load:
    actors:
      Extarct And Load Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Extract And Load Main Flow:
        parent: InnerFlow
        in:
          flowName:
            const: ExtractAndLoadMainFlow
          maxOrder:
            link: +1/result
            schema: integer
            mandatory: false
            createdBy: flowName
          syncMode:
            link: syncMode/value
            schema: string
            mandatory: false
            createdBy: flowName
          taskType:
            link: taskType/value
            schema: string
            mandatory: false
            createdBy: flowName
          taskExeID:
            link: taskExecutionId/value
            schema: string
            mandatory: false
            createdBy: flowName
  Clear the cache:
    actors:
      set CLUSTER_DISTRIBUTE_AFFINITY to all:
        parent: FabricSet
        in:
          key:
            const: CLUSTER_DISTRIBUTE_AFFINITY
          value:
            const: ALL
      DbCommand1:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: broadway TDM_TableLevel.ClearCache taskExecutionId = ${taskExecutionId}
          taskExecutionId:
            external: taskExecutionId
            schema: any
            mandatory: false
            createdBy: sql
