tags: Concurrency
stages:
  Inputs:
    actors:
      deleteBeforeLoad:
        parent: Const
        in:
          value:
            const: null
            external: deleteBeforeLoad
            schema: string
        out:
          value:
            schema: string
      taskExecutionId:
        parent: Const
        in:
          value:
            const: null
            external: taskExecutionId
            schema: string
        out:
          value:
            schema: string
      syncMode:
        parent: Const
        in:
          value:
            const: null
            external: syncMode
            schema: string
        out:
          value:
            schema: string
      taskType:
        parent: Const
        in:
          value:
            const: null
            external: taskType
            schema: string
        out:
          value:
            schema: string
      tableLevelInd:
        parent: Const
        in:
          value:
            const: null
            external: tableLevelInd
            schema: string
        out:
          value:
            schema: string
      inPlaceMasking:
        parent: Const
        in:
          value:
            const: null
            external: inPlaceMaskingInd
            schema: boolean
        out:
          value:
            schema: boolean
      Get Source Environment:
        parent: FabricSetRead
        in:
          key:
            const: TDM_SOURCE_ENVIRONMENT_NAME
            default: false
      Set Source Entity ID:
        parent: FabricSet
        in:
          key:
            const: SOURCE_ENTITY_ID
            default: false
          value:
            const: ALL_TABLES
            default: false
      Initiate Target Entity ID after IID Split:
        parent: FabricSet
        remark: The Target Entity ID should be initiated in case the flows fails during
          the next stage and before setting this ID as it is used in the Error handler
        in:
          key:
            const: TARGET_ENTITY_ID
            default: false
          value:
            const: ALL_TABLES
            default: false
  Prepare Order of Tables:
    actors:
      Get Tables Order Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: false
                flowName: PopulateTableErrorsForTableLevel
                number_of_retries: ''
                retry_interval: ''
          tableName:
            const: ALL_TABLES
            schema: string
            mandatory: false
          refTableID:
            schema: integer
            mandatory: false
          interfaceName:
            const: ALL_INTERFACES
            schema: string
            mandatory: false
          schemaName:
            const: ALL_SCHEMAS
            schema: string
            mandatory: false
          executionAction:
            const: tableOrder
            schema: string
            mandatory: false
      Clear Tables' Orders Cache:
        parent: LuFunction
        in:
          functionName:
            const: tablesOrderCleanUp
      Prepare Tables' Order:
        parent: LuFunction
        in:
          functionName:
            const: prepareTablesOrder
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: functionName
          taskAction:
            external: taskType
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: integer
      Set Source Env:
        parent: FabricSet
        in:
          key:
            const: environment
            default: false
          value:
            const: null
            link: Get Source Environment/result
            default: false
      Set IN_PLACE_MASKING_IND:
        parent: FabricSet
        height: 131
        in:
          key:
            const: IN_PLACE_MASKING_IND
            default: false
          value:
            const: 'false'
            link: inPlaceMasking/value
  In Case of InPlace Masking Set to the masking flag:
    dependsOn: Prepare Order of Tables
    actors:
      In Place Masking Task?:
        parent: Equals
        condition: result
        in:
          a:
            link: inPlaceMasking/value
            schema: string
          b:
            const: 'true'
            schema: string
      Set Masking Flag to true:
        parent: FabricSet
        in:
          key:
            const: enable_masking
            default: false
          value:
            const: 'true'
            default: false
    split: '--------------------'
  Not an InPlace Masking Task:
    else: true
    dependsOn: Prepare Order of Tables
  'Add ':
    actors:
      '+1':
        parent: MathAdd
        in:
          b:
            const: 1
          a:
            link: Prepare Tables' Order/result
  Load Tables Data To Cache:
    actors:
      Load Tables Data Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: false
                flowName: PopulateTableErrorsForTableLevel
                number_of_retries: ''
                retry_interval: ''
          tableName:
            const: ALL_TABLES
            schema: string
            mandatory: false
          refTableID:
            schema: integer
            mandatory: false
          interfaceName:
            const: ALL_INTERFACES
            schema: string
            mandatory: false
          schemaName:
            const: ALL_SCHEMAS
            schema: string
            mandatory: false
          executionAction:
            const: loadInfo
            schema: string
            mandatory: false
      LoadTables Data To Cache:
        parent: InnerFlow
        in:
          flowName:
            const: LoadTablesDataToCache
          maxOrder:
            link: +1/result
            schema: integer
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
          isInPlaceMaskingTask:
            link: inPlaceMasking/value
            schema: string
            mandatory: false
            createdBy: flowName
  Run Count For Supporting Tables:
    actors:
      Count Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Count Main Flow:
        parent: InnerFlow
        in:
          flowName:
            const: CountMainFlow
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
          maxOrder:
            link: +1/result
            schema: integer
            mandatory: false
            createdBy: flowName
          sourceEnv:
            link: Get Source Environment/result
            schema: string
            mandatory: false
            createdBy: flowName
      Get TDMDB Schema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
      Get Max Order for Delete:
        parent: LuFunction
        in:
          functionName:
            const: getMaxOrder
          executionAction:
            const: Delete
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: integer
  Merge:
    actors:
      Get Run Type:
        parent: DbFetchField
        in:
          interface:
            const: TDM
          sql:
            const: |-
              SELECT CASE
                  WHEN EXISTS (
                      SELECT 1
                      FROM ${@schema}.task_execution_list
                      WHERE task_execution_id = ${task_execution_id}
                        AND run_type <> 'new'
                  )
                  THEN 'rerun'
                  ELSE 'new'
              END AS run_type
          schema:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: string
      +1 For Delete:
        parent: MathAdd
        in:
          b:
            const: 1
          a:
            link: Get Max Order for Delete/result
  If Delete is Requested:
    dependsOn: Merge
    actors:
      Delete is Requested?:
        parent: EqualsIgnoreCase
        condition: result
        in:
          a:
            link: deleteBeforeLoad/value
            schema: string
          b:
            const: 'true'
            schema: string
      Delete Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Delete Main Flow:
        parent: InnerFlow
        in:
          flowName:
            const: DeleteMainFlow
          maxOrder:
            link: +1 For Delete/result
            schema: integer
            mandatory: false
            createdBy: flowName
          sourceEnv:
            link: Get Source Environment/result
            schema: string
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: flowName
    split: '--------------------'
  No Deletion:
    else: true
    dependsOn: Merge
  Extract & Load:
    actors:
      Extarct And Load Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Extract And Load Main Flow:
        parent: InnerFlow
        in:
          flowName:
            const: ExtractAndLoadMainFlow
          maxOrder:
            link: +1/result
            schema: integer
            mandatory: false
            createdBy: flowName
          syncMode:
            link: syncMode/value
            schema: string
            mandatory: false
            createdBy: flowName
          taskType:
            link: taskType/value
            schema: string
            mandatory: false
            createdBy: flowName
          taskExeID:
            link: taskExecutionId/value
            schema: string
            mandatory: false
            createdBy: flowName
  Clear the cache:
    actors:
      Check if Task Has Failed Partitions:
        parent: DbFetchField
        in:
          interface:
            const: TDM
          sql:
            const: |-
              SELECT COUNT(1) AS CNT
              FROM ${@schema}.task_ref_exe_stats s
              WHERE task_execution_id = ${task_execution_id}
              AND (execution_status = 'failed' OR (execution_status = 'completed' AND EXISTS
                  (SELECT 1 FROM ${@schema}.task_ref_partition p WHERE p.task_execution_id = ${task_execution_id} and p.execution_status = 'failed')))
          schema:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: integer
      Run Clear cashe on all nodes:
        parent: FabricSet
        in:
          key:
            const: CLUSTER_DISTRIBUTE_AFFINITY
            default: false
          value:
            const: ALL
            default: false
      Clear Cache:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: broadway TDM_TableLevel.ClearCache taskExecutionId = ${taskExecutionId}
          taskExecutionId:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Fail Main Batch if Task has Failed Partitions:
    dependsOn: Clear the cache
    actors:
      Task Had Failed Partitions?:
        parent: GreaterThan
        condition: result
        in:
          b:
            const: 0
          a:
            link: Check if Task Has Failed Partitions/result
      Fail Task To Allow Rerun:
        parent: Fail
        in:
          message:
            const: Task has Failed Partitions
    split: '--------------------'
  No Failed Partitions:
    else: true
    dependsOn: Clear the cache
    actors:
      Check If Task is Stopped:
        parent: DbFetchField
        in:
          interface:
            const: TDM
          sql:
            const: |-
              SELECT COUNT(1) CNT
              FROM ${@schema}.task_ref_exe_stats
              WHERE task_execution_id = ${task_execution_id}
              AND execution_status = 'stopped'
          schema:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: taskExecutionId
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: integer
  Do Nothing:
    dependsOn: Fail Main Batch if Task has Failed Partitions
    split: '--------------------'
  Fail Main Batch if Task is Stopped:
    dependsOn: No Failed Partitions
    actors:
      Task Stopped?:
        parent: GreaterThan
        condition: result
        in:
          b:
            const: 0
          a:
            link: Check If Task is Stopped/result
      Fail Task:
        parent: Fail
        in:
          message:
            const: Task is Stopped!
schemas:
  Clear Cache.out.result:
    type: array
    items:
      type: object
      properties:
        Node:
          type: string
        Status:
          type: string
        Value:
          type: string
