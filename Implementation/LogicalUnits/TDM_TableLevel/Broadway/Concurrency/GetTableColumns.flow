tags: Concurrency
stages:
  Get Table's Fields:
    actors:
      Get List of Table's Fields:
        parent: LuFunction
        in:
          functionName:
            const: fnGetTableFields
          dbInterfaceName:
            external: sourceInterfaceName
            schema: string
            mandatory: false
          tableName:
            external: sourceTableName
            schema: string
            mandatory: false
          schemaName:
            external: sourceSchemaName
            schema: string
            mandatory: false
          catalogSchema:
            external: catalogSchema
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  Remove Escaping Chars:
    actors:
      Remove escaping chars:
        parent: Replace
        in:
          search:
            const: '"'
          string:
            link:
              path: Get List of Table's Fields/result/column_name
              iterate: Iterate
  List of Fields:
    last: 1
    actors:
      Build Array of Fields:
        parent: ArrayBuilder
        in:
          input:
            link:
              path: Remove escaping chars/string
              pos: 0
        out:
          array:
            schema: '#ref'
  Sort Script:
    actors:
      JavaScript:
        parent: JavaScript
        in:
          script:
            const: |
              function sortFieldsBySample(fields, sample) {
                var result = [];
                var used = {};

                for (var key in sample) {
                  for (var i = 0; i < fields.length; i++) {
                    if (fields[i] === key) {
                      result.push(fields[i]);
                      used[fields[i]] = true;
                      break;
                    }
                  }
                }

                for (var j = 0; j < fields.length; j++) {
                  if (!used[fields[j]]) {
                    result.push(fields[j]);
                  }
                }

                return result;
              }

              var fields = input;
              var sample = data;

              var sorted = sortFieldsBySample(fields, sample);
              sorted;
          input:
            link: Build Array of Fields/array
            schema: '#ref'
            mandatory: false
          data:
            external: dataSample
            schema: '#ref'
            mandatory: false
        out:
          result:
            external: result
            schema: '#ref'
schemas:
  Get List of Table's Fields.out.result:
    type: array
    items:
      type: object
      properties:
        column_name:
          type: string
        column_type:
          type: string
        column_sqlite_type:
          type: string
  Build Array of Fields.out.array:
    type: array
    items:
      type: string
  JavaScript.in.input:
    type: array
    items:
      type: string
  JavaScript.in.data:
    type: object
    properties:
      customer_id:
        type: integer
      ssn:
        type: string
      first_name:
        type: string
      last_name:
        type: string
      age:
        type: integer
      driver_type:
        type: string
      email:
        type: string
  JavaScript.out.result:
    type: array
    items:
      type: string
