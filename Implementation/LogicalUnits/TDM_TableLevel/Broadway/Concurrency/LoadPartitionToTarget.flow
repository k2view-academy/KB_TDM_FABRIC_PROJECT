tags: Partition,Concurrency
stages:
  Set Target Env:
    actors:
      Set Target Entity ID:
        parent: FabricSet
        in:
          key:
            const: TARGET_ENTITY_ID
            default: false
          value:
            const: null
            external: targetTable
            default: false
      Get TDMDB Schema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
  Load To Target:
    actors:
      Error Handler - Loading To Target:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Custom Load Flow:
        parent: Const
        in:
          value:
            const: null
            external: customLoadFlow
        out:
          value:
            schema: string
      Update task_ref_partition - Loading To Target:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              update ${@TDMDB_SCHEMA}.task_ref_partition
               set execution_status=${execution_status}
              where task_execution_id=${task_execution_id} AND task_ref_table_id=${task_ref_table_id}
               AND partition_no=${partition_no}
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: taskExeId
            schema: string
            mandatory: false
            createdBy: sql
          task_ref_table_id:
            external: refTableID
            schema: integer
            mandatory: false
            createdBy: sql
          partition_no:
            external: partitionNumber
            schema: string
            mandatory: false
            createdBy: sql
          execution_status:
            const: loading to target
            schema: string
            mandatory: false
            createdBy: sql
      Get Table's Fields:
        parent: InnerFlow
        in:
          flowName:
            const: GetTableColumns
          sourceInterfaceName:
            external: sourceInterfaceName
            schema: string
            mandatory: false
            createdBy: flowName
          sourceTableName:
            external: sourceTableName
            schema: string
            mandatory: false
            createdBy: flowName
          sourceSchemaName:
            external: sourceSchemaName
            schema: string
            mandatory: false
            createdBy: flowName
          catalogSchema:
            external: catalogSchema
            schema: string
            mandatory: false
            createdBy: flowName
          dataSample:
            schema: '#ref'
            mandatory: false
            createdBy: flowName
        out:
          result:
            schema: '#ref'
      Set Target Environment:
        parent: InnerFlow
        in:
          flowName:
            const: setTargetEnv
  Default Flow:
    transactional: false
    dependsOn: Load To Target
    actors:
      No Custom Load Flow?:
        parent: Equals
        condition: result
        in:
          a:
            link: Custom Load Flow/value
            schema: string
          b:
            const: ''
            schema: string
      Error Handler - load Table By Query:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      load Table By Query:
        parent: InnerFlow
        in:
          flowName:
            const: LoadTableByQuery
          targetInterface:
            external: targetInterface
            schema: string
            mandatory: false
          targetSchema:
            external: targetSchema
            schema: string
            mandatory: false
          targetTable:
            external: targetTable
            schema: string
            mandatory: false
          inputRecords:
            external: inputRecords
            schema: '#ref'
            mandatory: false
          fieldsArray:
            link: Get Table's Fields/result
            schema: '#ref'
            mandatory: false
          task_execution_id:
            external: taskExeId
            schema: string
            mandatory: false
            createdBy: flowName
          task_ref_table_id:
            external: refTableID
            schema: integer
            mandatory: false
            createdBy: flowName
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: flowName
          partition_no:
            external: partitionNumber
            schema: string
            mandatory: false
            createdBy: flowName
          commitSize:
            external: commitSize
            schema: integer
            mandatory: false
            createdBy: flowName
        out:
          okay:
            schema: number
          total:
            schema: number
          errors:
            schema: number
    split: '--------------------'
  'Custom Load Flow ':
    else: true
    transactional: false
    dependsOn: Load To Target
    actors:
      Error Handler - Custom Load Flow:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Run Custom Load Flow:
        parent: InnerFlow
        in:
          flowName:
            const: null
            link: Custom Load Flow/value
          targetInterface:
            external: targetInterface
            schema: string
            mandatory: false
          targetSchema:
            external: targetSchema
            schema: string
            mandatory: false
          targetTable:
            external: targetTable
            schema: string
            mandatory: false
          inputRecords:
            external: inputRecords
            schema: '#ref'
            mandatory: false
          fieldsArray:
            link: Get Table's Fields/result
            schema: '#ref'
            mandatory: false
          commitSize:
            external: commitSize
            schema: integer
            mandatory: false
        out:
          okay:
            schema: integer
          total:
            schema: integer
          errors:
            schema: integer
  Records Count:
    transactional: false
    actors:
      Total:
        parent: Const
        in:
          value:
            const: null
            link:
            - load Table By Query/total
            - Run Custom Load Flow/total
        out:
          value:
            schema: integer
      Processed:
        parent: Const
        height: 97
        in:
          value:
            const: null
            link:
            - load Table By Query/okay
            - Run Custom Load Flow/okay
            schema: integer
        out:
          value:
            schema: integer
      Got Errors Count?:
        parent: IfElse
        height: 326
        in:
          a:
            link:
            - load Table By Query/errors
            - Run Custom Load Flow/errors
            schema: integer
          b:
            const: 0
            schema: integer
          test:
            link:
            - load Table By Query/errors
            - Run Custom Load Flow/errors
        out:
          result:
            schema: integer
  'Update Processed Count ':
    dependsOn: Records Count
    actors:
      Update Count?:
        parent: NotEquals
        condition: result
        in:
          a:
            link: Total/value
            schema: integer
          b:
            const: -1
            schema: integer
      Error Handler - Status And Counts:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Update task_ref_partition - Status And Counts:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              update ${@TDMDB_SCHEMA}.task_ref_partition
               set number_of_processed_records=${number_of_processed_records},
                  number_of_failed_records = ${number_of_failed_records}, end_time=NOW(),
                  execution_status= CASE
                      WHEN ${number_of_failed_records} > 0 THEN 'failed'
                      ELSE 'completed' END,
                  number_of_records_to_process = case
                      when number_of_records_to_process = -1 then ${number_of_records_to_process} else number_of_records_to_process end
              where task_execution_id=${task_execution_id} AND task_ref_table_id=${task_ref_table_id}
               AND partition_no=${partition_no}
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: taskExeId
            schema: string
            mandatory: false
            createdBy: sql
          task_ref_table_id:
            external: refTableID
            schema: integer
            mandatory: false
            createdBy: sql
          partition_no:
            external: partitionNumber
            schema: string
            mandatory: false
            createdBy: sql
          number_of_processed_records:
            link: Processed/value
            schema: integer
            mandatory: false
            createdBy: sql
          number_of_failed_records:
            link: Got Errors Count?/result
            schema: integer
            mandatory: false
            createdBy: sql
          number_of_records_to_process:
            link: Total/value
            schema: integer
            mandatory: false
            createdBy: sql
    split: '--------------------'
  No Count Done:
    else: true
    dependsOn: Records Count
    actors:
      Error Handler - Status Only:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Update task_ref_partition - Status Only:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              update ${@TDMDB_SCHEMA}.task_ref_partition
               set execution_status=${execution_status}, end_time=NOW()
              where task_execution_id=${task_execution_id} AND task_ref_table_id=${task_ref_table_id}
               AND partition_no=${partition_no}
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: taskExeId
            schema: string
            mandatory: false
            createdBy: sql
          task_ref_table_id:
            external: refTableID
            schema: integer
            mandatory: false
            createdBy: sql
          partition_no:
            external: partitionNumber
            schema: string
            mandatory: false
            createdBy: sql
          execution_status:
            const: completed
            schema: string
            mandatory: false
            createdBy: sql
  Update Status:
    actors:
      Update task_ref_partition:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              UPDATE ${@TDMDB_SCHEMA}.task_ref_partition
               SET execution_status='completed',
               number_of_processed_records = number_of_records_to_process ,
               number_of_failed_records = 0, end_time = NOW()
               WHERE task_execution_id=${task_execution_id}
               AND task_ref_table_id  = ${task_ref_table_id}
               AND partition_no = ${partition_no}
               AND execution_status NOT IN ('stopped', 'failed', 'completed');
          TDMDB_SCHEMA:
            link: Get TDMDB Schema/schema
            schema: string
            mandatory: false
            createdBy: sql
          task_execution_id:
            external: taskExeId
            schema: string
            mandatory: false
            createdBy: sql
          task_ref_table_id:
            external: refTableID
            schema: integer
            mandatory: false
            createdBy: sql
          partition_no:
            external: partitionNumber
            schema: string
            mandatory: false
            createdBy: sql
  Return Number of Errors:
    actors:
      Number Of Errors:
        parent: Const
        in:
          value:
            const: null
            link: Got Errors Count?/result
            schema: integer
        out:
          value:
            external: errors
            schema: integer
schemas:
  Get Table's Fields.in.dataSample:
    type: object
    properties:
      customer_id:
        type: integer
      ssn:
        type: string
      first_name:
        type: string
      last_name:
        type: string
      age:
        type: integer
      driver_type:
        type: string
      email:
        type: string
  Get Table's Fields.out.result:
    type: array
    items:
      type: string
  load Table By Query.in.inputRecords:
    type: array
    items: {
      }
  load Table By Query.in.fieldsArray:
    type: array
    items:
      type: string
  Run Custom Load Flow.in.inputRecords:
    type: array
    items: {
      }
  Run Custom Load Flow.in.fieldsArray:
    type: array
    items:
      type: string
