tags: Concurrency
stages:
  Table's Number of Partitions:
    actors:
      Get Number Of Partitions:
        parent: DbFetchField
        in:
          interface:
            const: TDM
          sql:
            const: |-
              SELECT number_of_partitions + 1 as number_of_partitions
              FROM ${@schema}.task_ref_exe_stats
              WHERE task_execution_id = ${taskExecutionId}
              AND ref_table_name = ${tableName}
              AND schema_name = ${schemaName}
              AND interface_name = ${interfaceName}
          schema:
            external: TDMDB_SCHEMA
            schema: string
            mandatory: false
            createdBy: sql
          taskExecutionId:
            external: taskExecutionId
            schema: integer
            mandatory: false
            createdBy: sql
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: sql
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: sql
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: sql
  Loop Over Partitions:
    actors:
      Loop:
        parent: ForLoop
        in:
          from:
            const: 1
          to:
            link: Get Number Of Partitions/result
      Initiate Total:
        parent: JavaScript
        in:
          script:
            const: flowArgs.total = 0;
  Create IID:
    actors:
      Build IID:
        parent: InnerFlow
        in:
          flowName:
            const: BuildIID
          sourceEnv:
            external: sourceEnv
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            external: taskExecutionId
            schema: integer
            mandatory: false
            createdBy: flowName
          partitionNum:
            link:
              path: Loop/i
              iterate: Iterate
            schema: integer
            mandatory: false
            createdBy: flowName
        out:
          iid:
            schema: string
      Handle Special Chars in Table Name:
        parent: JavaScript
        in:
          script:
            const: |-
              var result = tableName.replace(/^"|"$/g, '');
              result = '\"__t_' + result + '\"';
              result;
          tableName:
            external: tableName
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Get SnapshotIID:
    actors:
      Build Count Statement:
        parent: StringFormat
        in:
          format:
            const: /*sqlite*/ select count(*) from TDM_TableLevel.${tableName}
          tableName:
            link: Handle Special Chars in Table Name/result
            schema: string
            mandatory: false
      FabricGet:
        parent: FabricGet
        in:
          luType:
            const: TDM_TableLevel
          iid:
            const: null
            link:
              path: Build IID/iid
              pos: 0
            default: false
          syncMode:
            const: 'OFF'
  'Get SnapshotIID  ':
    dependsOn: Get SnapshotIID
    actors:
      Table should be filtered?:
        parent: NotNull
        condition: result
        in:
          value:
            external: tableFilter
            schema: string
      Add  Wherer Clause to Count Statement:
        parent: InnerFlow
        in:
          flowName:
            const: BuildTableFilter
          selectClause:
            link: Build Count Statement/string
            schema: string
            mandatory: false
          tableFilter:
            external: tableFilter
            schema: string
            mandatory: false
          filterParameters:
            external: filterParameters
            schema: string
            mandatory: false
        out:
          selectStatement:
            schema: string
          paramters:
            schema: '#ref'
    split: '--------------------'
  No Filter:
    else: true
    dependsOn: Get SnapshotIID
    actors:
      Select Count:
        parent: Const
        in:
          value:
            const: null
            link: Build Count Statement/string
            schema: string
        out:
          value:
            schema: string
  Get Count:
    actors:
      'Table Error Handler  ':
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: PopulatePartitionTableErrorsForTableLevel
                number_of_retries: ''
                retry_interval: ''
          tableName:
            external: tableName
            schema: string
            mandatory: false
          partitionNumber:
            link:
              path: Loop/i
              iterate: Iterate
            schema: integer
            mandatory: false
          refTableID:
            external: tableRefID
            schema: integer
            mandatory: false
      Get Table  Count:
        parent: DbFetchField
        in:
          interface:
            const: fabric
          sql:
            const: null
            link:
            - Add  Wherer Clause to Count Statement/selectStatement
            - Select Count/value
          params:
            link: Add  Wherer Clause to Count Statement/paramters
        out:
          result:
            schema: integer
  Release:
    last: 1
    actors:
      Release Instance:
        parent: FabricRelease
        in:
          luType:
            const: TDM_TableLevel
      Aggregate Count:
        parent: JavaScript
        in:
          script:
            const: flowArgs.total += tableCount;
          tableCount:
            link: Get Table  Count/result
            schema: integer
            mandatory: false
        out:
          result:
            schema: integer
  Return Count:
    actors:
      Total Count:
        parent: Const
        in:
          value:
            const: null
            link: Aggregate Count/result
            schema: integer
        out:
          value:
            external: result
            schema: integer
schemas:
  Add  Wherer Clause to Count Statement.out.paramters:
    type: array
    items:
      type: string
