stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          ref_instance_id:
            external: ref_instance_id
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
      SyncDeleteMode:
        parent: SyncDeleteMode
        in:
          interface:
            schema: any
          table:
            const: null
            external: table
  Split IID:
    actors:
      SplitIID:
        parent: InnerFlow
        in:
          flowName:
            const: SplitIID
          IID:
            link: PopulationArgs/iid
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          result:
            schema: '#ref'
  Get Table's Info:
    actors:
      GetTableInformation:
        parent: InnerFlow
        in:
          flowName:
            const: GetTableInformation
          interfaceName:
            link: SplitIID/result/interface
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            link: SplitIID/result/schema
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            link: SplitIID/result/table
            schema: string
            mandatory: false
            createdBy: flowName
          order:
            schema: any
            mandatory: false
            createdBy: flowName
          taskExecutionId:
            link: SplitIID/result/execution_id
            schema: string
            mandatory: false
            createdBy: flowName
          isInPlaceMaskingTask:
            schema: any
            mandatory: false
            createdBy: flowName
        out:
          result:
            schema: '#ref'
  Insert:
    transactional: false
    actors:
      TDM_REF_ROOT:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
            - ref_instance_id
            - ref_table_id
            - ref_table_name
            - source_env
            - task_execution_id
            - task_id
            - retention
            - interface_name
            - schema_name
            - filter_type
            - table_filter
            - filter_parameters
            - target_interface
            - target_schema
            - target_table_name
            - gui_filter
          dialect:
            const: sqlite
          ref_instance_id:
            link: PopulationArgs/iid
            schema: string
          ref_table_id:
            link:
              path: GetTableInformation/result/TaskRefTables/task_ref_table_id
              iterate: First
            schema: string
          ref_table_name:
            link:
              path: GetTableInformation/result/TaskRefTables/ref_table_name
              iterate: First
            schema: string
          source_env:
            link: GetTableInformation/result/TaskInfo/sourceEnvName
            schema: string
          task_execution_id:
            link: SplitIID/result/execution_id
            schema: string
          task_id:
            link: GetTableInformation/result/TaskInfo/taskId
            schema: integer
          retention:
            link: GetTableInformation/result/TaskInfo/retentionPeriodValue
            schema: integer
            mandatory: false
          interface_name:
            link:
              path: GetTableInformation/result/TaskRefTables/interface_name
              iterate: First
            schema: string
            mandatory: false
          schema_name:
            link:
              path: GetTableInformation/result/TaskRefTables/schema_name
              iterate: First
            schema: string
            mandatory: false
          filter_type:
            link:
              path: GetTableInformation/result/TaskRefTables/filter_type
              iterate: First
            schema: string
            mandatory: false
          table_filter:
            link:
              path: GetTableInformation/result/TaskRefTables/table_filter
              iterate: First
            schema: string
            mandatory: false
          target_interface:
            link: GetTableInformation/result/TargetInfo/target_interface_name
            schema: string
            mandatory: false
          target_schema:
            link: GetTableInformation/result/TargetInfo/target_schema_name
            schema: string
            mandatory: false
          target_table_name:
            link: GetTableInformation/result/TargetInfo/target_ref_table_name
            schema: string
            mandatory: false
          gui_filter:
            link:
              path: GetTableInformation/result/TaskRefTables/gui_filter
              iterate: First
            schema: string
            mandatory: false
          filter_parameters:
            link:
              path: GetTableInformation/result/TaskRefTables/filter_parameters
              iterate: First
            schema: any
            mandatory: false
            createdBy: fields
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        ref_table_name:
          type: string
  SplitIID.out.result:
    type: object
    properties:
      environment:
        type: string
      interface:
        type: string
      schema:
        type: string
      table:
        type: string
      execution_id:
        type: string
      partition_no: {
        }
  GetTableInformation.out.result:
    type: object
    properties:
      TaskInfo:
        type: object
        properties:
          loadEntity:
            type: boolean
          retentionPeriodValue:
            type: integer
          targetEnvId:
            type: integer
          taskTitle:
            type: string
          sourceEnvName:
            type: string
          taskId:
            type: integer
          deleteBeforeLoad:
            type: boolean
          sourceEnvId:
            type: integer
      CalculatedOrder:
        type: integer
      TargetInfo:
        type: object
        properties:
          target_schema_name:
            type: string
          target_interface_name:
            type: string
          target_ref_table_name:
            type: string
      TaskRefTables:
        type: array
        items:
          type: object
          properties:
            version_task_name:
              type: string
            ref_table_name:
              type: string
            filter_parameters: {
              }
            interface_name:
              type: string
            task_id:
              type: integer
            schema_name:
              type: string
            source_max_no_of_workers: {
              }
            target_table_prefix: {
              }
            target_max_no_of_workers: {
              }
            update_date:
              type: date
            filter_fields: {
              }
            target_affinity: {
              }
            task_ref_table_id:
              type: integer
            source_affinity: {
              }
            filter_type: {
              }
            version_task_execution_id:
              type: integer
            lu_name:
              type: string
            target_table_suffix: {
              }
            count_ind: {
              }
            table_filter: {
              }
            gui_filter: {
              }
      Definitions:
        type: object
        properties:
          interface_name:
            type: string
          load_flow:
            type: string
          partition_count_source:
            type: string
          schema_name:
            type: string
          table_name:
            type: string
          extract_flow:
            type: string
          count_indicator:
            type: string
          record_count_flow:
            type: string
          table_order:
            type: string
          partition_records_flow:
            type: string
          commit_size:
            type: string
          inplace_masking_update_flow:
            type: string
          delete_flow:
            type: string
      PartitionFlowInputs:
        type: object
        properties: {
          }
