{
    "Name": "Report",
    "Author": "K2view reports",
    "Width": "12.4in",
    "ReportParameters": [
        {
            "DataType": "String",
            "DefaultValue": {
                "Values": [
                    "=Format(AddMonths(Now(), -1), \"yyyy-MM-dd\")"
                ]
            },
            "Name": "FROM_DATE",
            "Prompt": "From date (YYYY-MM-DD)"
        },
        {
            "DataType": "String",
            "DefaultValue": {
                "Values": [
                    "=Format(Now(), \"yyyy-MM-dd\")"
                ]
            },
            "Name": "END_DATE",
            "Prompt": "End date (YYYY-MM-DD)"
        },
        {
            "DataType": "String",
            "Hidden": true,
            "Name": "TDMDB_SCHEMA",
            "Nullable": true,
            "Prompt": "TDM DB schema"
        }
    ],
    "EmbeddedImages": [
        {
            "Name": "k2view",
            "ImageData": "",
            "MIMEType": "image/svg+xml"
        }
    ],
    "Layers": [
        {
            "Name": "default"
        }
    ],
    "CustomProperties": [
        {
            "Name": "DisplayType",
            "Value": "Page"
        },
        {
            "Name": "SizeType",
            "Value": "Default"
        },
        {
            "Name": "PaperOrientation",
            "Value": "Landscape"
        }
    ],
    "Page": {
        "PageWidth": "12.6in",
        "PageHeight": "8.5in",
        "RightMargin": "0in",
        "LeftMargin": "0in",
        "TopMargin": "0in",
        "BottomMargin": "0in",
        "Columns": 1,
        "ColumnSpacing": "0.5in"
    },
    "DataSources": [
        {
            "Name": "fabricApi",
            "ConnectionProperties": {
                "DataProvider": "JSON",
                "ConnectString": "endpoint=/api/"
            }
        }
    ],
    "Body": {
        "Height": "8.15in",
        "ReportItems": [
            {
                "Type": "rectangle",
                "Name": "TitleArea",
