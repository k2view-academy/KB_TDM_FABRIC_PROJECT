                        "Color": "#cccccc",
                        "Style": "Solid"
                    },
                    "BackgroundColor": "White"
                },
                "ReportItems": [
                    {
                        "Type": "textbox",
                        "Name": "MainTitle",
                        "CanGrow": true,
                        "KeepTogether": true,
                        "Value": "TDM Dashboard",
                        "Style": {
                            "FontSize": "18pt",
                            "FontWeight": "Bold",
                            "PaddingLeft": "2pt",
                            "PaddingRight": "2pt",
                            "PaddingTop": "2pt",
