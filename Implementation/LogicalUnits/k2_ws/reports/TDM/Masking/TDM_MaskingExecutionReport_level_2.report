            "Query": {
                "DataSourceName": "fabricApi",
                "CommandText": "=\"uri=TDM_MaskingExecutionReport_level_2?FROM_DATE=\" & Parameters!FROM_DATE.Value & \"&END_DATE=\" & Parameters!END_DATE.Value & \"&TDMDB_SCHEMA=\" & Parameters!TDMDB_SCHEMA.Value & \"&INTERFACE_NAME=\" & Replace(Replace(Parameters!INTERFACE_NAME.Value, \"&\", \"%26\"), \" \", \"%20\") & \"&SCHEMA_NAME=\" & Replace(Replace(Parameters!SCHEMA_NAME.Value, \"&\", \"%26\"), \" \", \"%20\") & \"&DATASET_NAME=\" & Replace(Replace(Parameters!DATASET_NAME.Value, \"&\", \"%26\"), \" \", \"%20\") & \";jpath=$\""
            },
            "CaseSensitivity": "Auto",
            "KanatypeSensitivity": "Auto",
            "AccentSensitivity": "Auto",
            "WidthSensitivity": "Auto"
        },
