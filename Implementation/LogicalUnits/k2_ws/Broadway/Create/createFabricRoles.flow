tags: Create
stages:
  Get Flag:
    actors:
      is_first_deploy:
        parent: Const
        remark: A boolean representing if this is the first deploy
        in:
          value:
            const: null
            external: is_first_deploy
            schema: boolean
        out:
          value:
            schema: boolean
  'True':
    actors:
      Equals:
        parent: Equals
        condition: result
        in:
          a:
            link: is_first_deploy/value
            schema: boolean
          b:
            const: true
            schema: boolean
      DbCommand1:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: list roles ;
        out:
          result:
            schema: '#ref'
  Build Array:
    actors:
      ArrayBuilder:
        parent: ArrayBuilder
        in:
          input:
            link: DbCommand1/result
        out:
          array:
            schema: '#ref'
  Get All roles:
    actors:
      JavaScript1:
        parent: JavaScript
        in:
          script:
            const: |-
              var hasOwner = false;
              var hasExecutor = false;

              for (var i = 0; i < roles.length; i++) {
                  if (roles[i].name === "TDM Environment Owner & Task Creator")
                      hasOwner = true;

                  if (roles[i].name === "TDM Task Executor")
                      hasExecutor = true;
              }

              hasOwner && hasExecutor;
          roles:
            link: ArrayBuilder/array
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: boolean
  Get Script:
    actors:
      Not1:
        parent: Not
        condition: result
        in:
          value:
            link: JavaScript1/result
      Get  SQL Resource File To Create CRM DB Tables and Functions:
        parent: LuFunction
        in:
          functionName:
            const: loadFromLUResource
          path:
            const: TDM/DEMO/fabric_roles.sql
            schema: string
            mandatory: false
        out:
          result:
            schema: blob
  Split into commands:
    actors:
      'Split ':
        parent: Split
        in:
          delimiter:
            const: ;
          string:
            link: Get  SQL Resource File To Create CRM DB Tables and Functions/result
  Run commands:
    actors:
      DB Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: com.k2view.fabric.common.io.basic.exception.StandardSqlException
              conditions:
                standardType: UNIQUE_CONSTRAINT
              actions:
                suppress: false
                log: true
                flowName: ''
      'DbCommand ':
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: null
            link:
              path: Split /strings
              iterate: Iterate
schemas:
  DbCommand1.out.result:
    type: array
    items:
      type: object
      properties:
        name:
          type: string
        security profiles:
          type: string
        description:
          type: string
  ArrayBuilder.out.array:
    type: array
    items:
      type: object
      properties:
        name:
          type: string
        security profiles:
          type: string
        description:
          type: string
  JavaScript1.in.roles:
    type: array
    items:
      type: object
      properties:
        name:
          type: string
        security profiles:
          type: string
        description:
          type: string
