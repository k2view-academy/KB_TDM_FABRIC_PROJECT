tags: Create
stages:
  Check Deploy:
    actors:
      is_first_deploy:
        parent: Const
        remark: A boolean representing if this is the first deploy
        in:
          value:
            const: null
            external: is_first_deploy
            schema: boolean
        out:
          value:
            schema: boolean
  Equla:
    transactional: false
    actors:
      'Equals ':
        parent: Equals
        condition: result
        in:
          a:
            link: is_first_deploy/value
            schema: boolean
          b:
            const: true
            schema: boolean
  List Roles:
    transactional: false
    actors:
      DbCommand:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: List Roles
        out:
          result:
            schema: '#ref'
  Check for role:
    transactional: false
    actors:
      'TDM Environment Owner ':
        parent: StringPos
        in:
          substring:
            const: TDM Environment Owner & Task Creator
          string:
            link:
              path: DbCommand/result/name
              iterate: Iterate
  Get TDMDB:
    transactional: false
    actors:
      EqualsIgnoreCase:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: 'true'
            schema: string
          a:
            link: TDM Environment Owner /found
      getTDMDBSchemaName1:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
  Add Mapping:
    transactional: false
    actors:
      'DbCommand   ':
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: "INSERT INTO ${@schema}.permission_groups_mapping(\n\tdescription,\
              \ fabric_role, permission_group, created_by, updated_by, creation_date,\
              \ update_date, can_create_tasks)\n\tVALUES ('Initial mapping for owner\
              \ user',${k2v_user} ,'owner', 'admin', 'admin', NOW(), NOW(),true)\n\
              \tON CONFLICT (fabric_role) DO UPDATE SET permission_group='owner',description='Initial\
              \ mapping for Owner' ;\n"
          k2v_user:
            link: DbCommand/result/name
            schema: string
            mandatory: false
          schema:
            link: getTDMDBSchemaName1/schema
            schema: string
            mandatory: false
  Get SQl:
    transactional: false
    actors:
      Get  SQL Resource File To insert data to TDM tables:
        parent: LuFunction
        in:
          functionName:
            const: loadFromLUResource
          path:
            const: TDM/DEMO/tdm_insert.sql
            schema: string
            mandatory: false
        out:
          result:
            schema: blob
  Insert:
    last: 1
    transactional: false
    actors:
      Create Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: com.k2view.fabric.common.io.basic.exception.StandardSqlException
              conditions:
                standardType: UNIQUE_CONSTRAINT
              actions:
                suppress: false
                log: true
                flowName: ''
      Insert To TDM DB:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: null
            link: Get  SQL Resource File To insert data to TDM tables/result
          schema:
            link: getTDMDBSchemaName1/schema
            schema: string
            mandatory: false
schemas:
  DbCommand.out.result:
    type: array
    items:
      type: object
      properties:
        name:
          type: string
        security profiles:
          type: string
        description:
          type: string
