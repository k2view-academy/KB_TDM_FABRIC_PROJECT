{
  "name": "TASK_CREATION_REPORT_LEVEL_2",
  "serializerSettings": [
    {
      "set": "nice",
      "value": "true"
    }
  ],
  "children": [
    {
      "name": "BindHelper",
      "type": "function",
      "code": "var bind = function (name) { return '${' + name + '}'; };"
    },
    {
      "name": "TDMDBSchema",
      "type": "function",
      "code": "var TDMDB_SCHEMA;"
    },
    {
      "name": "GetTDMDBSchemaName",
      "type": "sql",
      "code": "broadway k2_ws.getTDMDBSchema",
      "sessionProvider": "fabric",
      "children": [
        {
          "name": "TDMDB_SCHEMA",
          "type": "function",
          "code": "if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(String(schema))) throw new Error('Invalid TDM DB schema');\nTDMDB_SCHEMA = String(schema);"
        }
      ]
    },
    {
      "name": "ValidateDates",
      "type": "function",
      "code": "if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(String(FROM_DATE))) throw new Error('Invalid FROM_DATE - expected yyyy-MM-dd');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(String(END_DATE))) throw new Error('Invalid END_DATE - expected yyyy-MM-dd');"
    },
    {
      "type": "function",
      "code": "var minTaskID;"
    },
    {
      "type": "function",
      "code": "var maxTaskID;"
    },
    {
      "name": "Min&MaxTasklDs",
      "type": "sqlNonPrepared",
      "code": "select min(task_id) as min_task_id, max(task_id) as max_task_id\nfrom \"${TDMDB_SCHEMA}\".tasks\nwhere task_creation_date >= ${bind('FROM_DATE')}::date and task_creation_date <  ${bind('END_DATE')}::date + 1;",
      "sessionProvider": "TDM",
      "children": [
        {
          "name": "minTaskID",
          "type": "function",
          "code": "minTaskID = min_task_id;"
        },
        {
          "name": "maxTaskID",
          "type": "function",
          "code": "maxTaskID = max_task_id;"
        }
      ]
    },
    {
      "name": "ActiveTasks",
      "type": "sqlNonPrepared",
      "code": "select count(*), table_list.processed_data , table_list.selection_method, table_list.task_type,\n        CASE WHEN be.be_name is null THEN 'N/A' ELSE be.be_name END AS be_name\n    from\n    (select t.task_id, t.be_id,\n     CASE\n        WHEN t.selection_method = 'ALL' and t.be_id >= 0 THEN 'Predefined entity list'\n        WHEN t.selection_method = 'TABLES' THEN 'Tables'\n        WHEN t.selection_method = 'C'  THEN 'Custom logic'\n        WHEN t.selection_method = 'L' THEN 'Entity list'\n        WHEN t.selection_method in ('P', 'PR') THEN 'Business parameters'\n        WHEN t.selection_method = 'GENERATE_SUBSET' THEN 'Load pre-generated subset'\n        WHEN t.selection_method ='R' THEN 'Random list'\n        WHEN t.selection_method = 'GENERATE' THEN 'Synthetic generation'\n        ELSE t.selection_method\n    END as selection_method  ,\n    CASE\n             WHEN t.in_place_masking_ind = true THEN 'In-place masking'\n  \t\t\t WHEN t.task_type = 'EXTRACT' THEN 'Extract'\n             WHEN t.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' AND t.delete_before_load = true THEN 'Extract & Delete & Load'\n             WHEN t.task_type = 'LOAD' AND t.source_environment_id < 0 AND t.SELECTION_METHOD not in ('GENERATE', 'AI_GENERATED')\n                     THEN 'Load SDG entities'\n             WHEN t.task_type = 'LOAD' AND t.SELECTION_METHOD = 'GENERATE' THEN 'Rule-based SDG & Load'\n      \t\t WHEN t.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' THEN 'Extract & Load'\n             WHEN t.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = false THEN 'Load & Reserve'\n             WHEN t.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = true THEN 'Load & Reserve & Delete'\n             WHEN t.task_type = 'LOAD' AND t.reserve_ind = false AND t.delete_before_load = true THEN 'Load & Delete'\n             WHEN t.task_type = 'LOAD' THEN 'Load'\n             WHEN t.task_type = 'DELETE' THEN 'Delete'\n             WHEN t.task_type = 'RESERVE' THEN 'Reserve'\n             WHEN t.task_type = 'TRAINING' THEN 'AI training'\n             WHEN t.task_type = 'GENERATE' THEN 'Rule-based generation'\n             WHEN t.task_type = 'AI_GENERATED' THEN 'AI-based generation'\n  \t\t\t ELSE t.task_type\n        END AS task_type ,\n     CASE\n            WHEN t.be_id = -1 THEN 'Tables'\n            WHEN t.be_id >= 0\n                 AND EXISTS (\n                        SELECT 1\n                        FROM \"${TDMDB_SCHEMA}\".task_ref_tables tr\n                        WHERE tr.task_id = t.task_id\n                 )\n                THEN 'Entities & Tables'\n            WHEN t.be_id >= 0 THEN 'Entities'\n            ELSE 'Entities'\n        END AS processed_data\n        from \"${TDMDB_SCHEMA}\".tasks t  where task_status = 'Active'\n        and\n        task_id <= ${bind('maxTaskID')}::bigint\n        ) table_list\n    LEFT JOIN \"${TDMDB_SCHEMA}\".business_entities be\n           ON table_list.be_id = be.be_id\n          AND table_list.be_id > 0\n        group by  table_list.processed_data , table_list.selection_method, table_list.task_type, be.be_name;",
      "sessionProvider": "TDM"
    },
    {
      "name": "TasksByUser",
      "type": "sqlNonPrepared",
      "code": "SELECT\n    COUNT(*) AS no_of_tasks_per_user,\n    task_creator,\n    permission_group as user_permission_group\nFROM (\n    SELECT\n        split_part(task_created_by, '##', 1) AS task_creator, permission_group\n    FROM \"${TDMDB_SCHEMA}\".tasks\n    WHERE task_status = 'Active'\n      AND task_id >= ${bind('minTaskID')}::bigint\n      AND task_id <= ${bind('maxTaskID')}::bigint\n) t\nGROUP BY task_creator, permission_group;",
      "sessionProvider": "TDM",
      "children": [
        {
          "name": "no_of_tasks_per_user",
          "type": "variable",
          "code": "no_of_tasks_per_user"
        },
        {
          "name": "task_creator",
          "type": "variable",
          "code": "task_creator"
        },
        {
          "name": "user_permission_group",
          "type": "variable",
          "code": "user_permission_group"
        }
      ]
    },
    {
      "name": "Top10BusinessParamsPerBE&Task",
      "type": "sqlNonPrepared",
      "code": "WITH parameter_usage AS (\n    SELECT\n        be.be_name,\n        split_part(rule ->> 'field', '.', 2) AS parameter_name,\n        COUNT(DISTINCT t.task_id) AS no_of_tasks\n    FROM tasks t\n    JOIN business_entities be\n      ON be.be_id = t.be_id\n    CROSS JOIN LATERAL jsonb_array_elements(\n        t.parameters::jsonb -> 'group' -> 'rules'\n    ) AS rule\n    WHERE\n    t.task_id <= ${bind('maxTaskID')}::bigint\n    AND t.selection_method IN ('P', 'PR')\n      AND jsonb_exists(rule, 'field')\n    GROUP BY\n        be.be_name,\n        parameter_name\n),\nranked_parameters AS (\n    SELECT\n        be_name,\n        parameter_name,\n        no_of_tasks,\n        ROW_NUMBER() OVER (\n            PARTITION BY be_name\n            ORDER BY no_of_tasks DESC\n        ) AS rn\n    FROM parameter_usage\n)\nSELECT\n    be_name,\n    parameter_name,\n    no_of_tasks\nFROM ranked_parameters\nWHERE rn <= 10\nORDER BY\n    be_name,\n    no_of_tasks DESC;",
      "sessionProvider": "TDM"
    }
  ],
  "params": [
    {
      "name": "FROM_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": true
    },
    {
      "name": "TDMDB_SCHEMA",
      "dataType": "String",
      "description": "Ignored - the TDM DB schema is taken from the TDM.TDMDB_SCHEMA Fabric global",
      "mandatory": false
    },
    {
      "name": "END_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": false
    }
  ],
  "description": "",
  "exposeAsEndpoint": true,
  "path": "",
  "requireAuth": true,
  "additionalPermissions": []
}