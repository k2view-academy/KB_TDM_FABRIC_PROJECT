{
  "name": "TASK_CREATION_REPORT_LEVEL_2",
  "serializerSettings": [
    {
      "set": "nice",
      "value": "true"
    }
  ],
  "children": [
    {
      "type": "function",
      "code": "var minTaskID;"
    },
    {
      "type": "function",
      "code": "var maxTaskID;"
    },
    {
      "name": "Min&MaxTasklDs",
      "type": "sqlNonPrepared",
      "code": "select min(task_id) as min_task_id, max(task_id) as max_task_id \nfrom \"${TDMDB_SCHEMA}\".tasks \nwhere task_creation_date >= DATE '${FROM_DATE}' and task_creation_date <  DATE '${END_DATE}' + 1;",
      "sessionProvider": "TDM",
      "children": [
        {
          "name": "minTaskID",
          "type": "function",
          "code": "minTaskID = min_task_id;"
        },
        {
          "name": "maxTaskID",
          "type": "function",
          "code": "maxTaskID = max_task_id;"
        }
      ]
    },
    {
      "name": "ActiveTasks",
      "type": "sqlNonPrepared",
      "code": "select count(*), table_list.processed_data , table_list.selection_method, table_list.task_type, \n        CASE WHEN be.be_name is null THEN 'N/A' ELSE be.be_name END AS be_name\n    from \n    (select t.task_id, t.be_id, \n     CASE \n        WHEN t.selection_method = 'ALL' and t.be_id >= 0 THEN 'Predefined entity list' \n        WHEN t.selection_method = 'TABLES' THEN 'Tables'\n        WHEN t.selection_method = 'C'  THEN 'Custom logic' \n        WHEN t.selection_method = 'L' THEN 'Entity list' \n        WHEN t.selection_method in ('P', 'PR') THEN 'Business parameters' \n        WHEN t.selection_method = 'GENERATE_SUBSET' THEN 'Load pre-generated subset' \n        WHEN t.selection_method ='R' THEN 'Random list'  \n        WHEN t.selection_method = 'GENERATE' THEN 'Synthetic generation'\n        ELSE t.selection_method \n    END as selection_method  , \n    CASE \n     \tWHEN t.in_place_masking_ind = true THEN 'In-place masking' \n        WHEN t.TASK_TYPE = 'EXTRACT' THEN 'Extract' \n        WHEN t.TASK_TYPE = 'LOAD' and t.sync_mode <> 'OFF' THEN 'Extract & Load'\n     \tWHEN t.TASK_TYPE = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = false THEN 'Load & Reserve'\n\t \tWHEN t.TASK_TYPE = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = true THEN 'Load & Reserve & Delete'\n        WHEN t.TASK_TYPE = 'LOAD' AND t.reserve_ind = false AND t.delete_before_load = true THEN 'Load & Delete' \n        WHEN t.TASK_TYPE = 'LOAD' THEN 'Load'  \n        WHEN t.TASK_TYPE = 'DELETE' THEN 'Delete' \n        WHEN t.TASK_TYPE = 'RESERVE' THEN 'Reserve' \n        WHEN t.TASK_TYPE = 'TRAINING' THEN 'AI training' \n        WHEN t.TASK_TYPE = 'GENERATE' THEN 'Rule-based SDG' \n        WHEN t.TASK_TYPE = 'AI_GENERATED' THEN 'AI-based SDG' \n        ELSE  t.TASK_TYPE\n    END AS task_type  ,\n     CASE\n            WHEN t.be_id = -1 THEN 'Tables'\n            WHEN t.be_id >= 0\n                 AND EXISTS (\n                        SELECT 1\n                        FROM \"${TDMDB_SCHEMA}\".task_ref_tables tr\n                        WHERE tr.task_id = t.task_id\n                 )\n                THEN 'Entities & Tables'\n            WHEN t.be_id >= 0 THEN 'Entities'\n        END AS processed_data \n        from \"${TDMDB_SCHEMA}\".tasks t  where task_status = 'Active' \n        and -- task_creation_date <  DATE '${END_DATE}' + 1\n        task_id <= ${maxTaskID}\n        ) table_list \n    LEFT JOIN \"${TDMDB_SCHEMA}\".business_entities be\n           ON table_list.be_id = be.be_id\n          AND table_list.be_id > 0    \n        group by  table_list.processed_data , table_list.selection_method, table_list.task_type, be.be_name;",
      "sessionProvider": "TDM"
    },
    {
      "name": "TasksByUser",
      "type": "sqlNonPrepared",
      "code": "SELECT\n    COUNT(*) AS no_of_tasks_per_user,\n    task_creator,\n    permission_group as user_permission_group\nFROM (\n    SELECT\n        split_part(task_created_by, '##', 1) AS task_creator, permission_group\n    FROM \"${TDMDB_SCHEMA}\".tasks\n    WHERE task_status = 'Active'\n      AND task_id >= ${minTaskID}\n      AND task_id <= ${maxTaskID}\n) t\nGROUP BY task_creator, permission_group;\n\n--select no_of_tasks_per_user, task_creator, \n--\tCASE \n--\t  WHEN 'admin' = ANY(pg_list) THEN 'admin' \n--\t  WHEN 'owner' = ANY(pg_list) THEN 'owner'\n--\t  WHEN 'tester' = ANY(pg_list) THEN 'tester' \n--\tEND as user_permission_Group  \n--\tfrom\n--\t  (select task_users.user_id,  array_agg(distinct pgm.permission_group)  as pg_list\n--\t   from \"${TDMDB_SCHEMA}\".permission_groups_mapping pgm,  \n--\t   (select distinct  split_part(task_created_by, '##', 1) as user_id, \n--\t\tunnest(string_to_array(split_part(task_created_by, '##', 2), '<#>')) as creator_role \n--\t\tfrom \"${TDMDB_SCHEMA}\".tasks t ) task_users \n--\t\twhere task_users.creator_role = pgm.fabric_role \n --       group by user_id\n--\t   ) user_pg, \n--\t  ( select count(*) no_of_tasks_per_user, split_part(task_created_by, '##', 1) as task_creator\n--\t\tfrom \"${TDMDB_SCHEMA}\".tasks t \n--\t\twhere t.task_status = 'Active' \n --       and -- t.task_creation_date >= DATE '${FROM_DATE}' and t.task_creation_date <= DATE '${END_DATE}' + 1\n--\t\tt.task_id >= ${minTaskID} and task_id <= ${maxTaskID} \n --       group by split_part(task_created_by, '##', 1)) no_of_task \n--\t where no_of_task.task_creator = user_pg.user_id ;",
      "sessionProvider": "TDM",
      "children": [
        {
          "name": "no_of_tasks_per_user",
          "type": "variable",
          "code": "no_of_tasks_per_user"
        },
        {
          "name": "task_creator",
          "type": "variable",
          "code": "task_creator"
        },
        {
          "name": "user_permission_group",
          "type": "variable",
          "code": "user_permission_group"
        }
      ]
    },
    {
      "name": "Top10BusinessParamsPerBE&Task",
      "type": "sqlNonPrepared",
      "code": "WITH parameter_usage AS (\n    SELECT\n        be.be_name,\n        split_part(rule ->> 'field', '.', 2) AS parameter_name,\n        COUNT(DISTINCT t.task_id) AS no_of_tasks\n    FROM tasks t    \n    JOIN business_entities be\n      ON be.be_id = t.be_id\n    CROSS JOIN LATERAL jsonb_array_elements(\n        t.parameters::jsonb -> 'group' -> 'rules'\n    ) AS rule\n    WHERE \n    t.task_id <= ${maxTaskID} \n    AND t.selection_method IN ('P', 'PR')\n      AND rule ? 'field'\n    GROUP BY\n        be.be_name,\n        parameter_name\n),\nranked_parameters AS (\n    SELECT\n        be_name,\n        parameter_name,\n        no_of_tasks,\n        ROW_NUMBER() OVER (\n            PARTITION BY be_name\n            ORDER BY no_of_tasks DESC\n        ) AS rn\n    FROM parameter_usage\n)\nSELECT\n    be_name,\n    parameter_name,\n    no_of_tasks\nFROM ranked_parameters\nWHERE rn <= 10\nORDER BY\n    be_name,\n    no_of_tasks DESC;\n",
      "sessionProvider": "TDM"
    }
  ],
  "params": [
    {
      "name": "FROM_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": true
    },
    {
      "name": "TDMDB_SCHEMA",
      "dataType": "String",
      "description": "",
      "mandatory": false
    },
    {
      "name": "END_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": false
    }
  ],
  "description": "",
  "exposeAsEndpoint": true,
  "path": "",
  "requireAuth": true,
  "additionalPermissions": []
}