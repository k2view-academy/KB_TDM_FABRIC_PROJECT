{
  "name": "TASK_EXECUTION_REPORT_LEVEL_1",
  "serializerSettings": [
    {
      "set": "nice",
      "value": "true"
    }
  ],
  "children": [
    {
      "type": "function",
      "code": "var minTaskExeID;"
    },
    {
      "type": "function",
      "code": "var maxTaskExeID;"
    },
    {
      "name": "Min&MaxTaskExelDs",
      "type": "sqlNonPrepared",
      "code": "select min(task_execution_id) as min_task_execution_id, max(task_execution_id) as max_task_execution_id \nfrom \"${TDMDB_SCHEMA}\".task_execution_summary  \nwhere creation_date >= DATE '${FROM_DATE}' and creation_date <  DATE '${END_DATE}' + 1;",
      "sessionProvider": "TDM",
      "children": [
        {
          "name": "minTaskExeID",
          "type": "function",
          "code": "minTaskExeID = min_task_execution_id;"
        },
        {
          "name": "maxTaskExeID",
          "type": "function",
          "code": "maxTaskExeID = max_task_execution_id;"
        }
      ]
    },
    {
      "name": "TaskExePerUserAndPermissionGroup",
      "type": "sqlNonPrepared",
      "code": "SELECT te.fabric_role as user_group, p.permission_group, COUNT(te.task_execution_id) AS no_of_executions \nFROM (select task_execution_id, task_executed_by, unnest(string_to_array(fabric_roles, '<#>')) as fabric_role  \n \t  from \"${TDMDB_SCHEMA}\".task_execution_summary te\n      WHERE task_execution_id >= ${minTaskExeID} AND task_execution_id <= ${maxTaskExeID}) te \nLEFT JOIN permission_groups_mapping p\nON p.fabric_role = te.fabric_role \nGROUP BY user_group, p.permission_group;",
      "sessionProvider": "TDM"
    },
    {
      "name": "NumOfExecutionsPerTaskTypeAndProcessedData",
      "type": "sqlNonPrepared",
      "code": "SELECT \n    COUNT(*) AS no_of_executions,\n     te.task_type,\n    te.processed_data,\n    CASE \n        WHEN be.be_name IS NULL THEN 'N/A' \n        ELSE be.be_name \n    END AS be_name,\n    INITCAP(te.execution_status) as execution_status\nFROM \n(SELECT \n            e.task_execution_id,\n            e.execution_status, \n            e.be_id,\n            CASE \n                WHEN e.be_id < 0 THEN 'Tables'\n                WHEN e.be_id >= 0 AND tot_num_of_processed_ref_tables > 0 THEN 'Entities & Tables'\n \t\t\t\tWHEN e.be_id >= 0 THEN 'Entities'\n            END AS processed_data,\n            CASE \n \t\t\t   WHEN t.in_place_masking_ind = true THEN 'In-place masking' \n               WHEN e.task_type = 'EXTRACT' THEN 'Extract' \n               WHEN e.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' AND t.delete_before_load = true THEN 'Extract & Delete & Load'  \n               WHEN e.task_type = 'LOAD' AND e.source_environment_id < 0 AND t.SELECTION_METHOD not in ('GENERATE', 'AI_GENERATED')  \n                     THEN 'Load SDG entities' \n               WHEN e.task_type = 'LOAD' AND t.selection_method = 'GENERATE' THEN 'Rule-based SDG & Load' \n               WHEN e.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' THEN 'Extract & Load'\n               WHEN e.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = false THEN 'Load & Reserve'\n               WHEN e.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = true THEN 'Load & Reserve & Delete'\n               WHEN e.task_type = 'LOAD' AND t.reserve_ind = false AND t.delete_before_load = true THEN 'Load & Delete' \n               WHEN e.task_type = 'LOAD' THEN 'Load' \n               WHEN e.task_type = 'DELETE' THEN 'Delete only'\n               WHEN e.task_type = 'RESERVE' THEN 'Reserve only' \n               WHEN e.task_type = 'TRAINING' THEN 'AI training'\n               WHEN e.task_type = 'GENERATE' THEN 'Rule-based generation'\n               WHEN e.task_type = 'AI_GENERATED' THEN 'AI-based generation' \n               ELSE e.task_type\n            END AS task_type\n        FROM \"${TDMDB_SCHEMA}\".task_execution_summary e\n        JOIN \"${TDMDB_SCHEMA}\".tasks t ON t.task_id = e.task_id\n        WHERE -- e.start_execution_time>= DATE '${FROM_DATE}'  AND  e.start_execution_time <=  DATE '${END_DATE}' + 1 \n \t\t\t  task_execution_id >= ${minTaskExeID} and task_execution_id <= ${maxTaskExeID}\n     ) te   \nLEFT JOIN \"${TDMDB_SCHEMA}\".business_entities be \n     ON te.be_id = be.be_id\nGROUP BY\n    te.task_type,\n    te.execution_status,\n    te.processed_data,    \n    be.be_name;",
      "sessionProvider": "TDM"
    },
    {
      "name": "AvgNoOfEntities&ExeTimePerExecution",
      "type": "sqlNonPrepared",
      "code": "\tSELECT\n    pe.task_type,\n    pe.be_name,\n\tINITCAP(pe.execution_status) as execution_status,\n    count(pe.task_execution_id) as total_no_of_executions,\n    SUM(pe.processed_entities) as total_no_of_processed_entities,\n    ROUND(AVG(pe.processed_entities))  AS avg_no_of_processed_entities,\n    ROUND(AVG(pe.failed_entities_pct),2) AS avg_failed_entities_percentage ,\n    COALESCE(ROUND(AVG(pe.exec_time_per_entity_sec)), 0) AS avg_exec_time_per_root_entity_sec\nFROM (\n    SELECT\n        e.task_execution_id,\n        e.execution_status,\n        CASE\n             WHEN t.in_place_masking_ind = true THEN 'In-place masking'  \n  \t\t\t WHEN e.task_type = 'EXTRACT' THEN 'Extract'  \n             WHEN e.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' AND t.delete_before_load = true THEN 'Extract & Delete & Load' \n             WHEN e.task_type = 'LOAD' AND e.source_environment_id < 0 AND t.SELECTION_METHOD not in ('GENERATE', 'AI_GENERATED')  \n                     THEN 'Load SDG entities' \n             WHEN e.task_type = 'LOAD' AND t.SELECTION_METHOD = 'GENERATE' THEN 'Rule-based SDG & Load'\n      \t\t WHEN e.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' THEN 'Extract & Load'\n             WHEN e.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = false THEN 'Load & Reserve'\n             WHEN e.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = true THEN 'Load & Reserve & Delete'\n             WHEN e.task_type = 'LOAD' AND t.reserve_ind = false AND t.delete_before_load = true THEN 'Load & Delete' \n             WHEN e.task_type = 'LOAD' THEN 'Load' \n             WHEN e.task_type = 'DELETE' THEN 'Delete'\n             WHEN e.task_type = 'RESERVE' THEN 'Reserve' \n             WHEN e.task_type = 'TRAINING' THEN 'AI training'\n             WHEN e.task_type = 'GENERATE' THEN 'Rule-based generation'\n             WHEN e.task_type = 'AI_GENERATED' THEN 'AI-based generation'\n  \t\t\t ELSE e.task_type \n        END AS task_type, \n        COALESCE(be.be_name, 'N/A') AS be_name,\n        CASE \n            WHEN t.execution_mode = 'INHERITED' THEN be.execution_mode\n            ELSE t.execution_mode\n        END AS execution_mode,\n        -- counts per execution\n        e.tot_num_of_processed_root_entities::numeric AS processed_entities,\n            -- % per execution\n        --COALESCE(100.0 * e.tot_num_of_failed_root_entities\n        COALESCE(e.tot_num_of_failed_root_entities         \n                  / NULLIF(e.tot_num_of_processed_root_entities, 0),\n            0\n        ) AS failed_entities_pct ,\n     -- execution time per entity (seconds)\n        (\n            EXTRACT(EPOCH FROM \n             --       (e.end_execution_time - e.start_execution_time))\n             \t(CASE\n            \t\tWHEN e.end_be_execution IS NOT NULL AND e.start_be_execution IS NOT NULL THEN e.end_be_execution - e.start_be_execution\n            \t\tELSE e.end_execution_time - e.start_execution_time\n        \t\t END ))\n            / NULLIF(e.tot_num_of_processed_root_entities, 0)\n        ) AS exec_time_per_entity_sec\n\n    FROM \"${TDMDB_SCHEMA}\".task_execution_summary e\n    JOIN \"${TDMDB_SCHEMA}\".tasks t\n        ON e.task_id = t.task_id\n    JOIN \"${TDMDB_SCHEMA}\".business_entities be\n        ON e.be_id = be.be_id\n    WHERE -- e.start_execution_time>= DATE '${FROM_DATE}' AND  e.start_execution_time <=  DATE '${END_DATE}' + 1 \n    task_execution_id >= ${minTaskExeID} and task_execution_id <= ${maxTaskExeID}\n    and e.be_id >= 0 \n) AS pe\nGROUP BY\n    pe.task_type,\n    pe.be_name,\n\tpe.execution_status;",
      "sessionProvider": "TDM"
    },
    {
      "name": "AvgProcessedTablesPerExecution",
      "type": "sqlNonPrepared",
      "code": "\tSELECT\n    pe.task_type,\n--    pe.processed_data,\n --   pe.be_name,\n\tINITCAP(pe.execution_status) AS execution_status ,\n    count(pe.task_execution_id) AS total_no_of_executions,\n    ROUND(AVG(pe.processed_tables)) AS avg_no_of_processed_tables,\n    ROUND(AVG(pe.failed_tables_pct),2) AS avg_failed_tables_percentage\nFROM (\n    SELECT\n        e.task_execution_id,\n        e.execution_status,\n        CASE\n  \t\t\t WHEN t.in_place_masking_ind = true THEN 'In-place masking' \n             WHEN e.task_type = 'EXTRACT' THEN 'Extract' \n             WHEN e.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' AND t.delete_before_load = true THEN 'Extract & Delete & Load' \n             WHEN e.task_type = 'LOAD' AND e.source_environment_id < 0 AND t.SELECTION_METHOD not in ('GENERATE', 'AI_GENERATED')  \n                     THEN 'Load SDG entities' \n             WHEN e.task_type = 'LOAD' AND t.selection_method = 'GENERATE' THEN 'Rule-based SDG & Load' \n             WHEN e.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' THEN 'Extract & Load'\n             WHEN e.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = false THEN 'Load & Reserve'\n             WHEN e.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = true THEN 'Load & Reserve & Delete'\n             WHEN e.task_type = 'LOAD' AND t.reserve_ind = false AND t.delete_before_load = true THEN 'Load & Delete' \n             WHEN e.task_type = 'LOAD' THEN 'Load' \n             WHEN e.task_type = 'DELETE' THEN 'Delete'\n     \t\t ELSE e.task_type \n        END AS task_type,\n        COALESCE(be.be_name, 'N/A') AS be_name,\n\n  \t\t-- counts per execution\n        e.tot_num_of_processed_ref_tables::numeric  AS processed_tables,\n\n        -- % per execution\n       \n        -- COALESCE(100.0 * e.tot_num_of_failed_ref_tables\n        COALESCE(e.tot_num_of_failed_ref_tables         \n                  / NULLIF(e.tot_num_of_processed_ref_tables, 0),\n            0\n        ) AS failed_tables_pct \n    FROM \"${TDMDB_SCHEMA}\".task_execution_summary e\n    JOIN \"${TDMDB_SCHEMA}\".tasks t\n        ON e.task_id = t.task_id\n    LEFT JOIN \"${TDMDB_SCHEMA}\".business_entities be\n        ON e.be_id = be.be_id \n    WHERE -- e.start_execution_time>= DATE '${FROM_DATE}' AND  e.start_execution_time <=  DATE '${END_DATE}' + 1\n    task_execution_id >= ${minTaskExeID} and task_execution_id <= ${maxTaskExeID} \n    and e.tot_num_of_processed_ref_tables > 0\n   ) pe \nGROUP BY\n    pe.task_type,\n --   pe.processed_data,\n --   pe.be_name,\n\tpe.execution_status ;",
      "sessionProvider": "TDM"
    },
    {
      "name": "Top5ProvisionedSystems",
      "type": "sqlNonPrepared",
      "code": "WITH executions_per_system AS (\n\n    -- Source 1 - entity level executions \n    SELECT\n        pl.product_name AS system_name,\n        COUNT(DISTINCT e.task_execution_id) AS no_of_executions\n    FROM \"${TDMDB_SCHEMA}\".task_execution_summary e\n    JOIN \"${TDMDB_SCHEMA}\".tasks_logical_units tl\n        ON e.task_id = tl.task_id\n    JOIN \"${TDMDB_SCHEMA}\".product_logical_units pl\n        ON tl.lu_id = pl.lu_id\n    WHERE e.task_type = 'LOAD' \n    AND task_execution_id >= ${minTaskExeID} and task_execution_id <= ${maxTaskExeID}\n   --   AND e.start_execution_time >= DATE '${FROM_DATE}'\n   --   AND e.start_execution_time <  DATE '${END_DATE}' + 1 \n    GROUP BY pl.product_name\n\n    UNION ALL\n\n    -- Source 2 - table-level executions - we need the task_ref_exe_stats to have a join with task_ref_tables and get the interface names for the systems\n    SELECT\n        p.product_name AS system_name,\n        COUNT(DISTINCT e.task_execution_id) AS no_of_executions\n    FROM \"${TDMDB_SCHEMA}\".task_ref_exe_stats e\n    JOIN \"${TDMDB_SCHEMA}\".task_ref_tables t\n        ON e.task_ref_table_id = t.task_ref_table_id\n    JOIN  \"${TDMDB_SCHEMA}\".task_execution_summary te \n        ON e.task_execution_id = te.task_execution_id \n    JOIN (\n        SELECT\n            unnest(related_interfaces) AS interface_name,\n            product_id,\n            product_name\n        FROM \"${TDMDB_SCHEMA}\".products\n    ) p\n        ON t.interface_name = p.interface_name\n   JOIN \"${TDMDB_SCHEMA}\".environment_products ep \n        ON  te.environment_id = ep.environment_id AND p.product_id = ep.product_id and ep.status = 'Active'   \n    JOIN \"${TDMDB_SCHEMA}\".tasks ta\n        ON e.task_id = ta.task_id\n    WHERE ta.task_type = 'LOAD'\n    AND e.task_execution_id >= ${minTaskExeID} and e.task_execution_id <= ${maxTaskExeID}\n   --   AND e.start_time >=  DATE '${FROM_DATE}' \n   --   AND e.start_time <  DATE '${END_DATE}' + 1 \n    GROUP BY p.product_name\n)\n\nSELECT\n    system_name,\n    SUM(no_of_executions) AS total_executions\nFROM executions_per_system\nGROUP BY system_name\nORDER BY total_executions DESC, system_name\nLIMIT 5;",
      "sessionProvider": "TDM"
    },
    {
      "name": "Top5BEs&SelectionMethod",
      "type": "sqlNonPrepared",
      "code": "WITH top_be AS (\n    SELECT\n        count(task_execution_id), \n        e.be_id\n    FROM task_execution_summary e\n    WHERE task_execution_id >= ${minTaskExeID} AND task_execution_id <= ${maxTaskExeID}  \n    AND e.be_id > 0 \n    GROUP BY e.be_id\n    ORDER BY COUNT(task_execution_id) DESC\n    LIMIT 5\n),\nexecution_overrides AS (\n    SELECT DISTINCT ON (oa.task_execution_id, oa.task_id)\n        oa.task_execution_id,\n        oa.task_id,\n        CASE \n            WHEN json_extract_path(oa.override_parameters, 'value') IS NOT NULL\n            THEN json_extract_path(oa.override_parameters, 'value')::text::jsonb ->>'BE_ID'\n            ELSE oa.override_parameters ->>'BE_ID'\n        END AS exe_be_id,\n        CASE \n            WHEN json_extract_path(oa.override_parameters, 'value') IS NOT NULL\n            THEN json_extract_path(oa.override_parameters, 'value')::text::jsonb ->>'SELECTION_METHOD'\n            ELSE oa.override_parameters ->>'SELECTION_METHOD'\n        END AS exe_selection_method\n    FROM task_execution_override_attrs oa\n    JOIN task_execution_summary s \n      ON s.task_execution_id = oa.task_execution_id\n    WHERE s.task_execution_id >= ${minTaskExeID} \n      AND s.task_execution_id <= ${maxTaskExeID}\n),\nresolved AS (\n    SELECT\n        e.task_execution_id,\n        e.task_id,\n        COALESCE(eo.exe_be_id::bigint, e.be_id) AS resolved_be_id,\n        COALESCE(eo.exe_selection_method, t.selection_method) AS resolved_selection_method\n    FROM task_execution_summary e\n    JOIN tasks t\n      ON t.task_id = e.task_id\n    LEFT JOIN execution_overrides eo\n      ON eo.task_execution_id = e.task_execution_id\n      AND eo.task_id = e.task_id\n    WHERE e.task_execution_id >= ${minTaskExeID} \n      AND e.task_execution_id <= ${maxTaskExeID}\n)\nSELECT\n    be.be_name,\n    CASE\n        WHEN r.resolved_selection_method = 'ALL' AND r.resolved_be_id >= 0 THEN 'Predefined entity list'\n        WHEN r.resolved_selection_method = 'TABLES' THEN 'Tables'\n        WHEN r.resolved_selection_method = 'C' THEN 'Custom logic'\n        WHEN r.resolved_selection_method = 'L' THEN 'Entity list'\n        WHEN r.resolved_selection_method IN ('P', 'PR') THEN 'Business parameters'\n        WHEN r.resolved_selection_method = 'GENERATE_SUBSET' THEN 'Load pre-generated subset'\n        WHEN r.resolved_selection_method = 'R' THEN 'Random list'\n        WHEN r.resolved_selection_method = 'GENERATE' THEN 'Synthetic generation'\n        ELSE r.resolved_selection_method\n    END AS selection_method,\n    COUNT(*) AS no_of_executions\nFROM resolved r\nJOIN top_be tb\n  ON tb.be_id = r.resolved_be_id\nJOIN business_entities be\n  ON be.be_id = r.resolved_be_id\nGROUP BY\n    be.be_name,\n    r.resolved_be_id,\n    r.resolved_selection_method\nORDER BY\n    be.be_name,\n    no_of_executions DESC;",
      "sessionProvider": "TDM"
    }
  ],
  "params": [
    {
      "name": "TDMDB_SCHEMA",
      "dataType": "String",
      "description": "",
      "mandatory": true
    },
    {
      "name": "FROM_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": true
    },
    {
      "name": "END_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": true
    }
  ],
  "description": "",
  "exposeAsEndpoint": true,
  "path": "",
  "requireAuth": true,
  "additionalPermissions": []
}