{
  "name": "TDM_ENVIRONMENTS_LEVEL_1",
  "serializerSettings": [
    {
      "set": "nice",
      "value": "true"
    }
  ],
  "children": [
    {
      "name": "EnvironmentList",
      "type": "sqlNonPrepared",
      "code": "\nSELECT\n    e.environment_name,\n    CASE\n        WHEN e.allow_read = true  AND e.allow_write = true  THEN 'Source & target'\n        WHEN e.allow_read = true  AND e.allow_write = false THEN 'Source'\n        WHEN e.allow_read = false AND e.allow_write = true  THEN 'Target'\n        ELSE 'Undefined'\n    END AS environment_type,\n    CASE\n        WHEN e.mask_sensitive_data = true  THEN 'Sensitive'\n        ELSE 'Non-sensitive'\n     END AS mask_sensitive_data,\n    COUNT(er.role_id) AS no_of_env_user_groups\nFROM \"${TDMDB_SCHEMA}\".environments e\nLEFT JOIN environment_roles er\n    ON e.environment_id = er.environment_id\n   AND er.role_status = 'Active'\nWHERE e.environment_status = 'Active'\nGROUP BY\n    e.environment_name,\n    e.allow_read,\n    e.allow_write,\n    e.mask_sensitive_data;",
      "sessionProvider": "TDM"
    },
    {
      "name": "EnvironmentSystems",
      "type": "sqlNonPrepared",
      "code": "SELECT\n    e.environment_name,\n    p.product_name          AS system_name,\n    ep.product_version      AS system_version,\n    ep.data_center_name     AS system_affinity,\n    CASE\n        WHEN ep.environment_id IS NULL THEN 'N/A' \n        WHEN ep.enable_product = true THEN 'Enabled'\n        ELSE 'Disabled'\n    END AS current_system_status\nFROM \"${TDMDB_SCHEMA}\".environments e\nLEFT JOIN \"${TDMDB_SCHEMA}\".environment_products ep\n       ON e.environment_id = ep.environment_id\n      AND ep.status = 'Active'\nLEFT JOIN \"${TDMDB_SCHEMA}\".products p\n       ON ep.product_id = p.product_id\nWHERE e.environment_status = 'Active';",
      "sessionProvider": "TDM"
    }
  ],
  "params": [
    {
      "name": "TDMDB_SCHEMA",
      "dataType": "String",
      "description": "",
      "mandatory": true
    }
  ],
  "description": "",
  "exposeAsEndpoint": true,
  "path": "",
  "requireAuth": true,
  "additionalPermissions": []
}