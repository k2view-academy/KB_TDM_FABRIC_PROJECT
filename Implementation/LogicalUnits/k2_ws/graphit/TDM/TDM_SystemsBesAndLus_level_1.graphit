{
  "name": "TDM_SYSTEMS_BEs_and_LUs_LEVEL_1",
  "serializerSettings": [
    {
      "set": "nice",
      "value": "true"
    }
  ],
  "children": [
    {
      "name": "TDMDBSchema",
      "type": "function",
      "code": "var TDMDB_SCHEMA;"
    },
    {
      "name": "GetTDMDBSchemaName",
      "type": "sql",
      "code": "broadway k2_ws.getTDMDBSchema",
      "sessionProvider": "fabric",
      "children": [
        {
          "name": "TDMDB_SCHEMA",
          "type": "function",
          "code": "if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(String(schema))) throw new Error('Invalid TDM DB schema');\nTDMDB_SCHEMA = String(schema);"
        }
      ]
    },
    {
      "name": "SystemsBEsAndLUs",
      "type": "sqlNonPrepared",
      "code": "select product_name as system_name, b.be_name, lu_name\n from \"${TDMDB_SCHEMA}\".product_logical_units p\n JOIN \"${TDMDB_SCHEMA}\".business_entities b ON p.be_id = b.be_id\n where product_id > -1\n order by system_name, be_name, lu_name;",
      "sessionProvider": "TDM"
    },
    {
      "name": "SystemsAndInterfaces",
      "type": "sqlNonPrepared",
      "code": " SELECT product_name as system_name , unnest(related_interfaces) AS interface_name\n FROM \"${TDMDB_SCHEMA}\".products where product_status = 'Active';",
      "sessionProvider": "TDM"
    },
    {
      "name": "NoOfLusPerBE",
      "type": "sqlNonPrepared",
      "code": " select b.be_name, count(lu_id) as no_of_lus\n from \"${TDMDB_SCHEMA}\".product_logical_units p\n JOIN \"${TDMDB_SCHEMA}\".business_entities b ON p.be_id = b.be_id\n group by be_name;",
      "sessionProvider": "TDM"
    }
  ],
  "params": [
    {
      "name": "TDMDB_SCHEMA",
      "dataType": "String",
      "description": "Ignored - the TDM DB schema is taken from the TDM.TDMDB_SCHEMA Fabric global",
      "mandatory": false
    }
  ],
  "description": "",
  "exposeAsEndpoint": true,
  "path": "",
  "requireAuth": true,
  "additionalPermissions": []
}