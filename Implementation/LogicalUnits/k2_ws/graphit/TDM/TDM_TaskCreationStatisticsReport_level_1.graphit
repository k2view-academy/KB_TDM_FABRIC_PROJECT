{
  "name": "TASK_CREATION_REPORT_LEVEL_1",
  "serializerSettings": [
    {
      "set": "nice",
      "value": "true"
    }
  ],
  "children": [
    {
      "name": "BindHelper",
      "type": "function",
      "code": "var bind = function (name) { return '${' + name + '}'; };"
    },
    {
      "name": "TDMDBSchema",
      "type": "function",
      "code": "var TDMDB_SCHEMA;"
    },
    {
      "name": "GetTDMDBSchemaName",
      "type": "sql",
      "code": "broadway k2_ws.getTDMDBSchema",
      "sessionProvider": "fabric",
      "children": [
        {
          "name": "TDMDB_SCHEMA",
          "type": "function",
          "code": "if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(String(schema))) throw new Error('Invalid TDM DB schema');\nTDMDB_SCHEMA = String(schema);"
        }
      ]
    },
    {
      "name": "ValidateDates",
      "type": "function",
      "code": "if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(String(FROM_DATE))) throw new Error('Invalid FROM_DATE - expected yyyy-MM-dd');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(String(END_DATE))) throw new Error('Invalid END_DATE - expected yyyy-MM-dd');"
    },
    {
      "type": "function",
      "code": "var minTaskID;"
    },
    {
      "type": "function",
      "code": "var maxTaskID;"
    },
    {
      "name": "Min&MaxTasklDs",
      "type": "sqlNonPrepared",
      "code": "select min(task_id) as min_task_id, max(task_id) as max_task_id\nfrom \"${TDMDB_SCHEMA}\".tasks\nwhere task_creation_date >= ${bind('FROM_DATE')}::date and task_creation_date <  ${bind('END_DATE')}::date + 1;",
      "sessionProvider": "TDM",
      "children": [
        {
          "name": "minTaskID",
          "type": "function",
          "code": "minTaskID = min_task_id;"
        },
        {
          "name": "maxTaskID",
          "type": "function",
          "code": "maxTaskID = max_task_id;"
        }
      ]
    },
    {
      "name": "TasksPerUserAndPermissionGroup",
      "type": "sqlNonPrepared",
      "code": "SELECT\n    COUNT(t.task_id) AS no_of_tasks,\n    fr.creator_role,\n    t.permission_group\nFROM \"${TDMDB_SCHEMA}\".tasks t\nCROSS JOIN LATERAL\n     unnest(string_to_array(t.fabric_roles, '<#>')) AS fr(creator_role)\nWHERE t.task_status = 'Active'\n  AND t.task_id >= ${bind('minTaskID')}::bigint\n  AND t.task_id <= ${bind('maxTaskID')}::bigint\nGROUP BY\n    fr.creator_role,\n    t.permission_group;",
      "sessionProvider": "TDM",
      "children": [
        {
          "name": "no_of_tasks",
          "type": "variable",
          "code": "no_of_tasks"
        },
        {
          "name": "creator_role",
          "type": "variable",
          "code": "creator_role"
        },
        {
          "name": "permission_group",
          "type": "variable",
          "code": "permission_group"
        }
      ]
    },
    {
      "name": "ActiveTasks",
      "type": "sqlNonPrepared",
      "code": "select count(*) as no_of_tasks, table_list.task_type, table_list.processed_data\nfrom\n    (select t.task_id,\n         CASE\n             WHEN t.in_place_masking_ind = true THEN 'In-place masking'\n  \t\t\t WHEN t.task_type = 'EXTRACT' THEN 'Extract'\n             WHEN t.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' AND t.delete_before_load = true THEN 'Extract & Delete & Load'\n             WHEN t.task_type = 'LOAD' AND t.source_environment_id < 0 AND t.SELECTION_METHOD not in ('GENERATE', 'AI_GENERATED')\n                     THEN 'Load SDG entities'\n             WHEN t.task_type = 'LOAD' AND t.SELECTION_METHOD = 'GENERATE' THEN 'Rule-based SDG & Load'\n      \t\t WHEN t.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' THEN 'Extract & Load'\n             WHEN t.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = false THEN 'Load & Reserve'\n             WHEN t.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = true THEN 'Load & Reserve & Delete'\n             WHEN t.task_type = 'LOAD' AND t.reserve_ind = false AND t.delete_before_load = true THEN 'Load & Delete'\n             WHEN t.task_type = 'LOAD' THEN 'Load'\n             WHEN t.task_type = 'DELETE' THEN 'Delete'\n             WHEN t.task_type = 'RESERVE' THEN 'Reserve'\n             WHEN t.task_type = 'TRAINING' THEN 'AI training'\n             WHEN t.task_type = 'GENERATE' THEN 'Rule-based generation'\n             WHEN t.task_type = 'AI_GENERATED' THEN 'AI-based generation'\n  \t\t\t ELSE t.task_type\n        END AS task_type,\n     CASE\n            WHEN t.be_id = -1 THEN 'Tables'\n            WHEN t.be_id >= 0\n                 AND EXISTS (\n                        SELECT 1\n                        FROM \"${TDMDB_SCHEMA}\".task_ref_tables tr\n                        WHERE tr.task_id = t.task_id\n                 )\n                THEN 'Entities & Tables'\n            WHEN t.be_id >= 0 THEN 'Entities'\n            ELSE 'Entities'\n        END AS processed_data\n        from \"${TDMDB_SCHEMA}\".tasks t where task_status = 'Active'\n        and\n        task_id <= ${bind('maxTaskID')}::bigint\n        ) table_list\n        group by  table_list.task_type, table_list.processed_data;",
      "sessionProvider": "TDM"
    },
    {
      "name": "AvgTasksByUser",
      "type": "sqlNonPrepared",
      "code": "SELECT\n    ROUND(AVG(no_of_tasks_per_user)) AS avg_no_of_tasks,\n    permission_group AS user_permission_group\nFROM (\n    SELECT\n        COUNT(*) AS no_of_tasks_per_user,\n        split_part(task_created_by, '##', 1) AS user_id,\n        permission_group\n    FROM \"${TDMDB_SCHEMA}\".tasks t\n    WHERE t.task_status = 'Active'\n      AND t.task_id >= ${bind('minTaskID')}::bigint\n      AND t.task_id <= ${bind('maxTaskID')}::bigint\n    GROUP BY\n        user_id,\n        permission_group\n) no_of_task\nGROUP BY\n    permission_group;",
      "sessionProvider": "TDM"
    },
    {
      "name": "NoOfTasksPerSelectionMethod",
      "type": "sqlNonPrepared",
      "code": " select count(*) as no_of_tasks, selection_method\n from\n (select task_id,\n   CASE\n        \tWHEN t.selection_method = 'ALL' THEN 'Predefined entity list'\n        \tWHEN t.selection_method = 'TABLES' THEN 'Tables'\n        \tWHEN t.selection_method = 'C'  THEN 'Custom logic'\n        \tWHEN t.selection_method = 'L' THEN 'Entity list'\n        \tWHEN t.selection_method in ('P', 'PR') THEN 'Business parameters'\n        \tWHEN t.selection_method = 'GENERATE_SUBSET' THEN 'Load pre-generated subset'\n        \tWHEN t.selection_method ='R' THEN 'Random list'\n        \tWHEN t.selection_method = 'GENERATE' THEN 'Synthetic generation'\n        \tELSE t.selection_method\n    \tEND as selection_method\n    FROM \"${TDMDB_SCHEMA}\".tasks t\n    where task_status = 'Active'\n    and task_id <= ${bind('maxTaskID')}::bigint\n    and be_id >= 0 ) t\n    group by selection_method;",
      "sessionProvider": "TDM"
    }
  ],
  "params": [
    {
      "name": "FROM_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": true
    },
    {
      "name": "TDMDB_SCHEMA",
      "dataType": "String",
      "description": "Ignored - the TDM DB schema is taken from the TDM.TDMDB_SCHEMA Fabric global",
      "mandatory": false
    },
    {
      "name": "END_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": true
    }
  ],
  "description": "",
  "exposeAsEndpoint": true,
  "path": "",
  "requireAuth": true,
  "additionalPermissions": []
}