{
  "name": "TDM_MASKING_CONFIGURATION_REPORT_ALL_PII_CLASSIFICATIONS_LEVEL_2",
  "serializerSettings": [
    {
      "set": "nice",
      "value": "true"
    }
  ],
  "children": [
    {
      "name": "GetPIIClassificationList",
      "type": "sql",
      "code": "broadway k2_ws.getPIIDetails",
      "children": [
        {
          "name": "SetUndefinedConsistencyForMissingGenerators",
          "type": "function",
          "code": "if (PIIClassificationList) {\n    PIIClassificationList.forEach(function(row) {\n        var dg = row['Data Generator'];\n        var s = (dg === null || dg === undefined) ? '' : String(dg).trim();\n        if (s === '' || s.toUpperCase() === 'N/A') {\n            row['Data Consistency'] = 'Undefined';\n        }\n    });\n}"
        },
        {
          "name": "StripActorSuffixFromPIIClassificationList",
          "type": "function",
          "code": "if (PIIClassificationList) {\n    PIIClassificationList.forEach(function(row) {\n        var dg = row['Data Generator'];\n        if (dg && dg.length > 6 && dg.substring(dg.length - 6).toLowerCase() === '.actor') {\n            row['Data Generator'] = dg.substring(0, dg.length - 6);\n        }\n    });\n}"
        },
        {
          "name": "PIIClassificationList",
          "type": "variable",
          "code": "PIIClassificationList"
        }
      ]
    }
  ],
  "params": [],
  "description": "Returns the full list of all PII classifications (drill-through target for the PII Classifications summary tile).",
  "exposeAsEndpoint": true,
  "path": "",
  "requireAuth": true,
  "additionalPermissions": []
}
