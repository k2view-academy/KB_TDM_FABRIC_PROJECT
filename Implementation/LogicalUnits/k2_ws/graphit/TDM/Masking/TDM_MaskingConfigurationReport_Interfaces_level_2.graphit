{
  "name": "TDM_MASKING_CONFIGURATION_REPORT_INTERFACES_LEVEL_2",
  "serializerSettings": [
    {
      "set": "nice",
      "value": "true"
    }
  ],
  "children": [
    {
      "name": "GetInterfacesTablesSummary",
      "type": "sql",
      "code": "broadway k2_ws.getInterfacesTablesSummaryByInterface 'interfaceName'=${INTERFACE_NAME}",
      "children": [
        {
          "name": "InterfacesTablesSummaryList",
          "type": "variable",
          "code": "InterfacesTablesSummaryList"
        }
      ]
    },
    {
      "name": "GetInterfacesTableFieldsList",
      "type": "sql",
      "code": "broadway k2_ws.getInterfacesTableFieldsListByInterface 'interfaceName'=${INTERFACE_NAME}",
      "collapsed": true,
      "children": [
        {
          "name": "StripActorSuffixFromInterfacesTableFieldsList",
          "type": "function",
          "code": "if (InterfacesTableFieldsList) {\n    InterfacesTableFieldsList.forEach(function(row) {\n        var dg = row['Data Generator'];\n        if (dg && dg.length > 6 && dg.substring(dg.length - 6).toLowerCase() === '.actor') {\n            row['Data Generator'] = dg.substring(0, dg.length - 6);\n        }\n    });\n}"
        },
        {
          "name": "InterfacesTableFieldsList",
          "type": "variable",
          "code": "InterfacesTableFieldsList"
        }
      ]
    }
  ],
  "params": [
    {
      "name": "INTERFACE_NAME",
      "dataType": "String",
      "description": "",
      "mandatory": true
    }
  ],
  "description": "",
  "exposeAsEndpoint": true,
  "path": "",
  "requireAuth": true,
  "additionalPermissions": []
}
