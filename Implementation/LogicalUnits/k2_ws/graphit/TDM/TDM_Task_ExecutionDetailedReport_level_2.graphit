{
  "name": "TASK_EXECUTION_REPORT_LEVEL_2",
  "serializerSettings": [
    {
      "set": "nice",
      "value": "true"
    }
  ],
  "children": [
    {
      "type": "function",
      "code": "var minTaskExeID;"
    },
    {
      "type": "function",
      "code": "var maxTaskExeID;"
    },
    {
      "name": "Min&MaxTaskExelDs",
      "type": "sqlNonPrepared",
      "code": "select min(task_execution_id) as min_task_execution_id, max(task_execution_id) as max_task_execution_id \nfrom \"${TDMDB_SCHEMA}\".task_execution_summary  \nwhere creation_date >= DATE '${FROM_DATE}' and creation_date <  DATE '${END_DATE}' + 1;",
      "sessionProvider": "TDM",
      "children": [
        {
          "name": "minTaskExeID",
          "type": "function",
          "code": "minTaskExeID = min_task_execution_id;"
        },
        {
          "name": "maxTaskExeID",
          "type": "function",
          "code": "maxTaskExeID = max_task_execution_id;"
        }
      ]
    },
    {
      "name": "EnvExecutionDetails",
      "type": "sqlNonPrepared",
      "code": "WITH filtered_executions AS (\n    SELECT\n        te.task_execution_id,\n        te.execution_status, \n        te.environment_id,\n        te.source_environment_id,\n        CASE\n           WHEN te.source_environment_id = -1 THEN 'Rule-based SDG'\n           WHEN te.source_environment_id = -2 THEN 'AI-based SDG'\n           ELSE te.source_env_name\n        END AS source_env_name,\n       CASE\n           WHEN te.environment_id = -1 THEN 'Rule-based SDG'\n           WHEN te.environment_id = -2 THEN 'AI-based SDG'       \n  \t\t   ELSE e.environment_name\n        END AS tar_env_name,  \n        (te.environment_id = te.source_environment_id) AS equal_src_and_tar,\n        te.tot_num_of_processed_root_entities AS no_of_processed_entities,\n        te.tot_num_of_processed_ref_tables   AS no_of_processed_tables,\n        te.be_id,\n        COALESCE(be.be_name, 'N/A') AS be_name,\n        CASE\n            WHEN te.be_id >= 0 AND tot_num_of_processed_ref_tables > 0 THEN 'Entities & Tables'\n            WHEN te.be_id >= 0 THEN 'Entities'\n            WHEN te.be_id < 0 THEN 'Tables'\n        END AS processed_data,\n        CASE\n  \t\t\t WHEN t.in_place_masking_ind = true THEN 'In-place masking' \n            WHEN te.task_type = 'EXTRACT' THEN 'Extract' \n            WHEN te.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' AND t.delete_before_load = true THEN 'Extract & Delete & Load' \n            WHEN te.task_type = 'LOAD' AND te.source_environment_id < 0 AND t.SELECTION_METHOD not in ('GENERATE', 'AI_GENERATED')  \n                     THEN 'Load SDG entities' \n            WHEN te.task_type = 'LOAD' AND t.selection_method = 'GENERATE' THEN 'Rule-based SDG & Load' \n            WHEN te.task_type = 'LOAD' AND te.source_environment_id < 0 AND t.SELECTION_METHOD not in ('GENERATE', 'AI_GENERATED')  \n                     THEN 'Load SDG entities' \n            WHEN te.task_type = 'LOAD' AND t.selection_method = 'GENERATE' THEN 'Rule-based SDG & Load' \n            WHEN te.task_type = 'LOAD' AND t.sync_mode <> 'OFF' THEN 'Extract & Load'\n            WHEN te.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = false THEN 'Load & Reserve'\n            WHEN te.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = true THEN 'Load & Reserve & Delete'\n            WHEN te.task_type = 'LOAD' AND t.reserve_ind = false AND t.delete_before_load = true THEN 'Load & Delete' \n  \t\t\t WHEN te.task_type = 'LOAD' THEN 'Load' \n            WHEN te.task_type = 'DELETE' THEN 'Delete'\n            WHEN te.task_type = 'RESERVE' THEN 'Reserve'\n            WHEN te.task_type = 'TRAINING' THEN 'AI training'\n            WHEN te.task_type = 'GENERATE' THEN 'Rule-based SDG'\n            WHEN te.task_type = 'AI_GENERATED' THEN 'AI-based SDG'            \n            ELSE te.task_type\n        END AS task_type,\n        te.task_type AS orig_task_type,\n        t.in_place_masking_ind\n    FROM \"${TDMDB_SCHEMA}\".task_execution_summary te\n    JOIN \"${TDMDB_SCHEMA}\".tasks t\n      ON te.task_id = t.task_id\n    JOIN \"${TDMDB_SCHEMA}\".environments e\n         ON te.environment_id = e.environment_id \n    LEFT JOIN \"${TDMDB_SCHEMA}\".business_entities be\n      ON te.be_id = be.be_id\n    WHERE -- te.start_execution_time >= DATE '${FROM_DATE}' AND te.start_execution_time <  DATE '${END_DATE}' + 1 \n    task_execution_id >= ${minTaskExeID} and task_execution_id <= ${maxTaskExeID} \n)\n-- Target env\nSELECT\n    fe.tar_env_name AS environment_name,  \n    CASE\n        WHEN fe.equal_src_and_tar THEN 'Source & target'\n        ELSE 'Target'\n    END AS env_type,\n     COUNT(*) AS total_no_of_executions,\n    SUM(no_of_processed_entities) AS no_of_processed_entities,\n    SUM(no_of_processed_tables)   AS no_of_processed_tables,\n    fe.task_type,\n    fe.processed_data,\n    fe.be_name\nFROM filtered_executions fe\nWHERE (fe.orig_task_type IN ('DELETE', 'RESERVE', 'LOAD', 'TRAINING') OR fe.in_place_masking_ind = true) \n   AND ('${ENV_NAME}' = 'ALL_ENV' or fe.tar_env_name = '${ENV_NAME}')\nGROUP BY\n    fe.tar_env_name, \n    fe.equal_src_and_tar,\n    fe.task_type,\n    fe.processed_data,\n    fe.be_name\nUNION ALL\n-- Source env \nSELECT\n     fe.source_env_name AS environment_name,\n    'Source' AS env_type,\n     COUNT(*) AS total_no_of_executions,\n    SUM(no_of_processed_entities) AS no_of_processed_entities,\n    SUM(no_of_processed_tables)   AS no_of_processed_tables,\n    fe.task_type,\n    fe.processed_data,\n    fe.be_name \nFROM filtered_executions fe\nWHERE fe.orig_task_type NOT IN ('DELETE', 'RESERVE') \nAND (fe.orig_task_type in ('EXTRACT', 'GENERATE', 'AI_GENERATED') or fe.equal_src_and_tar = false)\n   AND fe.in_place_masking_ind = false \n  AND  ('${ENV_NAME}' = 'ALL_ENV' or fe.source_env_name  = '${ENV_NAME}')\nGROUP BY\n    fe.source_env_name,\n    fe.task_type,\n    fe.processed_data,\n    fe.be_name \n ORDER BY total_no_of_executions DESC;",
      "sessionProvider": "TDM",
      "serializerSettings": [
        {
          "set": "nice",
          "value": "true"
        }
      ]
    },
    {
      "name": "EnvEntityExeStats",
      "type": "sqlNonPrepared",
      "code": "WITH filtered_executions AS (\n    SELECT\n        te.task_execution_id,\n        te.execution_status, \n        te.environment_id,\n        te.source_environment_id,\n        CASE\n           WHEN te.source_environment_id = -1 THEN 'Rule-based SDG'\n           WHEN te.source_environment_id = -2 THEN 'AI-based SDG'\n           ELSE te.source_env_name\n        END AS source_env_name,\n       CASE\n           WHEN te.environment_id = -1 THEN 'Rule-based SDG'\n           WHEN te.environment_id = -2 THEN 'AI-based SDG'       \n  \t\t   ELSE e.environment_name\n        END AS tar_env_name,  \n       -- te.source_env_name,\n        (te.environment_id = te.source_environment_id) AS equal_src_and_tar,\n        te.tot_num_of_processed_root_entities AS no_of_processed_entities,\n\t -- % per execution\t\n       -- COALESCE(100.0 * te.tot_num_of_failed_root_entities\n       --           / NULLIF(te.tot_num_of_processed_root_entities, 0), 0) \n       COALESCE(te.tot_num_of_failed_root_entities / NULLIF(te.tot_num_of_processed_root_entities, 0), 0) AS failed_entities_pct ,\n     -- execution time per entity in sec \n       (\n            EXTRACT(EPOCH FROM \n             --       (te.end_execution_time - te.start_execution_time))\n              (CASE\n            \t\tWHEN te.end_be_execution IS NOT NULL AND te.start_be_execution IS NOT NULL THEN te.end_be_execution - te.start_be_execution\n            \t\tELSE te.end_execution_time - te.start_execution_time\n        \t   END ))      \n            / NULLIF(te.tot_num_of_processed_root_entities, 0)\n        ) AS exec_time_per_entity_sec,\n        te.be_id,\n        COALESCE(be.be_name, 'N/A') AS be_name,\n        CASE \n   \t\t\tWHEN t.in_place_masking_ind = true THEN 'In-place masking'\n            WHEN te.task_type = 'EXTRACT' THEN 'Extract'\n            WHEN te.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' AND t.delete_before_load = true THEN 'Extract & Delete & Load'  \n            WHEN te.task_type = 'LOAD' AND te.source_environment_id < 0 AND t.SELECTION_METHOD not in ('GENERATE', 'AI_GENERATED')  \n                     THEN 'Load SDG entities' \n            WHEN te.task_type = 'LOAD' AND t.selection_method = 'GENERATE' THEN 'Rule-based SDG & Load' \n            WHEN te.task_type = 'LOAD' AND t.sync_mode <> 'OFF' THEN 'Extract & Load'\n            WHEN te.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = false THEN 'Load & Reserve'\n            WHEN te.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = true THEN 'Load & Reserve & Delete'\n            WHEN te.task_type = 'LOAD' AND t.reserve_ind = false AND t.delete_before_load = true THEN 'Load & Delete'\n            WHEN te.task_type = 'DELETE' THEN 'Delete'\n            WHEN te.task_type = 'RESERVE' THEN 'Reserve'\n            WHEN te.task_type = 'TRAINING' THEN 'AI training'\n            WHEN te.task_type = 'GENERATE' THEN 'Rule-based SDG'\n            WHEN te.task_type = 'AI_GENERATED' THEN 'AI-based SDG'\n            ELSE te.task_type\n        END AS task_type,\n        te.task_type AS orig_task_type,\n        t.in_place_masking_ind\n    FROM \"${TDMDB_SCHEMA}\".task_execution_summary te\n    JOIN \"${TDMDB_SCHEMA}\".tasks t\n      ON te.task_id = t.task_id\n   JOIN \"${TDMDB_SCHEMA}\".environments e\n         ON te.environment_id = e.environment_id \n   JOIN \"${TDMDB_SCHEMA}\".business_entities be\n      ON te.be_id = be.be_id\n    WHERE -- te.start_execution_time >= DATE '${FROM_DATE}' AND te.start_execution_time <  DATE '${END_DATE}' + 1 \n    task_execution_id >= ${minTaskExeID} and task_execution_id <= ${maxTaskExeID}\n)\nSELECT\n    fe.tar_env_name AS environment_name,\n    CASE\n        WHEN fe.equal_src_and_tar THEN 'Source & target'\n        ELSE 'Target'\n    END AS env_type,\n    COUNT(*) AS total_no_of_executions,\n    SUM(no_of_processed_entities) AS total_no_of_processed_entities,\n\tROUND(AVG(no_of_processed_entities)) as AVG_no_of_entities_per_exe,\n\tROUND(AVG(failed_entities_pct),2) as AVG_failed_entities_pct,\n    COALESCE(ROUND(AVG(exec_time_per_entity_sec)), 0)  as AVG_exe_time_per_entity_in_sec,\n    fe.task_type,\n --   fe.processed_data,\n    fe.be_name\n  --  fe.execution_status \nFROM filtered_executions fe\nJOIN \"${TDMDB_SCHEMA}\".environments e\n  ON fe.environment_id = e.environment_id  \nWHERE (fe.orig_task_type IN ('DELETE', 'RESERVE', 'LOAD', 'TRAINING') OR fe.in_place_masking_ind = true) \n   AND ('${ENV_NAME}' = 'ALL_ENV' or e.environment_name = '${ENV_NAME}')\nGROUP BY\n    fe.tar_env_name,\n    fe.equal_src_and_tar,\n    fe.task_type,\n --   fe.processed_data,\n    fe.be_name \n --   fe.execution_status \n -- Source env query\nUNION ALL\nSELECT fe.source_env_name AS environment_name,\n    'Source' AS env_type,\n    COUNT(*) AS total_no_of_executions,\n    SUM(no_of_processed_entities) AS total_no_of_processed_entities,\n\tROUND(AVG(no_of_processed_entities)) as AVG_no_of_entities_per_exe,\n\tROUND(AVG(failed_entities_pct),2) as AVG_failed_entities_pct,\n\tCOALESCE(ROUND(AVG(exec_time_per_entity_sec)), 0) as AVG_exe_time_per_entity_in_sec,\n    fe.task_type,\n --   fe.processed_data,\n    fe.be_name\n --   fe.execution_status\nFROM filtered_executions fe\nWHERE fe.orig_task_type NOT IN ('DELETE', 'RESERVE') \nAND (fe.orig_task_type in ('EXTRACT', 'GENERATE', 'AI_GENERATED') or fe.equal_src_and_tar = false)\n--AND fe.equal_src_and_tar = false\n  AND fe.in_place_masking_ind = false \n  AND  ('${ENV_NAME}' = 'ALL_ENV' or fe.source_env_name  = '${ENV_NAME}')\nGROUP BY\n    fe.source_env_name,\n    fe.task_type,\n--    fe.processed_data,\n    fe.be_name \n --   fe.execution_status \nORDER BY total_no_of_executions DESC;",
      "sessionProvider": "TDM"
    },
    {
      "name": "EnvTableExeStats",
      "type": "sqlNonPrepared",
      "code": "WITH filtered_executions AS (\n    SELECT\n        te.task_execution_id,\n        te.execution_status, \n        te.environment_id,\n        te.source_environment_id,\n        te.source_env_name,\n        (te.environment_id = te.source_environment_id) AS equal_src_and_tar,\n\t-- counts per execution\n        te.tot_num_of_processed_ref_tables::numeric  AS no_of_processed_tables,\n    -- % per execution\n       \n        --COALESCE(100.0 * te.tot_num_of_failed_ref_tables\n  \t\tCOALESCE(te.tot_num_of_failed_ref_tables\n                  / NULLIF(te.tot_num_of_processed_ref_tables, 0),\n            0\n        ) AS failed_tables_pct, \n    \n        te.be_id,\n        COALESCE(be.be_name, 'N/A') AS be_name,    \n        CASE\n            WHEN t.in_place_masking_ind = true THEN 'In-place masking' \n  \t\t\tWHEN te.task_type = 'EXTRACT' THEN 'Extract' \n            WHEN te.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' AND t.delete_before_load = true THEN 'Extract & Delete & Load'  \n            WHEN te.task_type = 'LOAD' AND t.sync_mode <> 'OFF' THEN 'Extract & Load'\n          --  WHEN te.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = false THEN 'Load & Reserve'\n          --  WHEN te.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = true THEN 'Load & Reserve & Delete'\n            WHEN te.task_type = 'LOAD' AND t.reserve_ind = false AND t.delete_before_load = true THEN 'Load & Delete'\n            WHEN te.task_type = 'DELETE' THEN 'Delete'\n            ELSE te.task_type\n        END AS task_type,\n        te.task_type AS orig_task_type,\n        t.in_place_masking_ind\n    FROM \"${TDMDB_SCHEMA}\".task_execution_summary te\n    JOIN \"${TDMDB_SCHEMA}\".tasks t\n      ON te.task_id = t.task_id\n    LEFT JOIN \"${TDMDB_SCHEMA}\".business_entities be\n      ON te.be_id = be.be_id\n      WHERE -- te.start_execution_time >= DATE '${FROM_DATE}' AND te.start_execution_time <  DATE '${END_DATE}' + 1  \n   task_execution_id >= ${minTaskExeID} and task_execution_id <= ${maxTaskExeID} \n   AND te.tot_num_of_processed_ref_tables > 0  \n)\nSELECT\n    e.environment_name,\n    CASE\n        WHEN fe.equal_src_and_tar THEN 'Source & target'\n        ELSE 'Target'\n    END AS env_type,\n    COUNT(*) AS total_no_of_executions,\n    SUM(no_of_processed_tables) AS total_no_of_processed_tables,\n\tROUND(AVG(no_of_processed_tables)) as AVG_no_of_tables_per_exe,\n\tROUND(AVG(failed_tables_pct) ,2) as AVG_failed_tables_pct,\n    fe.task_type,\n--   fe.processed_data,\n    fe.be_name\n--    fe.execution_status \nFROM filtered_executions fe\nJOIN \"${TDMDB_SCHEMA}\".environments e\n  ON fe.environment_id = e.environment_id  \nWHERE (fe.orig_task_type IN ('DELETE', 'RESERVE', 'LOAD', 'TRAINING') OR fe.in_place_masking_ind = true) \n   AND ('${ENV_NAME}' = 'ALL_ENV' or e.environment_name = '${ENV_NAME}')\nGROUP BY\n     e.environment_name,\n    fe.equal_src_and_tar,\n    fe.task_type,\n--    fe.processed_data,\n    fe.be_name \n--    fe.execution_status\n-- Source env query \nUNION ALL\nSELECT fe.source_env_name AS environment_name,\n    'Source' AS env_type,\n    COUNT(*) AS total_no_of_executions,\n   SUM(no_of_processed_tables) AS total_no_of_processed_tables,\n\tROUND(AVG(no_of_processed_tables)) as AVG_no_of_tables_per_exe,\n\tROUND(AVG(failed_tables_pct), 2) as AVG_failed_tables_pct,\n\tfe.task_type,\n--    fe.processed_data,\n    fe.be_name \n--    fe.execution_status\nFROM filtered_executions fe\nWHERE fe.orig_task_type NOT IN ('DELETE', 'RESERVE') \nAND (fe.orig_task_type in ('EXTRACT', 'GENERATE', 'AI_GENERATED') or fe.equal_src_and_tar = false) \n--AND fe.equal_src_and_tar = false\n  AND fe.in_place_masking_ind = false \n  AND  ('${ENV_NAME}' = 'ALL_ENV' or fe.source_env_name  = '${ENV_NAME}')\nGROUP BY\n    fe.source_env_name,\n    fe.task_type,\n--    fe.processed_data,\n    fe.be_name \n--    fe.execution_status \nORDER BY total_no_of_executions DESC;\t\n\t\n",
      "sessionProvider": "TDM"
    },
    {
      "name": "ExecutionsPerBE&SelectionMethod",
      "type": "sqlNonPrepared",
      "code": "WITH filtered_executions AS (\n    SELECT\n        te.task_execution_id,\n        te.environment_id,\n        te.source_environment_id,\n        CASE\n           WHEN te.source_environment_id = -1 THEN 'Rule-based SDG'\n           WHEN te.source_environment_id = -2 THEN 'AI-based SDG'\n           ELSE te.source_env_name\n        END AS source_env_name,\n       CASE\n           WHEN te.environment_id = -1 THEN 'Rule-based SDG'\n           WHEN te.environment_id = -2 THEN 'AI-based SDG'       \n  \t\t   ELSE e.environment_name\n        END AS tar_env_name,  \n        (te.environment_id = te.source_environment_id) AS equal_src_and_tar,\n        te.tot_num_of_processed_root_entities AS no_of_processed_entities,\n        te.tot_num_of_processed_ref_tables   AS no_of_processed_tables,\n        te.be_id,\n        COALESCE(be.be_name, 'N/A') AS be_name,\n        CASE\n            WHEN te.task_type = 'EXTRACT' THEN 'Extract' \n            WHEN te.task_type = 'LOAD'  AND t.sync_mode <> 'OFF' AND t.delete_before_load = true THEN 'Extract & Delete & Load'  \n  \t\t\tWHEN te.task_type = 'LOAD' AND te.source_environment_id < 0 AND t.SELECTION_METHOD not in ('GENERATE', 'AI_GENERATED')  \n                     THEN 'Load SDG entities' \n            WHEN te.task_type = 'LOAD' AND t.selection_method = 'GENERATE' THEN 'Rule-based SDG & Load'           \n  \t\t\tWHEN te.task_type = 'LOAD' AND t.sync_mode <> 'OFF' THEN 'Extract & Load'\n            WHEN te.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = false THEN 'Load & Reserve'\n            WHEN te.task_type = 'LOAD' AND t.reserve_ind = true AND t.delete_before_load = true THEN 'Load & Reserve & Delete'\n            WHEN te.task_type = 'LOAD' AND t.reserve_ind = false AND t.delete_before_load = true THEN 'Load & Delete' \n            WHEN te.task_type = 'LOAD' THEN 'Load' \n            WHEN te.task_type = 'DELETE' THEN 'Delete only'\n            WHEN te.task_type = 'RESERVE' THEN 'Reserve only'\n            WHEN te.task_type = 'TRAINING' THEN 'AI training'\n            WHEN te.task_type = 'GENERATE' THEN 'Rule-based SDG'\n            WHEN te.task_type = 'AI_GENERATED' THEN 'AI-based SDG'\n            ELSE te.task_type\n        END AS task_type,\n        te.task_type AS orig_task_type,\n        CASE \n        \tWHEN t.selection_method = 'ALL' and t.be_id >= 0 THEN 'Predefined entity list' \n        \tWHEN t.selection_method = 'TABLES' THEN 'Tables'\n        \tWHEN t.selection_method = 'C'  THEN 'Custom logic' \n        \tWHEN t.selection_method = 'L' THEN 'Entity list' \n        \tWHEN t.selection_method in ('P', 'PR') THEN 'Business parameters' \n        \tWHEN t.selection_method = 'GENERATE_SUBSET' THEN 'Load pre-generated subset' \n        \tWHEN t.selection_method ='R' THEN 'Random list'  \n        \tWHEN t.selection_method = 'GENERATE' THEN 'Synthetic generation'\n        \tELSE t.selection_method \n    \tEND as selection_method   \n    FROM \"${TDMDB_SCHEMA}\".task_execution_summary te\n    JOIN \"${TDMDB_SCHEMA}\".tasks t\n      ON te.task_id = t.task_id\n    JOIN \"${TDMDB_SCHEMA}\".environments e\n         ON te.environment_id = e.environment_id \n    JOIN \"${TDMDB_SCHEMA}\".business_entities be\n      ON te.be_id = be.be_id\n    WHERE -- te.start_execution_time >= DATE '${FROM_DATE}' AND te.start_execution_time <  DATE '${END_DATE}' + 1\n   task_execution_id >= ${minTaskExeID} and task_execution_id <= ${maxTaskExeID}\n)\nSELECT\n    fe.tar_env_name AS environment_name,  \n    CASE\n        WHEN fe.equal_src_and_tar THEN 'Source & target'\n        ELSE 'Target'\n    END AS env_type,\n     COUNT(*) AS total_no_of_executions,\n     SUM(no_of_processed_entities) AS total_no_of_processed_entities,\n --   SUM(no_of_processed_tables)   AS no_of_processed_tables,\n    fe.task_type,\n    fe.be_name,\n    fe.selection_method\nFROM filtered_executions fe\nWHERE fe.orig_task_type IN ('DELETE', 'RESERVE', 'LOAD', 'TRAINING')  \n   AND ('${ENV_NAME}' = 'ALL_ENV' or fe.tar_env_name = '${ENV_NAME}')\nGROUP BY\n    fe.tar_env_name, \n    fe.equal_src_and_tar,\n    fe.task_type,\n    fe.be_name,\n    fe.selection_method\nUNION ALL\n-- Source env query \nSELECT\n     fe.source_env_name AS environment_name,\n    'Source' AS env_type,\n     COUNT(*) AS total_no_of_executions,\n \t SUM(no_of_processed_entities) AS total_no_of_processed_entities,\n--    SUM(no_of_processed_tables)   AS no_of_processed_tables,\n    fe.task_type,\n    fe.be_name,\n    fe.selection_method\nFROM filtered_executions fe\nWHERE fe.orig_task_type NOT IN ('DELETE', 'RESERVE') \nAND (fe.orig_task_type in ('EXTRACT', 'GENERATE', 'AI_GENERATED') or fe.equal_src_and_tar = false) \n-- AND fe.equal_src_and_tar = false\n  AND  ('${ENV_NAME}' = 'ALL_ENV' or fe.source_env_name  = '${ENV_NAME}')\nGROUP BY\n    fe.source_env_name,\n    fe.task_type,\n    fe.be_name ,\n    fe.selection_method\n ORDER BY total_no_of_executions DESC;",
      "sessionProvider": "TDM"
    },
    {
      "name": "ProvisionedSystemsPerEnv",
      "type": "sqlNonPrepared",
      "code": "WITH executions_per_system AS (\n    -- First source - entity level executions\n    SELECT\n        env.environment_id,\n        CASE \n            WHEN env.environment_id = -2 THEN 'AI-based SDG'\n            ELSE env.environment_name\n        END AS environment_name,\n        pl.product_name AS system_name,\n        COUNT(DISTINCT e.task_execution_id) AS no_of_executions\n    FROM \"${TDMDB_SCHEMA}\".task_execution_summary e\n    JOIN \"${TDMDB_SCHEMA}\".tasks_logical_units tl\n        ON e.task_id = tl.task_id\n    JOIN \"${TDMDB_SCHEMA}\".product_logical_units pl\n        ON tl.lu_id = pl.lu_id\n    JOIN \"${TDMDB_SCHEMA}\".environments env\n        ON e.environment_id = env.environment_id\n    WHERE e.task_type = 'LOAD'\n      AND -- e.start_execution_time >= DATE '${FROM_DATE}' AND e.start_execution_time <  DATE '${END_DATE}' + 1 \n    e.task_execution_id >= ${minTaskExeID} and e.task_execution_id <= ${maxTaskExeID}\n    GROUP BY env.environment_id, env.environment_name, pl.product_name\n\n    UNION ALL\n\n    -- Second source- table level executions - we need the task_ref_exe_stats to have a join with task_ref_tables and get the interface names for the systems\n    SELECT\n        env.environment_id,\n        CASE \n            WHEN env.environment_id = -2 THEN 'AI-based SDG'\n            ELSE env.environment_name\n        END AS environment_name,\n        p.product_name AS system_name,\n        COUNT(DISTINCT e.task_execution_id) AS no_of_executions\n    FROM \"${TDMDB_SCHEMA}\".task_ref_exe_stats e\n    JOIN \"${TDMDB_SCHEMA}\".task_ref_tables t\n        ON e.task_ref_table_id = t.task_ref_table_id\n    JOIN (\n        SELECT\n            unnest(related_interfaces) AS interface_name,\n            product_id,\n            product_name\n        FROM \"${TDMDB_SCHEMA}\".products\n    ) p\n        ON t.interface_name = p.interface_name\n    JOIN \"${TDMDB_SCHEMA}\".task_execution_summary te\n        ON e.task_execution_id = te.task_execution_id\n    JOIN \"${TDMDB_SCHEMA}\".tasks ta\n        ON e.task_id = ta.task_id\n    JOIN \"${TDMDB_SCHEMA}\".environments env\n        ON te.environment_id = env.environment_id\n    WHERE ta.task_type = 'LOAD'\n      AND -- e.start_time >= DATE '${FROM_DATE}' AND e.start_time <  DATE '${END_DATE}' + 1 \n   e.task_execution_id >= ${minTaskExeID} and e.task_execution_id <= ${maxTaskExeID}  \n  GROUP BY env.environment_id, env.environment_name, p.product_name\n)\n\nSELECT\n    environment_name,\n    system_name,\n    SUM(no_of_executions) AS total_executions\nFROM executions_per_system\nGROUP BY environment_name, system_name\nORDER BY environment_name, total_executions DESC, system_name;\n",
      "sessionProvider": "TDM"
    }
  ],
  "params": [
    {
      "name": "TDMDB_SCHEMA",
      "dataType": "String",
      "description": "",
      "mandatory": true
    },
    {
      "name": "FROM_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": true
    },
    {
      "name": "END_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": true
    },
    {
      "name": "ENV_NAME",
      "dataType": "String",
      "description": "",
      "mandatory": true
    }
  ],
  "description": "",
  "exposeAsEndpoint": true,
  "path": "",
  "requireAuth": true,
  "additionalPermissions": []
}