{
  "name": "USER_LOGIN_REPORT_LEVEL_1",
  "serializerSettings": [
    {
      "set": "nice",
      "value": "true"
    }
  ],
  "children": [
    {
      "name": "FabricRolesAndPermissionGroups",
      "type": "sqlNonPrepared",
      "code": "select fabric_role as user_group, permission_group \n\tfrom \"${TDMDB_SCHEMA}\".permission_groups_mapping;",
      "sessionProvider": "TDM"
    },
    {
      "name": "Top5UserActivities",
      "type": "sqlNonPrepared",
      "code": " WITH top_users AS (\n select username, sum(no_of_executions) as no_of_executions \n from\n (SELECT username, count(*) no_of_executions \n  FROM \"${TDMDB_SCHEMA}\".activities\n  WHERE date >= DATE '${FROM_DATE}' and date <= DATE '${END_DATE}' + 1 \n -- and NOT (action = 'update' and entity = 'Tasks' and starts_with( lower(description), 'execution') = true )\n  GROUP BY username \n--UNION ALL  \n-- select task_executed_by AS username, count(*) no_of_executions \n--\t\tFROM \"${TDMDB_SCHEMA}\".task_execution_summary\n--\t\tWHERE start_execution_time >= DATE '${FROM_DATE}' and start_execution_time <= DATE '${END_DATE}' + 1 \n-- group by task_executed_by\n ) a\n group by username \n order by no_of_executions desc \n limit 5\n)\nSELECT\n  a.username, a.activity_desc, a.no_of_activities \n  from \n  (SELECT a.username, a.no_of_activities, a.activity_desc \n  from\n  (select username,\n    CASE\n      WHEN  action = 'update' and entity in ('Environment', 'Environments') THEN 'Update Envs' \n      WHEN entity = 'Product' THEN initcap(action) || ' Systems' \n      WHEN action = 'update' and entity = 'Tasks' and starts_with( lower(description), 'execution') = true THEN 'Execute Tasks' \n      WHEN action = 'delete' and entity = 'Reserved Entities' THEN 'Release Reserved BEs' \n      WHEN entity = 'Environments' THEN initcap(action) || ' Envs' \n      WHEN entity = 'Business entities' THEN initcap(action) || ' BEs' \n\t  ELSE  initcap(action) || ' ' || entity\n    END AS activity_desc,\n    count(*) as no_of_activities \n    from \"${TDMDB_SCHEMA}\".activities  \n    where date >= DATE '${FROM_DATE}' and date <= DATE '${END_DATE}' + 1  \n   -- and NOT (action = 'Update' and entity = 'Tasks' and starts_with( lower(description), 'execution') = true) \n    group by username, activity_desc) a \n   -- UNION ALL \n   -- select task_executed_by as username , count(*) as no_of_activities, 'Execute Tasks' as activity_desc  \n   -- from \"${TDMDB_SCHEMA}\".task_execution_summary \n   -- where start_execution_time >= DATE '${FROM_DATE}' and start_execution_time <= DATE '${END_DATE}' + 1 \n   -- group by task_executed_by\n  ) a \n JOIN top_users u\n  ON a.username = u.username\norder by no_of_activities desc;",
      "sessionProvider": "TDM"
    },
    {
      "name": "TDMActivities",
      "type": "sqlNonPrepared",
      "code": "SELECT \n  CASE\n    WHEN  action = 'update' and entity in ('Environment', 'Environments') THEN 'Update Envs' \n    WHEN action = 'update' AND entity = 'Tasks' and starts_with( lower(description), 'execution') = true THEN 'Execute Tasks' \n    WHEN entity = 'Product' THEN initcap(action) || ' Systems' \n    WHEN action = 'delete' and entity = 'Reserved Entities' THEN 'Release Reserved BEs' \n    WHEN entity = 'Environments' THEN initcap(action) || ' Envs' \n    WHEN entity = 'Business entities' THEN initcap(action) || ' BEs' \n    ELSE initcap(action) || ' ' || entity\n  END AS activity_desc,\nCOUNT(*) AS no_of_activities \nFROM \"${TDMDB_SCHEMA}\".activities\nWHERE date >= DATE '${FROM_DATE}' and date <= DATE '${END_DATE}' + 1 \nGROUP BY\n  activity_desc;\n",
      "sessionProvider": "TDM"
    },
    {
      "name": "TaskCreatorsAndExecutorsDuringReportPeriod",
      "type": "sqlNonPrepared",
      "code": "SELECT count(DISTINCT task_creator) as no_of_task_creators, count(DISTINCT task_runner) as no_of_task_runners\n\tFROM (\n\t\tSELECT split_part(task_created_by, '##', 1) AS task_creator\n\t\tFROM \"${TDMDB_SCHEMA}\".tasks\n\t\tWHERE task_last_updated_date >= DATE '${FROM_DATE}'\n        AND task_last_updated_date <= DATE '${END_DATE}' + 1) task,  \n\t\t(SELECT task_executed_by AS task_runner \n\t\tFROM \"${TDMDB_SCHEMA}\".task_execution_summary\n\t\tWHERE start_execution_time >= DATE '${FROM_DATE}' \n        AND start_execution_time <= DATE '${END_DATE}' + 1) exe;\n",
      "sessionProvider": "TDM"
    }
  ],
  "params": [
    {
      "name": "FROM_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": true
    },
    {
      "name": "TDMDB_SCHEMA",
      "dataType": "String",
      "description": "",
      "mandatory": true
    },
    {
      "name": "END_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": true
    }
  ],
  "description": "",
  "exposeAsEndpoint": true,
  "path": "",
