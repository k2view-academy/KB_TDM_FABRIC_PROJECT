{
  "name": "USER_LOGIN_REPORT_LEVEL_1",
  "serializerSettings": [
    {
      "set": "nice",
      "value": "true"
    }
  ],
  "children": [
    {
      "name": "BindHelper",
      "type": "function",
      "code": "var bind = function (name) { return '${' + name + '}'; };"
    },
    {
      "name": "TDMDBSchema",
      "type": "function",
      "code": "var TDMDB_SCHEMA;"
    },
    {
      "name": "GetTDMDBSchemaName",
      "type": "sql",
      "code": "broadway k2_ws.getTDMDBSchema",
      "sessionProvider": "fabric",
      "children": [
        {
          "name": "TDMDB_SCHEMA",
          "type": "function",
          "code": "if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(String(schema))) throw new Error('Invalid TDM DB schema');\nTDMDB_SCHEMA = String(schema);"
        }
      ]
    },
    {
      "name": "ValidateDates",
      "type": "function",
      "code": "if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(String(FROM_DATE))) throw new Error('Invalid FROM_DATE - expected yyyy-MM-dd');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(String(END_DATE))) throw new Error('Invalid END_DATE - expected yyyy-MM-dd');"
    },
    {
      "name": "FabricRolesAndPermissionGroups",
      "type": "sqlNonPrepared",
      "code": "select fabric_role as user_group, permission_group\n\tfrom \"${TDMDB_SCHEMA}\".permission_groups_mapping;",
      "sessionProvider": "TDM"
    },
    {
      "name": "Top5UserActivities",
      "type": "sqlNonPrepared",
      "code": " WITH top_users AS (\n select username, sum(no_of_executions) as no_of_executions\n from\n (SELECT username, count(*) no_of_executions\n  FROM \"${TDMDB_SCHEMA}\".activities\n  WHERE date >= ${bind('FROM_DATE')}::date and date <= ${bind('END_DATE')}::date + 1\n  GROUP BY username\n ) a\n group by username\n order by no_of_executions desc\n limit 5\n)\nSELECT\n  a.username, a.activity_desc, a.no_of_activities\n  from\n  (SELECT a.username, a.no_of_activities, a.activity_desc\n  from\n  (select username,\n    CASE\n      WHEN  action = 'update' and entity in ('Environment', 'Environments') THEN 'Update Envs'\n      WHEN entity = 'Product' THEN initcap(action) || ' Systems'\n      WHEN action = 'update' and entity = 'Tasks' and starts_with( lower(description), 'execution') = true THEN 'Execute Tasks'\n      WHEN action = 'delete' and entity = 'Reserved Entities' THEN 'Release Reserved BEs'\n      WHEN entity = 'Environments' THEN initcap(action) || ' Envs'\n      WHEN entity = 'Business entities' THEN initcap(action) || ' BEs'\n\t  ELSE  initcap(action) || ' ' || entity\n    END AS activity_desc,\n    count(*) as no_of_activities\n    from \"${TDMDB_SCHEMA}\".activities\n    where date >= ${bind('FROM_DATE')}::date and date <= ${bind('END_DATE')}::date + 1\n    group by username, activity_desc) a\n  ) a\n JOIN top_users u\n  ON a.username = u.username\norder by no_of_activities desc;",
      "sessionProvider": "TDM"
    },
    {
      "name": "TDMActivities",
      "type": "sqlNonPrepared",
      "code": "SELECT\n  CASE\n    WHEN  action = 'update' and entity in ('Environment', 'Environments') THEN 'Update Envs'\n    WHEN action = 'update' AND entity = 'Tasks' and starts_with( lower(description), 'execution') = true THEN 'Execute Tasks'\n    WHEN entity = 'Product' THEN initcap(action) || ' Systems'\n    WHEN action = 'delete' and entity = 'Reserved Entities' THEN 'Release Reserved BEs'\n    WHEN entity = 'Environments' THEN initcap(action) || ' Envs'\n    WHEN entity = 'Business entities' THEN initcap(action) || ' BEs'\n    ELSE initcap(action) || ' ' || entity\n  END AS activity_desc,\nCOUNT(*) AS no_of_activities\nFROM \"${TDMDB_SCHEMA}\".activities\nWHERE date >= ${bind('FROM_DATE')}::date and date <= ${bind('END_DATE')}::date + 1\nGROUP BY\n  activity_desc;",
      "sessionProvider": "TDM"
    },
    {
      "name": "TaskCreatorsAndExecutorsDuringReportPeriod",
      "type": "sqlNonPrepared",
      "code": "SELECT count(DISTINCT task_creator) as no_of_task_creators, count(DISTINCT task_runner) as no_of_task_runners\n\tFROM (\n\t\tSELECT split_part(task_created_by, '##', 1) AS task_creator\n\t\tFROM \"${TDMDB_SCHEMA}\".tasks\n\t\tWHERE task_last_updated_date >= ${bind('FROM_DATE')}::date\n        AND task_last_updated_date <= ${bind('END_DATE')}::date + 1) task,\n\t\t(SELECT task_executed_by AS task_runner\n\t\tFROM \"${TDMDB_SCHEMA}\".task_execution_summary\n\t\tWHERE start_execution_time >= ${bind('FROM_DATE')}::date\n        AND start_execution_time <= ${bind('END_DATE')}::date + 1) exe;",
      "sessionProvider": "TDM"
    }
  ],
  "params": [
    {
      "name": "FROM_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": true
    },
    {
      "name": "TDMDB_SCHEMA",
      "dataType": "String",
      "description": "Ignored - the TDM DB schema is taken from the TDM.TDMDB_SCHEMA Fabric global",
      "mandatory": false
    },
    {
      "name": "END_DATE",
      "dataType": "String",
      "description": "",
      "mandatory": true
    }
  ],
  "description": "",
  "exposeAsEndpoint": true,
  "path": "",
  "requireAuth": true,
  "additionalPermissions": []
}