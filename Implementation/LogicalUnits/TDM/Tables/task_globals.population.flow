stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          task_id:
            external: task_id
            schema: any
            mandatory: false
          global_name:
            external: global_name
            schema: any
            mandatory: false
          global_value:
            external: global_value
            schema: any
            mandatory: false
          is_editable:
            external: is_editable
            schema: any
            mandatory: false
      SyncDeleteMode:
        parent: SyncDeleteMode
        in:
          interface:
            schema: any
          table:
            const: null
            external: table
      getTDMDBSchema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
  Source:
    actors:
      Query:
        parent: SourceDbQuery
        in:
          interface:
            const: TDM
          sql:
            const: select * from ${@TDMDB_SCHEMA}.task_globals
          TDMDB_SCHEMA:
            link: getTDMDBSchema/schema
            schema: any
            mandatory: false
            createdBy: sql
          parent_rows:
            link: PopulationArgs/parent_rows
        out:
          result:
            schema: '#ref'
  LU Table:
    last: 1
    actors:
      task_globals:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
            - task_id
            - global_name
            - global_value
            - is_editable
          keys:
            const: null
          dialect:
            const: sqlite
          task_id:
            schema: any
          global_name:
            schema: any
          global_value:
            schema: any
          is_editable:
            schema: any
          params:
            link:
              path: Query/result
              iterate: Iterate
  Post Load: {
    }
schemas:
  Query.out.result:
    type: object
    properties:
      task_id:
        type: {
          }
      global_name:
        type: {
          }
      global_value:
        type: {
          }
      is_editable:
        type: {
          }
