stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          task_execution_id:
            external: task_execution_id
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
      SyncDeleteMode:
        parent: SyncDeleteMode
        in:
          interface:
            schema: any
          table:
            const: null
            external: table
      getTDMDBSchema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
  Source:
    actors:
      Query:
        parent: SourceDbQuery
        in:
          interface:
            const: TDM
          sql:
            const: |-
              select exe.task_execution_id, exe.task_ref_table_id, exe.ref_table_name, exe.execution_status, exe.execution_action,
              exe.number_of_records_to_process, exe.number_of_processed_records, exe.number_of_failed_records, exe.error_msg, ref.lu_name,
              exe.start_time , exe.end_time, exe.interface_name, exe.schema_name ,
              exe.table_filter, exe.filter_type, exe.filter_parameters ,ref.version_task_execution_id, exe.batch_id as batch_id
              from ${@TDMDB_SCHEMA}.task_ref_exe_stats exe inner join ${@TDMDB_SCHEMA}.task_ref_tables ref on ref.task_id=exe.task_id
              and ref.ref_table_name = exe.ref_table_name and ref.schema_name = exe.schema_name and ref.interface_name=exe.interface_name
          TDMDB_SCHEMA:
            link: getTDMDBSchema/schema
            schema: string
            mandatory: false
          parent_rows:
            link: PopulationArgs/parent_rows
        out:
          result:
            schema: '#ref'
  LU Table:
    last: 1
    actors:
      task_ref_exe_stats:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: TDM
          table:
            const: task_ref_exe_stats
          fields:
            const:
            - task_execution_id
            - task_ref_table_id
            - ref_table_name
            - execution_status
            - number_of_records_to_process
            - number_of_processed_records
            - number_of_failed_records
            - error_msg
            - lu_name
            - start_time
            - end_time
            - table_filter
            - filter_type
            - filter_parameters
            - version_task_execution_id
            - batch_id
            - execution_action
            - schema_name
            - interface_name
          dialect:
            const: sqlite
          task_execution_id:
            schema: '#ref'
          task_ref_table_id:
            schema: '#ref'
          ref_table_name:
            schema: '#ref'
          execution_status:
            schema: '#ref'
          number_of_records_to_process:
            schema: '#ref'
          number_of_processed_records:
            schema: '#ref'
          error_msg:
            schema: '#ref'
          lu_name:
            schema: string
            mandatory: false
          start_time:
            schema: any
            mandatory: false
          end_time:
            schema: any
            mandatory: false
          table_filter:
            schema: any
          filter_type:
            schema: any
          filter_parameters:
            schema: any
          version_task_execution_id:
            schema: any
          number_of_failed_records:
            schema: any
            mandatory: false
          batch_id:
            schema: any
          execution_action:
            schema: any
            mandatory: false
            createdBy: fields
          schema_name:
            schema: any
          interface_name:
            schema: any
          params:
            link:
              path: Query/result
              iterate: Iterate
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        task_execution_id:
          type: string
  Query.out.result:
    type: array
    items:
      type: object
      properties:
        task_execution_id:
          type: integer
        task_ref_table_id:
          type: integer
        ref_table_name:
          type: string
        execution_status:
          type: string
        execution_action:
          type: string
        number_of_records_to_process:
          type: integer
        number_of_processed_records:
          type: integer
        number_of_failed_records:
          type: integer
        error_msg:
          type: string
        lu_name:
          type: string
        start_time:
          type: date
        end_time:
          type: date
        table_filter:
          type: string
        filter_type:
          type: string
        filter_parameters:
          type: string
        version_task_execution_id:
          type: integer
        batch_id:
          type: string
  task_ref_exe_stats.in.task_execution_id:
    type: array
    items:
      type: integer
  task_ref_exe_stats.in.task_ref_table_id:
    type: array
    items:
      type: integer
  task_ref_exe_stats.in.ref_table_name:
    type: array
    items:
      type: string
  task_ref_exe_stats.in.execution_status:
    type: array
    items:
      type: string
  task_ref_exe_stats.in.number_of_records_to_process:
    type: array
    items:
      type: integer
  task_ref_exe_stats.in.number_of_processed_records:
    type: array
    items:
      type: integer
  task_ref_exe_stats.in.error_msg:
    type: array
    items: {
      }
