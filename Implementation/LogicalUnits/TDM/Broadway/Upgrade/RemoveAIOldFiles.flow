tags: Upgrade
stages:
  Get Path:
    actors:
      PROJECT_DIR:
        parent: SysEnv
        in:
          name:
            const: PROJECT_DIR
        out:
          value:
            schema: string
      Get Project Folder:
        parent: InnerFlow
        in:
          flowName:
            const: GetProjectFolder
        out:
          PROJECT_FOLDER:
            schema: string
  Build AI Path:
    actors:
      AI Folder Path:
        parent: StringFormat
        in:
          format:
            const: ${projDir}/Implementation/SharedObjects/Broadway/TDM/AI/
          projDir:
            link: PROJECT_DIR/value
            schema: string
            mandatory: false
      AI Folder Path1:
        parent: StringFormat
        in:
          format:
            const: ${projDir}/SharedObjects/Broadway/TDM/AI/
          projDir:
            link: Get Project Folder/PROJECT_FOLDER
            schema: string
            mandatory: false
  Check If Studio:
    actors:
      Studio Present?:
        parent: NotNull
        condition: result
        in:
          value:
            link: PROJECT_DIR/value
      ls:
        parent: ls
        in:
          interface:
            const: null
            link: AI Folder Path1/string
          path:
            const: .
          directories:
            const: true
        out:
          result:
            schema: '#ref'
  Get Files:
    actors:
      ${path}/${file}:
        parent: StringFormat
        in:
          format:
            const: ${path}${file}
          path:
            link: AI Folder Path/string
            schema: string
            mandatory: false
            createdBy: format
          file:
            link:
              path: ls/result/name
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: format
  Remove Files Infra:
    dependsOn: Get Files
    actors:
      Equals AI:
        parent: Equals
        condition: result
        in:
          b:
            const: Infra
            schema: string
          a:
            link:
              path: ls/result/name
              iterate: Iterate
      Delete File or Folder:
        parent: LuFunction
        in:
          functionName:
            const: deleteFile
          fileName:
            link: ${path}%2F${file}/string
            schema: string
            mandatory: false
    split: '--------------------'
  Remove Files Generate:
    else: true
    dependsOn: Get Files
    actors:
      Equals:
        parent: Equals
        condition: result
        in:
          b:
            const: Generate
            schema: string
          a:
            link:
              path: ls/result/name
              iterate: Iterate
      'Delete File or Folder   ':
        parent: LuFunction
        in:
          functionName:
            const: deleteFile
          fileName:
            link: ${path}%2F${file}/string
            schema: string
            mandatory: false
    split: '--------------------'
  Build Specific File Paths:
    else: true
    dependsOn: Get Files
    actors:
      Training File 1:
        parent: StringFormat
        in:
          format:
            const: ${projDir}/Implementation/SharedObjects/Broadway/TDM/AI/Training/CreateMDBExportSchemaForAI.flow
          projDir:
            link: PROJECT_DIR/value
            schema: string
            mandatory: false
      Training File 2:
        parent: StringFormat
        in:
          format:
            const: ${projDir}/Implementation/SharedObjects/Broadway/TDM/AI/Training/MDBExportSchemaAI.flow
          projDir:
            link: PROJECT_DIR/value
            schema: string
            mandatory: false
  Delete Specific Files:
    actors:
      Delete File or Folder11:
        parent: LuFunction
        in:
          functionName:
            const: deleteFile
          fileName:
            link: Training File 1/string
            schema: string
            mandatory: false
      Delete File or Folder12:
        parent: LuFunction
        in:
          functionName:
            const: deleteFile
          fileName:
            link: Training File 2/string
            schema: string
            mandatory: false
schemas:
  ls.out.result:
    type: array
    items:
      type: object
      properties:
        name:
          type: string
        size:
          type: integer
        createTime:
          type: integer
        lastModifiedTime:
          type: integer
        lastAccessTime:
          type: integer
        directory:
          type: boolean
        fullPath:
          type: string
