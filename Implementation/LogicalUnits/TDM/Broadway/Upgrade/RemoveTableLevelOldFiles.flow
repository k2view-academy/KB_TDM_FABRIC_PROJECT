tags: Upgrade
stages:
  Get Path:
    actors:
      PROJECT_DIR:
        parent: SysEnv
        in:
          name:
            const: PROJECT_DIR
        out:
          value:
            schema: string
      Get Project Folder:
        parent: InnerFlow
        in:
          flowName:
            const: GetProjectFolder
        out:
          PROJECT_FOLDER:
            schema: string
  Build Path:
    actors:
      File Location:
        parent: StringFormat
        in:
          format:
            const: ${projDir}/Implementation/LogicalUnits/TDM_TableLevel/Broadway
          projDir:
            link: PROJECT_DIR/value
            schema: string
            mandatory: false
            createdBy: format
      File Location1:
        parent: StringFormat
        in:
          format:
            const: ${projDir}/LogicalUnits/TDM_TableLevel/Broadway
          projDir:
            link: Get Project Folder/PROJECT_FOLDER
            schema: string
            mandatory: false
  Check If Studio:
    actors:
      Studio Present?:
        parent: NotNull
        condition: result
        in:
          value:
            link: PROJECT_DIR/value
      ls:
        parent: ls
        in:
          interface:
            const: null
            link: File Location1/string
          path:
            const: .
        out:
          result:
            schema: '#ref'
  Get Files:
    actors:
      ${path}/${file}:
        parent: StringFormat
        in:
          format:
            const: ${path}/${file}
          path:
            link: File Location/string
            schema: string
            mandatory: false
            createdBy: format
          file:
            link:
              path: ls/result/name
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: format
  Remove Files:
    actors:
      rm:
        parent: rm
        in:
          interface:
            const: file:///
          path:
            link: ${path}%2F${file}/string
schemas:
  ls.out.result:
    type: array
    items:
      type: object
      properties:
        name:
          type: string
        size:
          type: integer
        createTime:
          type: integer
        lastModifiedTime:
          type: integer
        lastAccessTime:
          type: integer
        directory:
          type: boolean
        fullPath:
          type: string
