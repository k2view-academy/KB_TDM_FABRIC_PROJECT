tags: Upgrade
stages:
  Stage 1:
    actors:
      PROJECT_DIR:
        parent: SysEnv
        in:
          name:
            const: PROJECT_DIR
        out:
          value:
            schema: string
  Stage 2:
    actors:
      Studio Present?:
        parent: NotNull
        condition: result
        in:
          value:
            link: PROJECT_DIR/value
      MTable Name and Location:
        parent: StringFormat
        in:
          format:
            const: ${0}/Implementation/LogicalUnits/k2_ref/Mtable/TableLevelDefinitions.csv
          params:
            link:
              path: PROJECT_DIR/value
              pos: 0
  Search entries:
    actors:
      Get entries with count_indicator false:
        parent: MTableLookup
        in:
          mtable:
            const: TableLevelInterfaces
          mtableKey:
            const:
              count_indicator: 'false'
        out:
          result:
            schema: '#ref'
  Add entries and update file:
    actors:
      LuFunction1:
        parent: LuFunction
        in:
          functionName:
            const: upgradeCountIndicator
          interfaceName:
            link:
              path: Get entries with count_indicator false/result/interface_name
              iterate: Iterate
            schema: any
            mandatory: false
          filePath:
            link: MTable Name and Location/string
            schema: any
            mandatory: false
schemas:
  Get entries with count_indicator false.out.result:
    type: array
    items:
      type: object
      properties:
        interface_name:
          type: string
        suppress_indicator:
          type: string
        truncate_indicator: {
          }
        count_indicator:
          type: string
        order_flow: {
          }
        no_schema: {
          }
