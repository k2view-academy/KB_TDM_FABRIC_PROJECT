          type: string
        CLEANUP_LOGIC:
          type: string
        SEQ:
          type: string
        OVERRIDE_CLEANUP_RETENTION_PERIOD:
          type: string
  ArrayBuilder2.out.array:
    type: array
    items:
      type: object
      properties:
        TABLE_NAME:
          type: string
        CLEANUP_ORDER:
          type: integer
        CLEANUP_IND:
          type: boolean
        CLEANUP_STATEMENT:
          type: string
        CLEANUP_LOGIC:
          type: string
        SEQ:
          type: integer
        OVERRIDE_CLEANUP_RETENTION_PERIOD: {
          }
  JavaScript .in.oldArr:
    type: array
    items:
      type: object
      properties:
        TABLE_NAME:
          type: string
        CLEANUP_ORDER:
          type: string
        CLEANUP_IND:
          type: string
        CLEANUP_STATEMENT:
          type: string
        CLEANUP_LOGIC:
          type: string
        SEQ:
          type: string
        OVERRIDE_CLEANUP_RETENTION_PERIOD:
          type: string
  JavaScript .in.newArr:
    type: array
    items:
      type: object
      properties:
        TABLE_NAME:
          type: string
        CLEANUP_ORDER:
          type: integer
        CLEANUP_IND:
          type: boolean
        CLEANUP_STATEMENT:
          type: string
        CLEANUP_LOGIC:
          type: string
        SEQ:
          type: integer
        OVERRIDE_CLEANUP_RETENTION_PERIOD: {
          }
  JavaScript .out.result:
    type: array
    items:
      type: object
      properties:
        TABLE_NAME:
          type: string
        CLEANUP_ORDER:
          type: string
        CLEANUP_IND:
          type: string
        CLEANUP_STATEMENT:
          type: string
        CLEANUP_LOGIC:
          type: string
        SEQ:
          type: string
        OVERRIDE_CLEANUP_RETENTION_PERIOD:
          type: string
  ArrayBuilder3.out.array:
