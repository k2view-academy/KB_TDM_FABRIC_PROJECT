tags: AIFlows
stages:
  Stage 1:
    actors:
      list bf:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: list bf name='RefreshTaskDescriptions' tag='TDM_AI';
        out:
          result:
            schema: '#ref'
  Stage 2:
    actors:
      Result Not Null:
        parent: NotNull
        condition: result
        in:
          value:
            link:
              path: list bf/result
              iterate: First
      RefreshTaskDescriptions:
        parent: BroadwayJob
        in:
          flowName:
            const: initRefreshTaskDesc
          uid:
            const: tdmAiGenerateTaskDescriptions
          schedule:
            const: 0.00:05:00
schemas:
  list bf.out.result:
    type: array
    items:
      type: object
      properties:
        param:
          type: string
        name:
          type: string
        type:
          type: string
        schema: {
          }
        mandatory:
          type: boolean
        default: {
          }
        remark:
          type: string
        editor: {
          }
        context: {
          }
        hidden:
          type: boolean
        object_name:
          type: string
