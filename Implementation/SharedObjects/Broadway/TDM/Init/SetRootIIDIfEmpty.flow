tags: TDM
stages:
  Stage 1:
    actors:
      Get root_iid:
        parent: FabricSetRead
        in:
          key:
            const: root_iid
            default: false
  Stage 6:
    actors:
      Root_iid is not Set?:
        parent: IsNull
        condition: result
        in:
          value:
            link: Get root_iid/result
      Get Selection Method:
        parent: FabricSetRead
        in:
          key:
            const: SELECTION_METHOD
            default: false
      'Get AI Environment ':
        parent: FabricSetRead
        in:
          key:
            const: AI_ENVIRONMENT
            default: false
  Stage 2:
    dependsOn: Stage 6
    actors:
      AI_GENERATED Task?:
        parent: EqualsIgnoreCase
        condition: result
        in:
          a:
            link: Get Selection Method/result
            schema: string
          b:
            const: AI_GENERATED
            schema: string
      'Source is AI ':
        parent: EqualsIgnoreCase
        in:
          a:
            external: source_environment_name
            schema: string
          b:
            link: Get AI Environment /result
            schema: string
      Sync is OFF:
        parent: EqualsIgnoreCase
        in:
          a:
            external: sync_mode
            schema: string
          b:
            const: 'off'
            schema: string
    split: '--------------------'
  Stage 8:
    else: true
    dependsOn: Stage 6
  Stage 3:
    dependsOn: Stage 2
    actors:
      And1:
        parent: And
        condition: result
        in:
          a:
            link: Source is AI /result
          b:
            link: Sync is OFF/result
      Get Root Lui and Name:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              select root_lu_name ,root_imported_lui from ${@TDMDB_SCHEMA}.tdm_ai_gen_iid_mapping
              where lu_name=${lu_name} and imported_lui=${iid} and task_execution_id=${task_execution_id}
          iid:
            external: iid
            schema: string
            mandatory: false
          task_execution_id:
            external: task_execution_id
            schema: string
            mandatory: false
          lu_name:
            external: lu_name
            schema: string
            mandatory: false
          TDMDB_SCHEMA:
            external: TDMDB_SCHEMA
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 9:
    dependsOn: Stage 8
    actors:
      Root LU?:
        parent: Elvis
        in:
          a:
            external: parent_lu_name
            schema: string
          b:
            const: ''
            schema: string
        out:
          result:
            schema: string
  Stage 4:
    dependsOn: Stage 3
    actors:
      Regex:
        parent: Regex
        in:
          pattern:
            const: (?<=_)(\d+)(?=_)
          input:
            link: Get Root Lui and Name/result/root_imported_lui
    split: '--------------------'
  Stage 10:
    dependsOn: Stage 9
    actors:
      Not A Root LU:
        parent: NotEquals
        condition: result
        in:
          a:
            link: Root LU?/result
            schema: string
          b:
            const: ''
            schema: string
      Get Root Entity Id:
        parent: LuFunction
        in:
          functionName:
            const: fnGetRootEntityId
          luName:
            external: lu_name
            schema: string
            mandatory: false
          iid:
            external: instance_id
            schema: string
            mandatory: false
          taskExecId:
            external: task_execution_id
            schema: string
            mandatory: false
          entityId:
            external: iid
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 13:
    else: true
    dependsOn: Stage 9
    actors:
      Set root_iid For Root LU:
        parent: FabricSet
        in:
          key:
            const: root_iid
            default: false
          value:
            const: null
            external: instance_id
            default: false
      Set root_lu_name For Root LU:
        parent: FabricSet
        in:
          key:
            const: root_lu_name
            default: false
          value:
            const: null
            external: lu_name
            default: false
  Stage 5:
    dependsOn: Stage 4
    actors:
      Set root_iid:
        parent: FabricSet
        in:
          key:
            const: root_iid
            default: false
          value:
            link:
              path: Regex/strings
              iterate: First
      Set root_lu_name:
        parent: FabricSet
        in:
          key:
            const: root_lu_name
            default: false
          value:
            link:
              path: Get Root Lui and Name/result/root_lu_name
              iterate: First
    split: '--------------------'
  Stage 11:
    dependsOn: Stage 10
    actors:
      Set root_iid For Child LU:
        parent: FabricSet
        in:
          key:
            const: root_iid
            default: false
          value:
            const: null
            link: Get Root Entity Id/result/rootEntityId
            default: false
      Set root_lu_name For Child LU:
        parent: FabricSet
        in:
          key:
            const: root_lu_name
            default: false
          value:
            const: null
            link: Get Root Entity Id/result/rootLuName
            default: false
    split: '--------------------'
  Stage 14:
    dependsOn: Stage 13
schemas:
  Get Root Lui and Name.out.result:
    type: array
    items:
      type: object
      properties:
        root_lu_name:
          type: string
        root_imported_lui:
          type: string
  Get Root Entity Id.out.result:
    type: object
    properties:
      rootLuName:
        type: string
      rootEntityId:
        type: string
