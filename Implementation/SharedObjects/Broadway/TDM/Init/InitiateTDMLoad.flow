tags: TDM
stages:
  Get Init Run Indicator:
    remark: |
      The initiation includes the following steps:
      1. Set Environment to source Environment, in case entity should be synced from source
      2. Set Sync Mode based on task's parameters
      3. Get Entity from Fabric
      4. Set Environment to Target Environment
      5. Set task parameters as session variables:
      5.1 Source Environment
      5.2 Target Environment
      5.3 Sync Mode
      5.4 Delete Before Load Indicator
      5.5 Insert To Target Indicator
      5.6 Replace Sequence Indicator
      5.7 Masking Indicator
      5.8 Data Flux Indicator
      5.9 Hierarchy Indicator
      5.10 Root Indicator
      5.11 Parent LU Type
      5.12 Clone Indicator
      6. Set the given Globals
      7. In case of Cloning handle the Clone Number
    actors:
      SCOPE_INITIATED:
        parent: FabricSetRead
        in:
          key:
            const: SCOPE_INITIATED
            default: false
  Check If Init Did Not Run:
    actors:
      Already Ran?:
        parent: JavaScript
        condition: result
        in:
          script:
            const: |-
              var result = false;
              if (scopeFlag == null || scopeFlag == ""){
                  result = true;
              }
              result;
          scopeFlag:
            link: SCOPE_INITIATED/result
            schema: string
            mandatory: false
        out:
          result:
            schema: boolean
  Print Inputs:
    actors:
      Set Initiation Flag to True:
        parent: FabricSet
        in:
          key:
            const: SCOPE_INITIATED
            default: false
          value:
            const: 'true'
            default: false
      Print Inputs to Log:
        parent: Logger
        in:
          message:
            const: 'TDMOrchestrator --> Handling task with following parameters: iid:
              ${iid}, luType: ${luName}, syncMode: ${syncMode}'
          level:
            const: info
          iid:
            external: iid
            schema: string
          luName:
            external: luName
            schema: string
          syncMode:
            external: syncMode
            schema: string
            mandatory: false
      Get Source Environment:
        parent: FabricSetRead
        in:
          key:
            const: TDM_SOURCE_ENVIRONMENT_NAME
            default: false
      Elvis:
        parent: Elvis
        in:
          b:
            const: ''
            schema: string
          a:
            external: parentLuName
        out:
          result:
            schema: string
      getTDMDBSchema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
      TDM_TASK_ID:
        parent: FabricSetRead
        in:
          key:
            const: TDM_TASK_ID
            default: false
  Set Environment To Source:
    actors:
      Set Source Environment:
        parent: FabricSet
        remark: The Source Entity ID should be initiated in case the flows fails during
          the next stage and before setting this ID as it is used in the Error handler
        in:
          key:
            const: environment
            default: false
          value:
            const: null
            link: Get Source Environment/result
            default: false
      Initiate Source Entity ID:
        parent: FabricSet
        remark: The Source Entity ID should be initiated in case the flows fails during
          the next stage and before setting this ID as it is used in the Error handler
        in:
          key:
            const: SOURCE_ENTITY_ID
            default: false
          value:
            const: null
            external: iid
            default: false
      Initiate IID:
        parent: FabricSet
        remark: The IID should be initiated in case the flows fails during the next
          stage and before setting this ID as it is used in the Error handler
        in:
          key:
            const: IID
            default: false
          value:
            const: null
            external: iid
            default: false
      Initiate Target Entity ID:
        parent: FabricSet
        remark: The Target Entity ID should be initiated in case the flows fails during
          the next stage and before setting this ID as it is used in the Error handler
        in:
          key:
            const: TARGET_ENTITY_ID
            default: false
          value:
            const: null
            external: iid
            default: false
      set Sync Mode:
        parent: FabricSet
        in:
          key:
            const: sync
            default: false
          value:
            const: null
            external: syncMode
            default: false
      Get Sync Mode:
        parent: Const
        in:
          value:
            const: null
            external: syncMode
        out:
          value:
            schema: string
      get TDM_TASK_EXE_ID:
        parent: FabricSetRead
        in:
          key:
            const: TDM_TASK_EXE_ID
            default: false
      Set Parent LU Name:
        parent: FabricSet
        in:
          key:
            const: PARENT_LU_NAME
            default: false
          value:
            const: null
            link: Elvis/result
            default: false
      Get Start Time:
        parent: Now
  Check AI Generation Conditions:
    actors:
      Sync is OFF:
        parent: EqualsIgnoreCase
        in:
          b:
            const: 'off'
            schema: string
          a:
            link: Get Sync Mode/value
      get LU_ID:
        parent: FabricSetRead
        in:
          key:
            const: LU_ID
            default: false
      Get TDM_DELETE_BEFORE_LOAD1:
        parent: FabricSetRead
        in:
          key:
            const: TDM_DELETE_BEFORE_LOAD
            default: false
  Check selection Method:
    actors:
      set LU_ID:
        parent: FabricSet
        in:
          key:
            const: LU_ID
            default: false
          value:
            const: '0'
            link: get LU_ID/result
      set TDM_TASK_EXE_ID:
        parent: FabricSet
        in:
          key:
            const: TDM_TASK_EXE_ID
            default: false
          value:
            const: null
            link: get TDM_TASK_EXE_ID/result
            default: false
      set TDM_DELETE_BEFORE_LOAD:
        parent: FabricSet
        in:
          key:
            const: TDM_DELETE_BEFORE_LOAD
            default: false
          value:
            const: null
            link: Get TDM_DELETE_BEFORE_LOAD1/result
            default: false
  Set TDM Parameters:
    transactional: false
    actors:
      Set Lu Name:
        parent: FabricSet
        in:
          key:
            const: LU_TYPE
            default: false
          value:
            const: null
            external: luName
            default: false
      Format Start Time:
        parent: DateFormat
        in:
          date:
            link: Get Start Time/date
      Set INPUT_IID:
        parent: FabricSet
        in:
          key:
            const: INPUT_IID
            default: false
          value:
            const: null
            external: iid
            default: false
  Set The given Globals:
    remark: The task receives a set of  Globals, these Globals will be set at this
      stage to impact the run of the Entity loading.
    transactional: false
    actors:
      Set Start Processing Time:
        parent: FabricSet
        height: 108
        in:
          key:
            const: IID_START_DATETIME
            default: false
          value:
            const: null
            link: Format Start Time/string
            default: false
      Split IID And Clone Number:
        parent: SplitIIDAndCloneNumber_Actor
        height: 347
        in:
          iid:
            external: iid
        out:
          cloneNo:
            schema: string
          UID:
            schema: string
          versionExeID:
            schema: string
  Get Values of Globals And Set Indicators And IDs:
    transactional: false
    actors:
      Get Target Environment:
        parent: FabricSetRead
        in:
          key:
            const: TDM_TAR_ENV_NAME
            default: false
      Set IID:
        parent: FabricSet
        in:
          key:
            const: IID
            default: false
          value:
            const: null
            link: Split IID And Clone Number/instanceID
            default: false
      Set Clone No:
        parent: FabricSet
        in:
          key:
            const: clone_id
            default: false
          value:
            const: null
            link: Split IID And Clone Number/cloneNo
            default: false
      Initiate Instance ID:
        parent: FabricSet
        in:
          key:
            const: SOURCE_INSTANCE_ID
            default: false
          value:
            const: null
            link: Split IID And Clone Number/instanceID
            default: false
      Set Source Entity ID:
        parent: FabricSet
        in:
          key:
            const: SOURCE_ENTITY_ID
            default: false
          value:
            const: null
            link: Split IID And Clone Number/UID
            default: false
      Initiate Target Entity ID after IID Split:
        parent: FabricSet
        in:
          key:
            const: TARGET_ENTITY_ID
            default: false
          value:
            const: null
            link: Split IID And Clone Number/instanceID
            default: false
      Get REPLACE_SEQ_BY_LUI_SYNC:
        parent: FabricSetRead
        in:
          key:
            const: REPLACE_SEQ_BY_LUI_SYNC
            default: false
      Get TDM_REPLACE_SEQUENCES:
        parent: FabricSetRead
        in:
          key:
            const: TDM_REPLACE_SEQUENCES
            default: false
      TDM_SYNC_SOURCE_DATA:
        parent: FabricSetRead
        in:
          key:
            const: TDM_SYNC_SOURCE_DATA
            default: false
      Set root_iid If it is Empty:
        parent: InnerFlow
        in:
          flowName:
            const: SetRootIIDIfEmpty
          source_environment_name:
            link: Get Source Environment/result
            schema: string
            mandatory: false
            createdBy: flowName
          sync_mode:
            external: syncMode
            schema: string
            mandatory: false
            createdBy: flowName
          iid:
            external: iid
            schema: string
            mandatory: false
            createdBy: flowName
          task_execution_id:
            link: get TDM_TASK_EXE_ID/result
            schema: string
            mandatory: false
            createdBy: flowName
          lu_name:
            external: luName
            schema: string
            mandatory: false
            createdBy: flowName
          TDMDB_SCHEMA:
            link: getTDMDBSchema/schema
            schema: string
            mandatory: false
            createdBy: flowName
          parent_lu_name:
            external: parentLuName
            schema: string
            mandatory: false
            createdBy: flowName
          instance_id:
            link: Split IID And Clone Number/instanceID
            schema: string
            mandatory: false
            createdBy: flowName
  Set iid based on clone_no:
    transactional: false
    actors:
      Get Source Environment DC:
        parent: DbFetchField
        in:
          interface:
            const: TDM
          sql:
            const: |-
              select case when l.source_affinity='' then null else l.source_affinity end as source_affinity
              from ${@schema}.task_execution_list l
              where l.task_execution_id=${taskExeID} and l.lu_id =${luID}
          taskExeID:
            link: get TDM_TASK_EXE_ID/result
            schema: string
          schema:
            link: getTDMDBSchema/schema
            schema: string
            mandatory: false
          luID:
            link: get LU_ID/result
            schema: any
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: string
      Set enable_sequences For Extract:
        parent: InnerFlow
        in:
          flowName:
            const: SetSeqFlagForExtract
          replaceSeqAtSync:
            link: Get REPLACE_SEQ_BY_LUI_SYNC/result
            schema: boolean
            mandatory: false
          replaceSeq:
            link: Get TDM_REPLACE_SEQUENCES/result
            schema: boolean
            mandatory: false
          TDM_TASK_EXE_ID:
            link: get TDM_TASK_EXE_ID/result
            schema: string
            mandatory: false
          TDM_SOURCE_ENVIRONMENT_NAME:
            link: Get Source Environment/result
            schema: string
            mandatory: false
          LU_TYPE:
            external: luName
            schema: string
            mandatory: false
      Cloning?:
        parent: IfElse
        height: 424
        in:
          a:
            link: Split IID And Clone Number/UID
            schema: string
          b:
            external: iid
            schema: string
          test:
            link: Split IID And Clone Number/cloneNo
        out:
          result:
            schema: string
  Condition for get instance:
    transactional: false
    actors:
      Check if Source Env has DC:
        parent: IsNull
        in:
          value:
            link: Get Source Environment DC/result
      Not TDM_SYNC_SOURCE_DATA:
        parent: Not
        in:
          value:
            link: TDM_SYNC_SOURCE_DATA/result
  Not TDM_SYNC_SOURCE_DATA or sync is OFF:
    transactional: false
    actors:
      Not TDM_SYNC_SOURCE_DATA OR sync is OFF:
        parent: Or
        in:
          b:
            link: Sync is OFF/result
          a:
            link: Not TDM_SYNC_SOURCE_DATA/result
  Get Instance From Fabric:
    transactional: false
    dependsOn: Not TDM_SYNC_SOURCE_DATA or sync is OFF
    actors:
      Source DC null or Sync off:
        parent: Or
        condition: result
        in:
          a:
            link: Check if Source Env has DC/result
          b:
            link: Not TDM_SYNC_SOURCE_DATA OR sync is OFF/result
      Sync Instance Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: PopulateTableErrorsWithFailed
      Get Instance:
        parent: FabricGet
        in:
          luType:
            const: null
            external: luName
          iid:
            const: null
            link: Cloning?/result
            default: false
          syncMode:
            const: null
            external: syncMode
    split: '--------------------'
  Source DC not Null:
    else: true
    transactional: false
    dependsOn: Not TDM_SYNC_SOURCE_DATA or sync is OFF
    actors:
      Sync With Source DC Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: PopulateTableErrorsWithFailed
      Get Entity with Source DC:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: get ${luName}.${iid} @ ${dcName} WITH PARALLEL=false STOP_ON_ERROR=true
          luName:
            external: luName
            schema: string
          iid:
            link: Cloning?/result
            schema: string
          dcName:
            link: Get Source Environment DC/result
            schema: string
        out:
          result:
            schema: '#ref'
  Get LOAD_MASKING_FLAG:
    transactional: false
    actors:
      Get Time After Get:
        parent: Now
      Get Load Masking Flag:
        parent: FabricSetRead
        in:
          key:
            const: LOAD_MASKING_FLAG
            default: false
      isParamCoupling:
        parent: Const
        in:
          value:
            const: null
            external: isParamCoupling
        out:
          value:
            schema: string
      'clone id = 1 or 0 ':
        parent: LessThan
        in:
          b:
            const: 2
          a:
            link: Split IID And Clone Number/cloneNo
  If not Delete and not Clone:
    transactional: false
    actors:
      Not Delete Nor Clone:
        parent: And
        in:
          a:
            link: TDM_SYNC_SOURCE_DATA/result
          b:
            link: clone id = 1 or 0 /result
  'Is Params Coupling ':
    transactional: false
    dependsOn: If not Delete and not Clone
    actors:
      And:
        parent: And
        condition: result
        in:
          b:
            link: isParamCoupling/value
          a:
            link: Not Delete Nor Clone/result
      ExportIidForParams:
        parent: InnerFlow
        in:
          flowName:
            const: ExportIidForParams
          luName:
            external: luName
            schema: string
            mandatory: false
          IID:
            link:
              path: Cloning?/result
              iterate: First
            schema: string
            mandatory: false
    split: '--------------------'
  'False':
    else: true
    transactional: false
    dependsOn: If not Delete and not Clone
  Set Environment To Target:
    transactional: false
    actors:
      Set Target Environment:
        parent: FabricSet
        in:
          key:
            const: environment
            default: false
          value:
            const: null
            link: Get Target Environment/result
            default: false
      Initiate Entity Status:
        parent: FabricSet
        in:
          key:
            const: ENTITY_STATUS
            default: false
          value:
            const: completed
            default: false
      Format Current Time:
        parent: DateFormat
        in:
          date:
            link: Get Time After Get/date
      Set enable_masking:
        parent: FabricSet
        in:
          key:
            const: enable_masking
            default: false
          value:
            const: null
            link: Get Load Masking Flag/result
            default: false
      Set enable_sequences For Load:
        parent: InnerFlow
        in:
          flowName:
            const: SetSeqFlagForLoad
          replaceSeq:
            link: Get TDM_REPLACE_SEQUENCES/result
            schema: string
            mandatory: false
          replaceSeqAtSync:
            link: Get REPLACE_SEQ_BY_LUI_SYNC/result
            schema: string
            mandatory: false
          cloneId:
            link: Split IID And Clone Number/cloneNo
            schema: integer
            mandatory: false
          TDM_SOURCE_ENVIRONMENT_NAME:
            link: Get Source Environment/result
            schema: string
            mandatory: false
          TDM_TASK_EXE_ID:
            link: get TDM_TASK_EXE_ID/result
            schema: string
            mandatory: false
          LU_TYPE:
            external: luName
            schema: string
            mandatory: false
        out:
          result:
            schema: boolean
  'set Enable_Masking_uniqueness ':
    transactional: false
    dependsOn: Set Environment To Target
    actors:
      Sequence or Load masking are enabled:
        parent: Or
        condition: result
        in:
          a:
            link: Get Load Masking Flag/result
          b:
            link: Set enable_sequences For Load/result
      Set Enable_Masking_uniqueness to true:
        parent: FabricSet
        in:
          key:
            const: enable_masking_uniqueness
            default: false
          value:
            const: 'true'
            default: false
    split: '--------------------'
  Set to false:
    else: true
    transactional: false
    dependsOn: Set Environment To Target
    actors:
      Set Enable_Masking_uniqueness to false:
        parent: FabricSet
        in:
          key:
            const: enable_masking_uniqueness
            default: false
          value:
            const: 'false'
            default: false
  Set End Time of Get:
    transactional: false
    actors:
      Set End Time of Get Command:
        parent: FabricSet
        in:
          key:
            const: IID_AFTER_GET_DATETIME
            default: false
          value:
            const: null
            link: Format Current Time/string
            default: false
schemas:
  Get Entity with Source DC.out.result:
    type: array
    items:
      type: object
      properties:
        luName:
          type: string
        iid:
          type: string
        version:
          type: integer
        action:
          type: string
        notes:
          type: string
