tags: TDM
stages:
  Get Query Inputs:
    actors:
      getTDMDBSchema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
      get TDM_TASK_EXE_ID:
        parent: FabricSetRead
        in:
          key:
            const: TDM_TASK_EXE_ID
            default: false
  Get override:
    actors:
      Get Params from task_execution_override_attrs:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              SELECT
                  t.override_parameters ->> 'GENERATE_DATA_PARAMS' AS generate_data_params
              FROM
                  (VALUES (CAST(${taskExeId} AS BIGINT))) AS v(task_execution_id)
              LEFT JOIN
                  ${@SCHEMA}.task_execution_override_attrs t ON t.task_execution_id = v.task_execution_id;
          SCHEMA:
            link: getTDMDBSchema/schema
            schema: string
            mandatory: false
          taskExeId:
            link: get TDM_TASK_EXE_ID/result
            schema: integer
            mandatory: false
        out:
          result:
            schema: '#ref'
  Get Task Params From TDMDB:
    dependsOn: Get override
    actors:
      IsNull:
        parent: IsNull
        condition: result
        in:
          value:
            link:
              path: Get Params from task_execution_override_attrs/result/generate_data_params
              iterate: First
      GetGDParamsFromTableIntoSession1:
        parent: InnerFlow
        in:
          flowName:
            const: GetGDParamsFromTableIntoSession
    split: '--------------------'
  Merge Override With Task Params:
    else: true
    dependsOn: Get override
    actors:
      GetGDParamsFromTableIntoSession1:
        parent: InnerFlow
        in:
          flowName:
            const: GetGDParamsFromTableIntoSession
      ReadBaseParams:
        parent: FabricSetRead
        in:
          key:
            const: GENERATE_DATA_PARAMS
            default: false
  Task Params Loaded Into Session:
    dependsOn: Get Task Params From TDMDB
    split: '--------------------'
  Build Merged Params:
    dependsOn: Merge Override With Task Params
    actors:
      MergeParams:
        parent: JavaScript
        in:
          script:
            const:
              userCode: |-
                var base = JSON.parse(baseParams || '{}');
                var overrides = JSON.parse(overrideParams || '{}');
                Object.keys(overrides).forEach(function(k) { base[k] = overrides[k]; });
                JSON.stringify(base);
              script: |-
                var base = JSON.parse(baseParams || '{}');
                var overrides = JSON.parse(overrideParams || '{}');
                Object.keys(overrides).forEach(function(k) { base[k] = overrides[k]; });
                JSON.stringify(base);
          baseParams:
            link: ReadBaseParams/result
            schema: string
            mandatory: false
          overrideParams:
            link:
              path: Get Params from task_execution_override_attrs/result/generate_data_params
              iterate: First
            schema: string
            mandatory: false
  Base Params Path Complete:
    dependsOn: Task Params Loaded Into Session
    split: '--------------------'
  Set Merged Params In Session:
    dependsOn: Build Merged Params
    actors:
      SetMergedParams:
        parent: FabricSet
        in:
          key:
            const: GENERATE_DATA_PARAMS
            default: false
          value:
            link: MergeParams/result
schemas:
  Get Params from task_execution_override_attrs.out.result:
    type: array
    items:
      type: object
      properties:
        generate_data_params:
          type: string
