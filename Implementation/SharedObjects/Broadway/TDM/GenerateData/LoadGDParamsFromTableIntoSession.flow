tags: TDM
stages:
  Get Query Inputs:
    actors:
      getTDMDBSchema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
      get TDM_TASK_EXE_ID:
        parent: FabricSetRead
        in:
          key:
            const: TDM_TASK_EXE_ID
            default: false
  Get override:
    actors:
      Get Params from task_execution_override_attrs:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              SELECT
                  t.override_parameters ->> 'GENERATE_DATA_PARAMS' AS generate_data_params
              FROM
                  (VALUES (CAST(${taskExeId} AS BIGINT))) AS v(task_execution_id)
              LEFT JOIN
                  ${@SCHEMA}.task_execution_override_attrs t ON t.task_execution_id = v.task_execution_id;
          SCHEMA:
            link: getTDMDBSchema/schema
            schema: string
            mandatory: false
          taskExeId:
            link: get TDM_TASK_EXE_ID/result
            schema: integer
            mandatory: false
        out:
          result:
            schema: '#ref'
  Get Task Params From TDMDB:
    dependsOn: Get override
    actors:
      IsNull:
        parent: IsNull
        condition: result
        in:
          value:
            link:
              path: Get Params from task_execution_override_attrs/result/generate_data_params
              iterate: First
      GetGDParamsFromTableIntoSession1:
        parent: InnerFlow
        in:
          flowName:
            const: GetGDParamsFromTableIntoSession
    split: '--------------------'
  Pass the value:
    else: true
    dependsOn: Get override
    actors:
      Set GENERATE_DATA_PARAMS1:
        parent: FabricSet
        in:
          key:
            const: GENERATE_DATA_PARAMS
            default: false
          value:
            link:
              path: Get Params from task_execution_override_attrs/result/generate_data_params
              iterate: First
 
schemas:
  Get Params from task_execution_override_attrs.out.result:
    type: array
    items:
      type: object
      properties:
        generate_data_params:
          type: string
