tags: TDM
stages:
  'Check For Replace Sequence ':
    actors:
      Get Replace Sequence Indicator:
        parent: FabricSetRead
        in:
          key:
            const: enable_sequences
            default: false
          interface:
            schema: any
  Not A Sequence Task:
    dependsOn: 'Check For Replace Sequence '
    actors:
      'false':
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: 'false'
            schema: string
          a:
            link: Get Replace Sequence Indicator/result
    split: '--------------------'
  Sequence Task:
    else: true
    transactional: false
    dependsOn: 'Check For Replace Sequence '
  Check If Reservation To Be Handled:
    transactional: false
    dependsOn: Not A Sequence Task
    actors:
      Check if Reservation is required:
        parent: Equals
        condition: result
        in:
          a:
            external: reserveInd
            schema: string
          b:
            const: 'true'
            schema: string
    split: '--------------------'
  'Do Nothing ':
    transactional: false
    dependsOn: Sequence Task
  'Check For Delete Only ':
    transactional: false
    dependsOn: Check If Reservation To Be Handled
    actors:
      Get Delete Only Task Indicator:
        parent: FabricSetRead
        in:
          key:
            const: TDM_DELETE_ONLY_TASK
            default: false
          interface:
            schema: any
      Get Task Reserve Indicator:
        parent: FabricSetRead
        in:
          key:
            const: TDM_RESERVE_IND
            default: false
          interface:
            schema: any
    split: '--------------------'
  'Do Nothing  ':
    transactional: false
    dependsOn: 'Do Nothing '
  If Not A Delete Only Task:
    transactional: false
    dependsOn: 'Check For Delete Only '
    actors:
      Equals1:
        parent: Equals
        condition: result
        in:
          a:
            link: Get Delete Only Task Indicator/result
            schema: string
          b:
            const: 'false'
            schema: string
    split: '--------------------'
  If A Delete Only Task:
    else: true
    transactional: false
    dependsOn: 'Check For Delete Only '
    actors:
      ReleaseReservedEntity1:
        parent: ReleaseReservedEntity
    split: '--------------------'
  'Do Nothing   ':
    transactional: false
    dependsOn: 'Do Nothing  '
  Check if Reserve Task:
    transactional: false
    dependsOn: If Not A Delete Only Task
    actors:
      Check if A Reservation Task:
        parent: Equals
        condition: result
        in:
          a:
            link: Get Task Reserve Indicator/result
            schema: string
          b:
            const: 'true'
            schema: string
    split: '--------------------'
  Not A Reserve Task:
    else: true
    transactional: false
    dependsOn: If Not A Delete Only Task
    actors:
      Get Target Entity ID:
        parent: FabricSetRead
        in:
          key:
            const: TARGET_ENTITY_ID
            default: false
          interface:
            schema: any
      Get Business Entity ID:
        parent: FabricSetRead
        in:
          key:
            const: BE_ID
            default: false
          interface:
            schema: any
        out:
          result:
            schema: integer
      Get Target Environment ID:
        parent: FabricSetRead
        in:
          key:
            const: TARGET_ENVIRONMENT_ID
            default: false
          interface:
            schema: any
        out:
          result:
            schema: integer
      Get Session User:
        parent: FabricSetRead
        in:
          key:
            const: USER_NAME
            default: false
          interface:
            schema: any
      Get User's Fabric Roles:
        parent: FabricSetRead
        in:
          key:
            const: USER_FABRIC_ROLES
            default: false
          interface:
            schema: any
      getTDMDBSchema:
        parent: InnerFlow
        in:
          flowName:
            const: getTDMDBSchema
        out:
          schema:
            schema: string
      'Get Filter out reserved ':
        parent: FabricSetRead
        in:
          key:
            const: FILTEROUT_RESERVED
            default: false
          interface:
            schema: any
    split: '--------------------'
  'Do Nothing             ':
    transactional: false
    dependsOn: If A Delete Only Task
    split: '--------------------'
  'Do Nothing    ':
    transactional: false
    dependsOn: 'Do Nothing   '
  'Reserve  ':
    transactional: false
    dependsOn: Check if Reserve Task
    actors:
      Equals2:
        parent: Equals
        condition: result
        in:
          a:
            link: Get Replace Sequence Indicator/result
            schema: string
          b:
            const: 'false'
            schema: string
      'Reserve Error Handler ':
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: false
                flowName: PopulateTableErrorsWithFailed
      Reserve Entity:
        parent: ReserveEntity
    split: '--------------------'
  'Filter out by ALL ':
    transactional: false
    dependsOn: Not A Reserve Task
    actors:
      EqualsIgnoreCase1:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: ALL
            schema: string
          a:
            link: Get Filter out reserved /result
      Get Owner Of Entity1:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: |-
              SELECT reserve_owner
              FROM ${@schema}.tdm_reserved_entities
              WHERE entity_id = ${entityId}
              AND be_id = ${beId}
              AND env_id = ${envId}
          entityId:
            link: Get Target Entity ID/result
            schema: string
            mandatory: false
          beId:
            link: Get Business Entity ID/result
            schema: integer
            mandatory: false
          envId:
            link: Get Target Environment ID/result
            schema: integer
            mandatory: false
          schema:
            link: getTDMDBSchema/schema
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  'Filter out by OTHERS ':
    else: true
    transactional: false
    dependsOn: Not A Reserve Task
    actors:
      Get Owner Of Entity:
        parent: DbCommand
        in:
          interface:
            const: TDM
          sql:
            const: "SELECT reserve_owner\r\nFROM ${@schema}.tdm_reserved_entities\r\
              \nWHERE entity_id = ${entityId}\r\nAND be_id = ${beId}\r\nAND env_id\
              \ = ${envId}\r\nAND (reserve_owner != ${userName} \r\n  AND reserve_owner\
              \ NOT IN (${userFabricRoles}))\r\n\r\n"
          entityId:
            link: Get Target Entity ID/result
            schema: string
            mandatory: false
          beId:
            link: Get Business Entity ID/result
            schema: integer
            mandatory: false
          envId:
            link: Get Target Environment ID/result
            schema: integer
            mandatory: false
          userName:
            link: Get Session User/result
            schema: string
            mandatory: false
          userFabricRoles:
            link: Get User's Fabric Roles/result
            schema: string
            mandatory: false
          schema:
            link: getTDMDBSchema/schema
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  'Do Nothing            ':
    transactional: false
    dependsOn: 'Do Nothing             '
    split: '--------------------'
  'Do Nothing     ':
    transactional: false
    dependsOn: 'Do Nothing    '
  'End  ':
    transactional: false
    dependsOn: 'Reserve  '
    split: '--------------------'
  End:
    dependsOn:
    - 'Filter out by OTHERS '
    - 'Filter out by ALL '
    actors:
      If Record Exists:
        parent: NotNull
        condition: result
        in:
          value:
            link:
            - path: Get Owner Of Entity1/result/reserve_owner
              iterate: First
            - path: Get Owner Of Entity/result/reserve_owner
              iterate: First
      ErrorHandler3:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: PopulateTableErrorsWithFailed
      Throw Exception:
        parent: JavaScript
        in:
          script:
            const: |-
              if (userName != null && userName !== "") {
                  throw "Entity cannot be reserved because it is already reserved by user '" +
                        userName +
                        "'.";
              } else {
                  throw "Entity cannot be reserved because it is already reserved by you, and the 'Filter Out Reserved By ALL' option excludes all reserved entities, including your own.";
              }
          userName:
            link:
              path: Get Owner Of Entity/result/reserve_owner
              iterate: First
            schema: string
            mandatory: false
    split: '--------------------'
  'Do Nothing                ':
    transactional: false
    dependsOn: 'Do Nothing            '
    split: '--------------------'
  Stage 20:
    transactional: false
    dependsOn: 'Do Nothing     '
schemas:
  Get Owner Of Entity1.out.result:
    type: array
    items:
      type: object
      properties:
        reserve_owner:
          type: string
  Get Owner Of Entity.out.result:
    type: array
    items:
      type: object
      properties:
        reserve_owner:
          type: string
