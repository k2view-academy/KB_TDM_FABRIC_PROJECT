tags: TDM
stages:
  'Get User ':
    actors:
      Get Session User:
        parent: FabricSetRead
        in:
          key:
            const: USER_NAME
            default: false
          interface:
            schema: any
  If No User Provided:
    dependsOn: 'Get User '
    actors:
      'Token ? ':
        parent: Equals
        condition: result
        in:
          b:
            const: Unassigned
            schema: string
          a:
            link: Get Session User/result
      ErrorHandler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: PopulateTableErrorsWithFailed
                number_of_retries: ''
                retry_interval: ''
      Fail:
        parent: Fail
        in:
          message:
            const: Reserve task cannot be executed because the user name is missing.
    split: '--------------------'
  Continue to Reserve:
    else: true
    dependsOn: 'Get User '
  'Get Field''s Values   ':
    actors:
      Get Reserve Max Days For Tester:
        parent: FabricSetRead
        in:
          key:
            const: MAX_RESERVATION_DAYS_FOR_TESTER
            default: false
          interface:
            schema: any
        out:
          result:
            schema: integer
  Calculate Retention:
    dependsOn: 'Get Field''s Values   '
    actors:
      Admin Or Owner?:
        parent: NotEquals
        condition: result
        in:
          a:
            link: Get Reserve Max Days For Tester/result
            schema: integer
          b:
            const: 0
            schema: integer
      Update Reserve Table For Admin/Onwer:
        parent: InnerFlow
        in:
          flowName:
            const: UpdateReserveEntitiesTableForAdminOnwer
    split: '--------------------'
  Tester:
    else: true
    transactional: false
    dependsOn: 'Get Field''s Values   '
    actors:
      Update Reserve Table For Tester:
        parent: InnerFlow
        in:
          flowName:
            const: UpdateReserveEntitiesTableForTester
