{
    "tags": [
        "TDM"
    ],
    "levels": [
        {
            "stages": [
                {
                    "name": "Get Task Settings",
                    "dependsOnList": [],
                    "actors": [
                        {
                            "name": "Get Task Exe ID",
                            "actorType": {
                                "parentType": "FabricSetRead",
                                "inputs": [
                                    {
                                        "name": "key",
                                        "const": "TDM_TASK_EXE_ID"
                                    }
                                ],
                                "outputs": []
                            }
                        },
                        {
                            "name": "Get Source Env",
                            "actorType": {
                                "parentType": "FabricSetRead",
                                "inputs": [
                                    {
                                        "name": "key",
                                        "const": "TDM_SOURCE_ENVIRONMENT_NAME"
                                    }
                                ],
                                "outputs": []
                            }
                        },
                        {
                            "name": "Get Target Env",
                            "actorType": {
                                "parentType": "FabricSetRead",
                                "inputs": [
                                    {
                                        "name": "key",
                                        "const": "TDM_TAR_ENV_NAME"
                                    }
                                ],
                                "outputs": []
                            }
                        },
                        {
                            "name": "getTDMDBSchema1",
                            "actorType": {
                                "parentType": "InnerFlow",
                                "inputs": [
                                    {
                                        "name": "flowName",
                                        "const": "getTDMDBSchema"
                                    }
                                ],
                                "outputs": [
                                    {
                                        "name": "schema",
                                        "schema": {
                                            "type": "string"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "stages": [
                {
                    "name": "Get Root LU Record from the TDM DB",
                    "dependsOnList": [],
                    "actors": [
                        {
                            "name": "DbFetchFirstRow1",
                            "actorType": {
                                "parentType": "DbFetchFirstRow",
                                "inputs": [
                                    {
                                        "name": "interface",
                                        "const": "TDM"
                                    },
                                    {
                                        "name": "sql",
                                        "const": "Select ${@TDMDB_SCHEMA}.task_execution_list.task_id,\n  ${@TDMDB_SCHEMA}.task_execution_list.execution_status,\n  ${@TDMDB_SCHEMA}.task_execution_list.num_of_processed_entities,\n  ${@TDMDB_SCHEMA}.task_execution_list.num_of_copied_entities,\n  ${@TDMDB_SCHEMA}.task_execution_list.num_of_failed_entities\nFrom ${@TDMDB_SCHEMA}.task_execution_list\nWhere ${@TDMDB_SCHEMA}.task_execution_list.task_execution_id = ? and parent_lu_id is null"
                                    },
                                    {
                                        "name": "TDMDB_SCHEMA",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "mandatory": false
                                    }
                                ],
                                "outputs": [
                                    {
                                        "name": "result",
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "task_id": {
                                                    "type": "integer"
                                                },
                                                "execution_status": {
                                                    "type": "string"
                                                },
                                                "num_of_processed_entities": {
                                                    "type": "integer"
                                                },
                                                "num_of_copied_entities": {
                                                    "type": "integer"
                                                },
                                                "num_of_failed_entities": {
                                                    "type": "integer"
                                                }
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "stages": [
                {
                    "name": "Print to Log",
                    "dependsOnList": [],
                    "actors": [
                        {
                            "name": "Logger1",
                            "actorType": {
                                "parentType": "Logger",
                                "inputs": [
                                    {
                                        "name": "message",
                                        "const": "The task execution ended. Task ID: ${1}, task execution id: ${0}, task execution status: ${2}, \r\nnumber of processed entities: ${3}, \r\nnumber of successful entities: ${4},\r\nnumber of failed entities: ${5}"
                                    },
                                    {
                                        "name": "level",
                                        "const": "info"
                                    }
                                ],
                                "outputs": []
                            }
                        },
                        {
                            "name": "DbCommand1",
                            "actorType": {
                                "parentType": "DbCommand",
                                "inputs": [
                                    {
                                        "name": "interface",
                                        "const": "TDM"
                                    },
                                    {
                                        "name": "sql",
                                        "const": "SELECT ${@TDMDB_SCHEMA}.task_execution_entities.task_execution_id,\n       ${@TDMDB_SCHEMA}.task_execution_entities.lu_name,\n       ${@TDMDB_SCHEMA}.task_execution_entities.entity_id,\n       ${@TDMDB_SCHEMA}.task_execution_entities.target_entity_id,\n       ${@TDMDB_SCHEMA}.task_execution_entities.clone_no,\n       ${@TDMDB_SCHEMA}.task_execution_entities.root_entity_id,\n       ${@TDMDB_SCHEMA}.task_execution_entities.root_target_entity_id\nFROM ${@TDMDB_SCHEMA}.task_execution_entities\nWHERE task_execution_id = ${task_execution_id}"
                                    },
                                    {
                                        "name": "TDMDB_SCHEMA",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "task_execution_id",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    }
                                ],
                                "outputs": [
                                    {
                                        "name": "result",
                                        "schema": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "task_execution_id": {
                                                        "type": "integer"
                                                    },
                                                    "lu_name": {
                                                        "type": "string"
                                                    },
                                                    "entity_id": {
                                                        "type": "string"
                                                    },
                                                    "target_entity_id": {
                                                        "type": "string"
                                                    },
                                                    "clone_no": {
                                                        "type": "string"
                                                    },
                                                    "root_entity_id": {
                                                        "type": "string"
                                                    },
                                                    "root_target_entity_id": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "stages": [
                {
                    "name": "Stage 1",
                    "dependsOnList": [],
                    "actors": [
                        {
                            "name": "StringFormat1",
                            "minHeight": 353,
                            "actorType": {
                                "parentType": "StringFormat",
                                "inputs": [
                                    {
                                        "name": "format",
                                        "const": "The entity identified in Fabric as ${entity_id} was loaded into the ${lu_name} Logical Unit (LU) in the target environment, where it is stored with Target Entity ID ${target_entity_id}, as part of ${task_execution_id} Task Execution."
                                    },
                                    {
                                        "name": "entity_id",
                                        "schema": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "createdBy": "format",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "target_entity_id",
                                        "schema": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "createdBy": "format",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "lu_name",
                                        "schema": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "createdBy": "format",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "task_execution_id",
                                        "schema": {
                                            "type": "array",
                                            "items": {
                                                "type": "integer"
                                            }
                                        },
                                        "createdBy": "format",
                                        "mandatory": false
                                    }
                                ],
                                "outputs": []
                            }
                        }
                    ]
                }
            ]
        },
        {
            "stages": [
                {
                    "name": "Stage 2",
                    "dependsOnList": [],
                    "isLast": 1,
                    "actors": [
                        {
                            "name": "EntityExecutionNote1",
                            "minHeight": 397,
                            "actorType": {
                                "parentType": "EntityExecutionNote",
                                "inputs": [],
                                "outputs": []
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "connections": [
        {
            "leftPort": {
                "actor": "Get Task Exe ID",
                "name": "result"
            },
            "rightPort": {
                "actor": "DbFetchFirstRow1",
                "name": "params"
            }
        },
        {
            "leftPort": {
                "actor": "Get Task Exe ID",
                "name": "result"
            },
            "rightPort": {
