tags: TDM
stages:
  Get Postgres Details:
    actors:
      pg-pass:
        parent: Const
        in:
          value:
            const: null
            external: pg-pass
            schema: string
        out:
          value:
            schema: string
      pg-user:
        parent: Const
        in:
          value:
            const: null
            external: pg-user
            schema: string
        out:
          value:
            schema: string
      pg-db:
        parent: Const
        in:
          value:
            const: null
            external: pg-db
            schema: string
        out:
          value:
            schema: string
      pg-host:
        parent: Const
        in:
          value:
            external: pg-host
            schema: string
            default: true
        out:
          value:
            schema: string
      pg-port:
        parent: Const
        in:
          value:
            const: null
            external: pg-port
            schema: string
        out:
          value:
            schema: string
  Encode:
    actors:
      Base64Encode1:
        parent: Base64Encode
        in:
          buffer:
            link: pg-pass/value
      Base64Encode2:
        parent: Base64Encode
        in:
          buffer:
            link: pg-user/value
      Base64Encode3:
        parent: Base64Encode
        in:
          buffer:
            link: pg-db/value
      Base64Encode4:
        parent: Base64Encode
        in:
          buffer:
            link: pg-host/value
      Base64Encode5:
        parent: Base64Encode
        in:
          buffer:
            link: pg-port/value
  Fomat Payload:
    actors:
      'StringFormat ':
        parent: StringFormat
        height: 245
        in:
          format:
            const: "apiVersion: v1\r\nkind: Secret\r\nmetadata:\r\n  name: medoid-secrets\r\
              \ntype: Opaque\r\ndata:\r\n  pg-password: ${pg_pass}\r\n  pg-user: ${pg_user}\r\
              \n  pg-db: ${pg_db}\r\n  pg-host: ${pg_host}\r\n  pg-port: ${pg_port}"
          pg_pass:
            link: Base64Encode1/string
            schema: string
            mandatory: false
          pg_user:
            link: Base64Encode2/string
            schema: string
            mandatory: false
          pg_db:
            link: Base64Encode3/string
            schema: string
            mandatory: false
          pg_host:
            link: Base64Encode4/string
            schema: string
            mandatory: false
          pg_port:
            link: Base64Encode5/string
            schema: string
            mandatory: false
  Apply:
    actors:
      applyRequest:
        parent: InnerFlow
        in:
          flowName:
            const: applyRequest
          method:
            const: POST
            schema: string
            editor:
              options:
              - ''
              - GET
              - POST
              - PUT
              - DELETE
              - PATCH
              id: com.k2view.dropdown
            mandatory: false
          namespace:
            external: namespace
            schema: string
            mandatory: false
          kind:
            const: secrets
            schema: string
            mandatory: false
          api:
            const: api/v1
            schema: string
            mandatory: false
          payload:
            link: StringFormat /string
            schema: string
            mandatory: false
  Stage 5: {
    }
