tags: TDM
stages:
  Get Main Folder:
    actors:
      Get Project's Folder:
        parent: InnerFlow
        in:
          flowName:
            const: GetProjectFolder
        out:
          PROJECT_FOLDER:
            schema: string
  Format Folder Full Path:
    actors:
      Object folder:
        parent: StringFormat
        in:
          format:
            const: ${PROJECT_DIRCTORY}/LogicalUnits/${LU_NAME}/Tables
          PROJECT_DIRCTORY:
            link: Get Project's Folder/PROJECT_FOLDER
            schema: string
            mandatory: false
          LU_NAME:
            external: LU_NAME
            schema: string
            mandatory: false
      Format Search For File Name:
        parent: StringFormat
        in:
          format:
            const: '${TABLE_NAME}'
          TABLE_NAME:
            external: TABLE_NAME
            schema: string
            mandatory: false
            createdBy: format
  Search For File:
    actors:
      List Files:
        parent: ls
        in:
          interface:
            const: null
            link: Object folder/string
          path:
            const: .
          pattern:
            const: null
            link: Format Search For File Name/string
        out:
          result:
            schema: '#ref'
  If File Exists?:
    dependsOn: Search For File
    actors:
      File Not Found:
        parent: IsNull
        condition: result
        in:
          value:
            link: List Files/result/name
      'False':
        parent: Const
        in:
          value:
            const: false
            schema: boolean
        out:
          value:
            external: SKIP_TABLE
            schema: boolean
    split: '--------------------'
  File Exists:
    else: true
    transactional: false
    dependsOn: Search For File
    actors:
      'True':
        parent: Const
        in:
          value:
            const: true
            schema: boolean
        out:
          value:
            external: SKIP_TABLE
            schema: boolean
schemas:
  List Files.out.result:
    type: array
    items:
      type: object
      properties:
        name:
          type: string
        size:
          type: integer
        createTime:
          type: integer
        lastModifiedTime:
          type: integer
        lastAccessTime:
          type: integer
        directory:
          type: boolean
