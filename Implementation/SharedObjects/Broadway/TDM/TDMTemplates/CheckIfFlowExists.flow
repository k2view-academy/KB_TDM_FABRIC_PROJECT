tags: TDM
stages:
  Stage 1:
    actors:
      Get Project Location:
        parent: InnerFlow
        in:
          flowName:
            const: GetProjectFolder
        out:
          PROJECT_FOLDER:
            schema: string
  Stage 2:
    actors:
      flow folder:
        parent: StringFormat
        in:
          format:
            const: ${PROJECT_DIRCTORY}/LogicalUnits/${LU_NAME}/Broadway/${FOLDER_NAME}
          PROJECT_DIRCTORY:
            link: Get Project Location/PROJECT_FOLDER
            schema: string
            mandatory: false
          LU_NAME:
            external: LU_NAME
            schema: string
            mandatory: false
          FOLDER_NAME:
            external: FOLDER_NAME
            schema: string
            mandatory: false
  Stage 3:
    actors:
      list file:
        parent: ls
        in:
          interface:
            const: null
            link: flow folder/string
          path:
            const: .
          pattern:
            const: null
            external: FLOW_FILE_NAME
        out:
          result:
            schema: '#ref'
  Stage 4:
    dependsOn: Stage 3
    actors:
      File Not Found?:
        parent: IsNull
        condition: result
        in:
          value:
            link: list file/result/name
      File Does Not Exist:
        parent: Const
        in:
          value:
            const: false
            schema: boolean
        out:
          value:
            external: SKIP_TABLE
            schema: boolean
    split: '--------------------'
  Stage 5:
    else: true
    transactional: false
    dependsOn: Stage 3
    actors:
      File Exist:
        parent: Const
        in:
          value:
            const: true
            schema: boolean
        out:
          value:
            external: SKIP_TABLE
            schema: boolean
schemas:
  list file.out.result:
    type: array
    items:
      type: object
      properties:
        name:
          type: string
        size:
          type: integer
        createTime:
          type: integer
        lastModifiedTime:
          type: integer
        lastAccessTime:
          type: integer
        directory:
          type: boolean
