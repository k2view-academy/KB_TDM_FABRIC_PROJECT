tags: TDM
stages:
  Stage 1:
    actors:
      PK Field Upper Case:
        parent: Uppercase
        in:
          string:
            external: fieldName
  Stage 2:
    actors:
      JavaScript1:
        parent: JavaScript
        in:
          script:
            const:
              userCode: |
                const first = value[0];
                const last = value[value.length - 1];
                var result = value;
                const isQuote = c => c === "'" || c === '"';

                if (isQuote(first) && isQuote(last)) {
                    result =  value.substring(2, value.length - 2);
                }
                result;
              script: |-
                var first = value[0];
                var last = value[value.length - 1];
                var result = value;

                var isQuote = function isQuote(c) {
                  return c === "'" || c === '"';
                };

                if (isQuote(first) && isQuote(last)) {
                  result = value.substring(2, value.length - 2);
                }

                result;
          value:
            link: PK Field Upper Case/string
            schema: string
            mandatory: false
        out:
          result:
            schema: string
      JavaScript2:
        parent: JavaScript
        in:
          script:
            const:
              userCode: |
                const first = value[0];
                const last = value[value.length - 1];
                var result = value;
                const isQuote = c => c === "'" || c === '"';

                if (isQuote(first) && isQuote(last)) {
                    result =  value.substring(1, value.length - 1);
                }
                result;
              script: |-
                var first = value[0];
                var last = value[value.length - 1];
                var result = value;

                var isQuote = function isQuote(c) {
                  return c === "'" || c === '"';
                };

                if (isQuote(first) && isQuote(last)) {
                  result = value.substring(1, value.length - 1);
                }

                result;
          value:
            link: PK Field Upper Case/string
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Stage 4:
    actors:
      Lookup2:
        parent: Lookup
        in:
          lookupKeys:
            const:
            - upperColumnName
          lookupData:
            const: null
            external: luTableData
            schema: '#ref'
          upperColumnName:
            link: JavaScript1/result
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  Stage 5:
    actors:
      InnerFlow2:
        parent: InnerFlow
        in:
          flowName:
            const: BuildDeleteTableFieldData
          value:
            external: fieldName
            schema: string
            mandatory: false
          datatype:
            link: Lookup2/result/columnType
            schema: string
            mandatory: false
        out:
          deleteFieldData:
            external: result
            schema: '#ref'
schemas:
  Lookup2.in.lookupData:
    type: array
    items:
      type: object
      properties: {
        }
  Lookup2.out.result:
    type: object
    properties:
      columnType:
        type: string
      upperColumnName:
        type: string
      columnName:
        type: string
  InnerFlow2.out.deleteFieldData:
    type: object
    properties:
      datatype:
        type: string
      name:
        type: string
      upperName:
        type: string
