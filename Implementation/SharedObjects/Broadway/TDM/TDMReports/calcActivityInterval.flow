tags: TDM
stages:
  Stage 1:
    actors:
      StartDate:
        parent: Const
        in:
          value:
            const: null
            external: startDate
        out:
          value:
            schema: string
      EndDate:
        parent: Const
        in:
          value:
            const: null
            external: endDate
        out:
          value:
            schema: string
  Stage 14:
    actors:
      DateParse1:
        parent: DateParse
        in:
          format:
            const: yyyy-MM-dd
          string:
            link: StartDate/value
      DateParse2:
        parent: DateParse
        in:
          format:
            const: yyyy-MM-dd
          string:
            link: EndDate/value
  Stage 2:
    actors:
      DateDuration1:
        parent: DateDuration
        in:
          from:
            link: DateParse1/date
          to:
            link: DateParse2/date
  Stage 3:
    actors:
      MathRound1:
        parent: MathRound
        in:
          value:
            link: DateDuration1/days
  Stage 4:
    dependsOn: Stage 3
    actors:
      <= 7 days:
        parent: LessThanEquals
        condition: result
        in:
          b:
            const: 7
          a:
            link: MathRound1/result
    split: '--------------------'
  Stage 5:
    else: true
    dependsOn: Stage 3
    actors:
      <=14 days:
        parent: LessThanEquals
        condition: result
        in:
          b:
            const: 14
          a:
            link: MathRound1/result
    split: '--------------------'
  Stage 8:
    else: true
    dependsOn: Stage 3
    actors:
      <= 30 days:
        parent: LessThanEquals
        condition: result
        in:
          b:
            const: 30
          a:
            link: MathRound1/result
    split: '--------------------'
  Stage 10:
    else: true
    dependsOn: Stage 3
    actors:
      <= 60 days1:
        parent: LessThanEquals
        condition: result
        in:
          b:
            const: 60
          a:
            link: MathRound1/result
    split: '--------------------'
  Stage 12:
    else: true
    dependsOn: Stage 3
  Stage 6:
    dependsOn: Stage 4
    actors:
      1 day:
        parent: Const
        in:
          value:
            const: 1 day
            schema: string
        out:
          value:
            external: daysInterval
            schema: string
    split: '--------------------'
  Stage 7:
    dependsOn: Stage 5
    actors:
      3 days:
        parent: Const
        in:
          value:
            const: 3 days
            schema: string
        out:
          value:
            external: daysInterval
            schema: string
    split: '--------------------'
  Stage 9:
    dependsOn: Stage 8
    actors:
      5 days:
        parent: Const
        in:
          value:
            const: 5 days
            schema: string
        out:
          value:
            external: daysInterval
            schema: string
    split: '--------------------'
  Stage 11:
    dependsOn: Stage 10
    actors:
      7 days:
        parent: Const
        in:
          value:
            const: 7 days
            schema: string
        out:
          value:
            external: daysInterval
            schema: string
    split: '--------------------'
  Stage 13:
    dependsOn: Stage 12
    actors:
      14 days:
        parent: Const
        in:
          value:
            const: 14 days
            schema: string
        out:
          value:
            external: daysInterval
            schema: string
