            "stages": [
                {
                    "name": "PIIClassificationList",
                    "dependsOnList": [],
                    "actors": [
                        {
                            "name": "buildPIIClassificationList",
                            "actorType": {
                                "parentType": "InnerFlow",
                                "inputs": [
                                    {
                                        "name": "flowName",
                                        "const": "buildPIIClassificationList"
