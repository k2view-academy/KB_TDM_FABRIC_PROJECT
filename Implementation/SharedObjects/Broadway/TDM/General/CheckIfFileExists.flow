tags: TDM
stages:
  Check If File At Location:
    actors:
      List File:
        parent: ls
        in:
          interface:
            const: null
            external: interface
          path:
            const: .
          pattern:
            const: null
            external: pattern
        out:
          result:
            schema: '#ref'
  File Not Found:
    dependsOn: Check If File At Location
    actors:
      File is Found?:
        parent: IsNull
        condition: result
        in:
          value:
            link: List File/result/name
      File Not At Lccation:
        parent: Const
        in:
          value:
            const: false
            schema: boolean
        out:
          value:
            external: FILE_FOUND
            schema: boolean
    split: '--------------------'
  File Found:
    else: true
    transactional: false
    dependsOn: Check If File At Location
    actors:
      File At Location:
        parent: Const
        in:
          value:
            const: true
            schema: boolean
        out:
          value:
            external: FILE_FOUND
            schema: boolean
schemas:
  List File.out.result:
    type: array
    items:
      type: object
      properties:
        name:
          type: string
        size:
          type: integer
        createTime:
          type: integer
        lastModifiedTime:
          type: integer
        lastAccessTime:
          type: integer
        directory:
          type: boolean
