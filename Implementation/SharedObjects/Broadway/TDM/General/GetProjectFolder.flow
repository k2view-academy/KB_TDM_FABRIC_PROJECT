tags: TDM
stages:
  Stage 1:
    actors:
      PROJECT_DIR:
        parent: SysEnv
        in:
          name:
            const: PROJECT_DIR
        out:
          value:
            schema: string
  Stage 2:
    dependsOn: Stage 1
    actors:
      Studio Present?:
        parent: NotNull
        condition: result
        in:
          value:
            link: PROJECT_DIR/value
      Implementation Folder:
        parent: StringFormat
        in:
          format:
            const: file://${ProjDir}/Implementation
          ProjDir:
            link: PROJECT_DIR/value
            schema: string
            mandatory: false
        out:
          string:
            external: PROJECT_FOLDER
    split: '--------------------'
  Stage 3:
    else: true
    dependsOn: Stage 1
    actors:
      Return Null:
        parent: NullValue
        out:
          value:
            external: PROJECT_FOLDER
