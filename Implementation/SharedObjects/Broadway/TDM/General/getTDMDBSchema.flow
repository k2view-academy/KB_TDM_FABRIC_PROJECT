tags: TDM
stages:
  Get TDMDB_SCHEMA:
    actors:
      TDMDB_SCHEMA:
        parent: FabricSetRead
        in:
          key:
            const: TDM.TDMDB_SCHEMA
  'Check value ':
    actors:
      Get Cluster ID:
        parent: DbFetchField
        in:
          interface:
            const: fabric
          sql:
            const: clusterid
        out:
          result:
            schema: string
  Result:
    actors:
      Replace:
        parent: Replace
        in:
          search:
            const: ${ClusterID}
          replace:
            const: null
            link: Get Cluster ID/result
          string:
            link: TDMDB_SCHEMA/result
        out:
          string:
            external: schema
